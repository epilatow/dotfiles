MUSE_SESSION_NAME_DB_ENV = "MUSE_SESSION_NAME_DB"
MUSE_SESSIONS_DIR_ENV = "MUSE_SESSIONS_DIR"
MUSE_WATCH_INTERVAL_SECONDS = 2
MUSE_WATCH_LOG_SCAN_BYTES = 65536
MUSE_WATCH_SESSION_SCAN_LIMIT = 40
TMUX_SLOT_LOCK = "tmux-agent-session-namer-slots"
SESSION_AGENT_OPTION = "@agent_namer"
# What tmux must have started a pane with for the session to be named:
