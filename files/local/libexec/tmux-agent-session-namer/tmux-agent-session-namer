#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.14"
# dependencies = []
# ///
"""Name a tmux session after an agent session.

Only an agent tmux itself was told to run names anything: the pane must
have been started with an agent launcher, so an agent typed at a shell
prompt leaves that session's name alone. The name describes what tmux
was opened to do, not whatever is running in it at the moment.

Among the agents that qualify, the first to name a session owns it
until the session ends, and one started inside another's pane leaves
the name alone. A session carries one name, so an agent launched as the
command of a second pane still moves that name, now through the owner's
slot and format. To hand a session to a different agent, unset its
owner with `tmux set-option -u @agent_namer` and start that agent as a
pane's own command, since the prompt route is refused either way.
"""

from __future__ import annotations

import functools
import json
import os
import re
import select
import shlex
import subprocess
import sys
import time
from enum import StrEnum
from typing import IO, cast

type JsonObject = dict[str, object]

CODEX_GLOBAL_TITLE_WARNING = (
    "tmux naming disabled: run /title and select only Thread, then start a "
    "new Codex session."
)
CODEX_PROJECT_TITLE_WARNING = (
    'tmux naming disabled: set [tui] terminal_title = ["thread"] in the '
    "applicable .codex/config.toml, then start a new Codex session."
)
CODEX_SESSION_OWNER_WARNING = (
    "tmux naming disabled: {owner} already names this tmux session."
)
CODEX_THREAD_TITLE_IDS = frozenset(("thread", "thread-title"))
TMUX_SLOT_LOCK = "tmux-agent-session-namer-slots"
SESSION_AGENT_OPTION = "@agent_namer"
# What tmux must have started a pane with for the session to be named:
# the claude CLI, or this helper, which is how tcodex launches codex.
AGENT_START_COMMANDS = frozenset(("claude", "tmux-agent-session-namer"))
STATUS_RIGHT = (
    "#{?window_bigger,"
    "[#{window_offset_x}#,#{window_offset_y}] ,}"
    "%H:%M %d-%b-%y"
)


class Agent(StrEnum):
    CLAUDE = "claude"
    CODEX = "codex"


class Invocation(StrEnum):
    CLAUDE = "claude"
    CODEX_CLIENT = "codex-client"
    CODEX_HOOK = "codex-hook"
    CODEX_REMOTE = "codex-remote"


class CodexHookEvent(StrEnum):
    SESSION_START = "SessionStart"
    STOP = "Stop"


class CodexTitleConfig(StrEnum):
    CONFIGURED = "configured"
    GLOBAL_MISCONFIGURED = "global-misconfigured"
    PROJECT_MISCONFIGURED = "project-misconfigured"


class JsonRpcClient:
    def __init__(self, process: subprocess.Popen[bytes]) -> None:
        if process.stdin is None or process.stdout is None:
            raise OSError("app-server pipes unavailable")
        self.process = process
        self.stdin = cast(IO[bytes], process.stdin)
        self.stdout = cast(IO[bytes], process.stdout)
        self.pending = b""

    def send(self, message: JsonObject) -> None:
        self.stdin.write((json.dumps(message) + "\n").encode())
        self.stdin.flush()

    def request(
        self,
        message: JsonObject,
        *,
        request_id: int,
    ) -> JsonObject:
        self.send(message)
        deadline = time.monotonic() + 3
        while True:
            while b"\n" not in self.pending:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise TimeoutError
                readable, _, _ = select.select(
                    [self.stdout],
                    [],
                    [],
                    remaining,
                )
                if not readable:
                    raise TimeoutError
                chunk = os.read(self.stdout.fileno(), 4096)
                if not chunk:
                    raise EOFError
                self.pending += chunk
            line, self.pending = self.pending.split(b"\n", 1)
            parsed: object = json.loads(line)
            response = _as_json_object(parsed)
            if response.get("id") == request_id:
                return response


def _as_json_object(value: object) -> JsonObject:
    if not isinstance(value, dict):
        raise TypeError("expected JSON object")
    if not all(isinstance(key, str) for key in value):
        raise TypeError("expected string JSON keys")
    return cast(JsonObject, value)


def _nested_json_object(value: JsonObject, key: str) -> JsonObject:
    return _as_json_object(value[key])


def _stop_process(process: subprocess.Popen[bytes]) -> None:
    if process.poll() is not None:
        return
    try:
        process.terminate()
    except ProcessLookupError:
        return
    try:
        process.wait(timeout=1)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait()


def _codex_result(method: str, params: JsonObject) -> JsonObject | None:
    process: subprocess.Popen[bytes] | None = None
    try:
        process = subprocess.Popen(
            ["codex", "app-server", "--listen", "stdio://"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
        client = JsonRpcClient(process)
        client.request(
            {
                "id": 1,
                "method": "initialize",
                "params": {
                    "clientInfo": {
                        "name": "tmux-agent-session-namer",
                        "version": "1",
                    },
                },
            },
            request_id=1,
        )
        client.send({"method": "initialized", "params": {}})
        response = client.request(
            {
                "id": 2,
                "method": method,
                "params": params,
            },
            request_id=2,
        )
        return _nested_json_object(response, "result")
    except (
        EOFError,
        OSError,
        TimeoutError,
        json.JSONDecodeError,
        KeyError,
        TypeError,
    ):
        return None
    finally:
        if process is not None:
            _stop_process(process)


def _codex_result_has_thread_only_title(
    result: dict[str, object] | None,
) -> bool:
    if result is None:
        return False
    try:
        config = _nested_json_object(result, "config")
        tui = _nested_json_object(config, "tui")
        terminal_title = tui["terminal_title"]
    except KeyError, TypeError:
        return False
    return (
        isinstance(terminal_title, list)
        and len(terminal_title) == 1
        and isinstance(terminal_title[0], str)
        and terminal_title[0] in CODEX_THREAD_TITLE_IDS
    )


def codex_thread_title_config() -> CodexTitleConfig:
    global_result = _codex_result(
        "config/read",
        {"includeLayers": False},
    )
    if not _codex_result_has_thread_only_title(global_result):
        return CodexTitleConfig.GLOBAL_MISCONFIGURED
    effective_result = _codex_result(
        "config/read",
        {
            "cwd": os.getcwd(),
            "includeLayers": False,
        },
    )
    if not _codex_result_has_thread_only_title(effective_result):
        return CodexTitleConfig.PROJECT_MISCONFIGURED
    return CodexTitleConfig.CONFIGURED


def codex_thread_label(session_id: str) -> str | None:
    result = _codex_result(
        "thread/read",
        {
            "threadId": session_id,
            "includeTurns": False,
        },
    )
    if result is None:
        return None
    try:
        thread = _nested_json_object(result, "thread")
    except KeyError, TypeError:
        return None
    for key in ("name", "preview"):
        value = thread.get(key)
        if isinstance(value, str) and value.strip():
            return value
    return None


def _read_codex_hook_input() -> tuple[CodexHookEvent | None, str | None]:
    if sys.stdin.isatty():
        return None, None
    try:
        hook_input = _as_json_object(json.load(sys.stdin))
    except OSError, json.JSONDecodeError, TypeError:
        return None, None

    event_value = hook_input.get("hook_event_name")
    try:
        event = (
            CodexHookEvent(event_value)
            if isinstance(event_value, str)
            else None
        )
    except ValueError:
        event = None
    session_id = hook_input.get("session_id")
    return event, session_id if isinstance(session_id, str) else None


def _run_tmux(*args: str, capture_output: bool = False) -> str:
    result = subprocess.run(
        ["tmux", *args],
        check=False,
        stdout=subprocess.PIPE if capture_output else subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        text=True,
    )
    return result.stdout.rstrip("\n") if capture_output else ""


def _slot_for(option: str) -> str | None:
    """Return the session's slot for one agent, allocating a free one.

    None once all hundred are in use. Callers hold TMUX_SLOT_LOCK, which
    is what keeps two sessions starting at once from picking the same
    number.
    """
    current = _run_tmux(
        "show-options",
        "-qv",
        option,
        capture_output=True,
    )
    if current:
        return current

    output = _run_tmux(
        "list-sessions",
        "-F",
        f"#{{{option}}}",
        capture_output=True,
    )
    used = {
        line
        for line in output.splitlines()
        if re.fullmatch(r"[0-9][0-9]", line)
    }
    for number in range(100):
        candidate = f"{number:02d}"
        if candidate not in used:
            _run_tmux("set-option", option, candidate)
            return candidate
    return None


@functools.cache
def _pane_starts_an_agent() -> bool:
    """Report whether tmux was launched to run an agent in this pane.

    tmux records the command it started the pane with and keeps it after
    that command execs something else, so this still answers for a pane
    whose agent has been running for days. An empty answer is a pane tmux
    opened for a shell, whatever was later typed into it. Naming stops
    rather than guessing wherever the answer cannot be had for the pane
    we are in: an unset `TMUX_PANE`, an unparseable command, or a read
    tmux refuses. It stops too where the launcher is unrecognisable as
    one, which includes handing tmux the whole command as a single
    argument -- `tmux new "claude --resume"` records the quoted string
    and nothing splits it back apart.

    Cached because the answer holds for one run of this process: what
    rewrites it is `respawn-pane`, which replaces whatever the pane was
    running. Ownership is the opposite, claimable by another agent
    mid-run, so every caller re-reads that.
    """
    pane = os.environ.get("TMUX_PANE")
    if not pane:
        return False

    start = _run_tmux(
        "display-message",
        "-p",
        "-t",
        pane,
        "#{pane_start_command}",
        capture_output=True,
    )
    try:
        argv = shlex.split(start)
    except ValueError:
        return False
    return bool(argv) and os.path.basename(argv[0]) in AGENT_START_COMMANDS


def _session_owner() -> str:
    return _run_tmux(
        "show-options",
        "-qv",
        SESSION_AGENT_OPTION,
        capture_output=True,
    )


def _allocate_slot(agent: Agent) -> str | None:
    """Return this agent's slot, or None when it names nothing.

    None covers a pane tmux did not start an agent in and a session
    another agent owns, as well as `_slot_for` finding no free number.
    Refusing the second matters because an agent started inside another
    agent's pane would otherwise take the naming over: the title still
    comes from the pane's own agent, so it would be rendered under the
    wrong slot and through a format written for a title the other agent
    never emits.
    """
    if not _pane_starts_an_agent():
        return None

    _run_tmux("wait-for", "-L", TMUX_SLOT_LOCK)
    try:
        owner = _session_owner()
        if owner and owner != agent:
            return None

        slot = _slot_for(f"@{agent}_num")
        if slot is not None and not owner:
            _run_tmux("set-option", SESSION_AGENT_OPTION, agent)
        return slot
    finally:
        _run_tmux("wait-for", "-U", TMUX_SLOT_LOCK)


def _configure_tmux(agent: Agent) -> None:
    option = f"@{agent}_num"
    if _allocate_slot(agent) is None:
        return

    title = "#{pane_title}"
    if agent is Agent.CLAUDE:
        title = "#{s|^. ||:pane_title}"
    name = f"#{{=30:{agent}#{{{option}}}-#{{s| |-|:{title}}}}}"
    conditional_name = f"#{{?pane_title,{name},#{{session_name}}}}"
    hook = f'rename-session "{conditional_name}"'

    _run_tmux("set-hook", "pane-title-changed", hook)
    _run_tmux("rename-session", conditional_name)
    _run_tmux("set-option", "status-left-length", "34")
    _run_tmux("set-option", "status-right", STATUS_RIGHT)


def _literal_tmux_format(value: str) -> str:
    return value.replace("#", "##")


def _rename_tmux(agent: Agent, title: str) -> None:
    slot = _allocate_slot(agent)
    if slot is None:
        return

    fragment = re.sub(r"\s+", "-", title).strip("-")
    fragment = "".join(
        character for character in fragment if character.isprintable()
    )
    if not fragment:
        return
    name = f"{agent}{slot}-{fragment}"[:30]
    _run_tmux("rename-session", _literal_tmux_format(name))


def _parse_invocation(argv: list[str]) -> Invocation | None:
    if not argv:
        return None
    try:
        invocation = Invocation(argv[0])
    except ValueError:
        return None
    if invocation is not Invocation.CODEX_REMOTE and len(argv) != 1:
        return None
    return invocation


def main(argv: list[str] | None = None) -> int:
    if not os.environ.get("TMUX"):
        return 0

    invocation_args = argv if argv is not None else sys.argv[1:]
    invocation = _parse_invocation(invocation_args)
    if invocation is None:
        return 2

    agent = Agent.CLAUDE if invocation is Invocation.CLAUDE else Agent.CODEX
    if agent is Agent.CODEX:
        if invocation is Invocation.CODEX_REMOTE:
            _configure_tmux(agent)
            os.execvp(
                "codex",
                [
                    "codex",
                    "--remote",
                    "unix://",
                    "-c",
                    'tui.terminal_title=["thread-title"]',
                    *invocation_args[1:],
                ],
            )

        if invocation is Invocation.CODEX_CLIENT:
            _configure_tmux(agent)
            return 0

        event, session_id = _read_codex_hook_input()
        # Both of these are read again by _allocate_slot, which is the
        # authoritative gate; asking here is what keeps a pane it will
        # refuse out of the app-server round-trips below.
        if not _pane_starts_an_agent():
            return 0

        owner = _session_owner()
        if owner and owner != agent:
            # Name the owner rather than the title configuration below,
            # which decides nothing while another agent owns the session.
            # The hand-over command stays in this module's docstring: this
            # message reaches whichever agent was refused, usually a nested
            # one, and an agent told how to seize the name may take it.
            if event is CodexHookEvent.SESSION_START:
                print(
                    json.dumps(
                        {
                            "continue": True,
                            "systemMessage": (
                                CODEX_SESSION_OWNER_WARNING.format(
                                    owner=owner,
                                )
                            ),
                        }
                    )
                )
            return 0

        title_config = codex_thread_title_config()
        if title_config is not CodexTitleConfig.CONFIGURED:
            warning = (
                CODEX_GLOBAL_TITLE_WARNING
                if title_config is CodexTitleConfig.GLOBAL_MISCONFIGURED
                else CODEX_PROJECT_TITLE_WARNING
            )
            if event is CodexHookEvent.SESSION_START:
                print(
                    json.dumps(
                        {
                            "continue": True,
                            "systemMessage": warning,
                        }
                    )
                )
            return 0
        if event is CodexHookEvent.STOP:
            if session_id is not None:
                title = codex_thread_label(session_id)
                if title is not None:
                    _rename_tmux(agent, title)
            return 0

    _configure_tmux(agent)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
