class JsonRpcClient:
    def __init__(self, process: subprocess.Popen[bytes]) -> None:
        if process.stdin is None or process.stdout is None:
            raise OSError("app-server pipes unavailable")
        self.process = process
        self.stdin = cast(IO[bytes], process.stdin)
        self.stdout = cast(IO[bytes], process.stdout)
        self.pending = b""

    def send(self, message: JsonObject) -> None:
        self.stdin.write((json.dumps(message) + "\n").encode())
        self.stdin.flush()

    def request(
        self,
        message: JsonObject,
        *,
        request_id: int,
    ) -> JsonObject:
        self.send(message)
        deadline = time.monotonic() + 3
        while True:
            while b"\n" not in self.pending:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise TimeoutError
                readable, _, _ = select.select(
                    [self.stdout],
                    [],
                    [],
                    remaining,
                )
                if not readable:
                    raise TimeoutError
                chunk = os.read(self.stdout.fileno(), 4096)
                if not chunk:
                    raise EOFError
                self.pending += chunk
            line, self.pending = self.pending.split(b"\n", 1)
            parsed: object = json.loads(line)
            response = _as_json_object(parsed)
            if response.get("id") == request_id:
                return response


def _as_json_object(value: object) -> JsonObject:
    if not isinstance(value, dict):
        raise TypeError("expected JSON object")
    if not all(isinstance(key, str) for key in value):
        raise TypeError("expected string JSON keys")
    return cast(JsonObject, value)


def _nested_json_object(value: JsonObject, key: str) -> JsonObject:
    return _as_json_object(value[key])


def _stop_process(process: subprocess.Popen[bytes]) -> None:
    if process.poll() is not None:
        return
    try:
        process.terminate()
    except ProcessLookupError:
        return
    try:
        process.wait(timeout=1)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait()


def _codex_result(method: str, params: JsonObject) -> JsonObject | None:
    process: subprocess.Popen[bytes] | None = None
    try:
        process = subprocess.Popen(
            ["codex", "app-server", "--listen", "stdio://"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
        client = JsonRpcClient(process)
        client.request(
            {
                "id": 1,
                "method": "initialize",
                "params": {
                    "clientInfo": {
                        "name": "tmux-agent-session-namer",
                        "version": "1",
                    },
                },
            },
            request_id=1,
        )
        client.send({"method": "initialized", "params": {}})
        response = client.request(
            {
                "id": 2,
                "method": method,
                "params": params,
            },
            request_id=2,
        )
        return _nested_json_object(response, "result")
    except (
        EOFError,
        OSError,
        TimeoutError,
        json.JSONDecodeError,
        KeyError,
        TypeError,
    ):
        return None
    finally:
        if process is not None:
            _stop_process(process)


def _codex_result_has_thread_only_title(
    result: dict[str, object] | None,
) -> bool:
    if result is None:
        return False
    try:
        config = _nested_json_object(result, "config")
        tui = _nested_json_object(config, "tui")
        terminal_title = tui["terminal_title"]
    except KeyError, TypeError:
        return False
    return (
        isinstance(terminal_title, list)
        and len(terminal_title) == 1
        and isinstance(terminal_title[0], str)
        and terminal_title[0] in CODEX_THREAD_TITLE_IDS
    )


def codex_thread_title_config() -> CodexTitleConfig:
    global_result = _codex_result(
        "config/read",
        {"includeLayers": False},
    )
    if not _codex_result_has_thread_only_title(global_result):
        return CodexTitleConfig.GLOBAL_MISCONFIGURED
    effective_result = _codex_result(
        "config/read",
        {
            "cwd": os.getcwd(),
            "includeLayers": False,
        },
    )
    if not _codex_result_has_thread_only_title(effective_result):
        return CodexTitleConfig.PROJECT_MISCONFIGURED
    return CodexTitleConfig.CONFIGURED


def codex_thread_label(session_id: str) -> str | None:
    result = _codex_result(
        "thread/read",
        {
            "threadId": session_id,
            "includeTurns": False,
        },
    )
    if result is None:
        return None
    try:
        thread = _nested_json_object(result, "thread")
    except KeyError, TypeError:
        return None
    for key in ("name", "preview"):
        value = thread.get(key)
        if isinstance(value, str) and value.strip():
            return value
    return None


def _read_codex_hook_input() -> tuple[CodexHookEvent | None, str | None]:
    if sys.stdin.isatty():
        return None, None
    try:
        hook_input = _as_json_object(json.load(sys.stdin))
    except OSError, json.JSONDecodeError, TypeError:
        return None, None

    event_value = hook_input.get("hook_event_name")
    try:
        event = (
            CodexHookEvent(event_value)
            if isinstance(event_value, str)
            else None
        )
    except ValueError:
        event = None
    session_id = hook_input.get("session_id")
    return event, session_id if isinstance(session_id, str) else None


def _muse_session_name_db() -> str | None:
    """Return the session name authority database, if one is present.

    The authority lives outside the session log tree, in a platform
    location, so this probes the known ones rather than deriving it.
    None means naming stays silent: a hook that cannot resolve the name
    must not disturb the tool call it is gating.
    """
    override = os.environ.get(MUSE_SESSION_NAME_DB_ENV)
    if override:
        return override
    home = os.path.expanduser("~")
    data_home = os.environ.get("XDG_DATA_HOME", os.path.join(home, ".local"))
    candidates = [
        os.path.join(
            home,
            "Library",
            "Application Support",
            "muse",
            "session-name-authority",
            "session-names.db",
        ),
        os.path.join(
            data_home,
            "share",
            "muse",
            "session-name-authority",
            "session-names.db",
        ),
        os.path.join(
            data_home,
            "muse",
            "session-name-authority",
            "session-names.db",
        ),
    ]
    for candidate in candidates:
        if os.path.isfile(candidate):
            return candidate
    return None


def muse_canonical_session_name(session_id: str) -> str | None:
    """Return the authority's canonical name for a session, if any.

    Read-only and total: every lookup failure answers None so callers
    can stay silent instead of breaking the gated tool call.
    """
    db = _muse_session_name_db()
    if db is None:
        return None
    try:
        connection = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
        try:
            row = connection.execute(
                "SELECT normalized_name FROM session_name_claims "
                "WHERE session_id = ? AND kind = 'canonical'",
                (session_id,),
            ).fetchone()
        finally:
            connection.close()
    except OSError, sqlite3.Error:
        return None
    if not isinstance(row, tuple) or not row:
        return None
    name = row[0]
    return name.strip() if isinstance(name, str) and name.strip() else None


def _muse_reported_names_path() -> str:
    state_dir = os.environ.get(MUSE_REPORTED_NAMES_DIR_ENV)
    if not state_dir:
        cache_home = os.environ.get("XDG_CACHE_HOME", "")
        if not cache_home:
            cache_home = os.path.join(
                os.path.expanduser("~"),
                ".cache",
            )
        state_dir = os.path.join(cache_home, "tmux-agent-session-namer")
    return os.path.join(state_dir, MUSE_REPORTED_NAMES_FILENAME)


def _muse_reported_names() -> dict[str, str]:
    try:
        with open(_muse_reported_names_path(), encoding="utf-8") as handle:
            parsed: object = json.load(handle)
    except OSError, json.JSONDecodeError:
        return {}
    if not isinstance(parsed, dict):
        return {}
    return {
        session_id: name
        for session_id, name in parsed.items()
        if isinstance(session_id, str) and isinstance(name, str)
    }


def _record_muse_reported_name(session_id: str, name: str) -> bool:
    try:
        path = _muse_reported_names_path()
        os.makedirs(os.path.dirname(path), exist_ok=True)
        reported = _muse_reported_names()
        reported[session_id] = name
        with open(path, "w", encoding="utf-8") as handle:
            json.dump(reported, handle)
    except OSError:
        return False
    return True


def _muse_rename_directive(name: str) -> str:
    helper = (
        "$HOME/.local/libexec/tmux-agent-session-namer/"
        "tmux-agent-session-namer"
    )
    return (
        "Session housekeeping: this Muse session is currently named "
        f'"{name}". Run "{helper}" muse "{name}" now, before you '
        "finish this turn, to keep the tmux session name in sync; skip "
        "this only if TMUX or TMUX_PANE is unset in your environment. "
        "The helper itself decides whether renaming applies."
    )


def _read_muse_hook_input() -> tuple[
    str | None, str | None, JsonObject | None
]:
    if sys.stdin.isatty():
        return None, None, None
    try:
        hook_input = _as_json_object(json.load(sys.stdin))
        tool_input = hook_input.get("tool_input")
        tool_object = (
            _as_json_object(tool_input)
            if isinstance(tool_input, dict)
            else None
        )
    except OSError, json.JSONDecodeError, TypeError:
        return None, None, None
    session_id = hook_input.get("session_id")
    tool_name = hook_input.get("tool_name")
    return (
        session_id if isinstance(session_id, str) else None,
        tool_name if isinstance(tool_name, str) else None,
        tool_object,
    )


def _tmux_server_socket(candidate: str) -> bool:
    """Return whether a live tmux server listens at a socket path.

    A bare connect is refused at once when only a stale socket file
    remains, so this stays fast over directories full of dead test
    sockets. Connecting without speaking leaves the server alone.
    """
    probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        probe.settimeout(2)
        probe.connect(candidate)
    except OSError:
        return False
    finally:
        probe.close()
    return True


def _tmux_socket_paths() -> list[str]:
    """Return canonical live tmux server socket paths, if any exist.

    The hook environment carries no TMUX address, so the rewrite grants
    every live server socket owned by this user: the agent's own server
    is always among them. Liveness keeps dead socket files out of the
    grant, which matters because the hook result must stay small. The
    grant is what lets the prepended rename reach tmux through the
    agent sandbox, after the user approves it. TMUX_TMPDIR is honored
    exactly as tmux honors it, which also keeps tests hermetic.
    """
    base = os.environ.get("TMUX_TMPDIR", "/tmp")
    directory = os.path.join(base, f"tmux-{os.getuid()}")
    try:
        entries = sorted(os.listdir(directory))
    except OSError:
        return []
    paths = []
    for entry in entries:
        candidate = os.path.join(directory, entry)
        if _tmux_server_socket(candidate):
            resolved = os.path.realpath(candidate)
            if resolved not in paths:
                paths.append(resolved)
    return paths


def _muse_shell_rewrite(tool_input: JsonObject, name: str) -> JsonObject:
    """Return tool input with a silent rename prepended, if possible.

    The agent executes shell calls in its own environment, which unlike
    the hook's carries the tmux address, so a prepended rename is the
    one path that needs no model compliance. The helper prints nothing
    and the `|| true` keeps a helper failure from ever breaking the
    original command, whose exit status the `;` preserves. The helper
    runs through `uv run --script`, whose cache cannot live under the
    sandbox, so the prepend points UV_CACHE_DIR at tmp; it also
    declares the user's tmux socket grant, without which the sandboxed
    call cannot connect and for which the agent prompts. Returns the
    input unchanged when it carries no string command to extend.
    """
    command = tool_input.get("command")
    if not isinstance(command, str) or not command.strip():
        return tool_input
    helper = (
        'UV_CACHE_DIR="${TMPDIR:-/tmp}/tmux-agent-session-namer-uv" '
        "$HOME/.local/libexec/tmux-agent-session-namer/"
        "tmux-agent-session-namer"
    )
    rewritten = dict(tool_input)
    rewritten["command"] = (
        f"{helper} muse {shlex.quote(name)} >/dev/null 2>&1 || true; {command}"
    )
    sockets = _tmux_socket_paths()
    if sockets:
        existing = tool_input.get("unix_socket_paths")
        granted = list(existing) if isinstance(existing, list) else []
        for path in sockets:
            if path not in granted:
                granted.append(path)
        rewritten["unix_socket_paths"] = granted
    return rewritten


def _muse_hook_result(
    session_id: str | None,
    tool_name: str | None,
    tool_input: JsonObject | None,
) -> JsonObject | None:
    """Return the PreToolUse output document, or None for silence.

    None covers an unreadable hook payload and a tool call carrying no
    input to echo: without the input there is nothing safe to approve.
    Otherwise the run always approves. Shell calls carry the rename
    prepended, which executes with the agent's own tmux environment
    and needs no model compliance, but only until the session's name
    is reported: the prepend's socket grant prompts on every call that
    carries it, so repeating it would nag. Every other call falls back
    to the bare approval plus, only when the session carries a name
    this session has not been told yet, the rename directive. Every
    failure below the echo falls back to the bare approval so the
    gated tool call always proceeds.
    """
    if tool_input is None:
        return None

    def approve(updated: JsonObject) -> JsonObject:
        return {
            "hookSpecificOutput": {
                "hookEventName": "PreToolUse",
                "permissionDecision": "allow",
                "updatedInput": updated,
            },
        }

    if session_id is None:
        return approve(tool_input)
    name = muse_canonical_session_name(session_id)
    if not name:
        return approve(tool_input)
    reported = _muse_reported_names().get(session_id) == name
    if tool_name == "bash":
        command = tool_input.get("command")
        if not isinstance(command, str) or not command.strip():
            return approve(tool_input)
        if reported:
            return approve(tool_input)
        if not _record_muse_reported_name(session_id, name):
            return approve(tool_input)
        return approve(_muse_shell_rewrite(tool_input, name))
    if reported:
        return approve(tool_input)
    if not _record_muse_reported_name(session_id, name):
        return approve(tool_input)
    output = approve(tool_input)
    hook_output = _as_json_object(output["hookSpecificOutput"])
    hook_output["additionalContext"] = _muse_rename_directive(name)
    return output


def _run_tmux(*args: str, capture_output: bool = False) -> str:
    result = subprocess.run(
        ["tmux", *args],
        check=False,
        stdout=subprocess.PIPE if capture_output else subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        text=True,
    )
    return result.stdout.rstrip("\n") if capture_output else ""


def _slot_for(option: str) -> str | None:
    """Return the session's slot for one agent, allocating a free one.

    None once all hundred are in use. Callers hold TMUX_SLOT_LOCK, which
    is what keeps two sessions starting at once from picking the same
    number.
    """
    current = _run_tmux(
        "show-options",
        "-qv",
        option,
        capture_output=True,
    )
    if current:
        return current

    output = _run_tmux(
        "list-sessions",
        "-F",
        f"#{{{option}}}",
        capture_output=True,
    )
    used = {
        line
        for line in output.splitlines()
        if re.fullmatch(r"[0-9][0-9]", line)
    }
    for number in range(100):
        candidate = f"{number:02d}"
        if candidate not in used:
            _run_tmux("set-option", option, candidate)
            return candidate
    return None


@functools.cache
def _pane_starts_an_agent() -> bool:
    """Report whether tmux was launched to run an agent in this pane.

    tmux records the command it started the pane with and keeps it after
    that command execs something else, so this still answers for a pane
    whose agent has been running for days. An empty answer is a pane tmux
    opened for a shell, whatever was later typed into it. Naming stops
    rather than guessing wherever the answer cannot be had for the pane
    we are in: an unset `TMUX_PANE`, an unparseable command, or a read
    tmux refuses. It stops too where the launcher is unrecognisable as
    one, which includes handing tmux the whole command as a single
    argument -- `tmux new "claude --resume"` records the quoted string
    and nothing splits it back apart.

    Cached because the answer holds for one run of this process: what
    rewrites it is `respawn-pane`, which replaces whatever the pane was
    running. Ownership is the opposite, claimable by another agent
    mid-run, so every caller re-reads that.
    """
    pane = os.environ.get("TMUX_PANE")
    if not pane:
        return False

    start = _run_tmux(
        "display-message",
        "-p",
        "-t",
        pane,
        "#{pane_start_command}",
        capture_output=True,
    )
    try:
        argv = shlex.split(start)
    except ValueError:
        return False
    return bool(argv) and os.path.basename(argv[0]) in AGENT_START_COMMANDS


def _session_owner() -> str:
    return _run_tmux(
        "show-options",
        "-qv",
        SESSION_AGENT_OPTION,
        capture_output=True,
    )


def _allocate_slot(agent: Agent) -> str | None:
    """Return this agent's slot, or None when it names nothing.

    None covers a pane tmux did not start an agent in and a session
    another agent owns, as well as `_slot_for` finding no free number.
    Refusing the second matters because an agent started inside another
    agent's pane would otherwise take the naming over: the title still
    comes from the pane's own agent, so it would be rendered under the
    wrong slot and through a format written for a title the other agent
    never emits.
    """
    if not _pane_starts_an_agent():
        return None

    _run_tmux("wait-for", "-L", TMUX_SLOT_LOCK)
    try:
        owner = _session_owner()
        if owner and owner != agent:
            return None

        slot = _slot_for(f"@{agent}_num")
        if slot is not None and not owner:
            _run_tmux("set-option", SESSION_AGENT_OPTION, agent)
        return slot
    finally:
        _run_tmux("wait-for", "-U", TMUX_SLOT_LOCK)


def _configure_status() -> None:
    """Show the bracketed session name left and the clock right.

    A global status line can truncate the left at a length that fits
    its own format but not an agentNN-name, so every agent-owned
    session carries its own pair: a wide-enough left and a plain right.
    """
    _run_tmux("set-option", "status-left", "[#{session_name}] ")
    _run_tmux("set-option", "status-left-length", "34")
    _run_tmux("set-option", "status-right", STATUS_RIGHT)


def _configure_tmux(agent: Agent) -> None:
    option = f"@{agent}_num"
    if _allocate_slot(agent) is None:
        return

    title = "#{pane_title}"
    if agent is Agent.CLAUDE:
        title = "#{s|^. ||:pane_title}"
    name = f"#{{=30:{agent}#{{{option}}}-#{{s| |-|:{title}}}}}"
    conditional_name = f"#{{?pane_title,{name},#{{session_name}}}}"
    hook = f'rename-session "{conditional_name}"'

    _run_tmux("set-hook", "pane-title-changed", hook)
    _run_tmux("rename-session", conditional_name)
    _configure_status()


def _literal_tmux_format(value: str) -> str:
    return value.replace("#", "##")


def _rename_tmux(agent: Agent, title: str) -> None:
    slot = _allocate_slot(agent)
    if slot is None:
        return

    fragment = re.sub(r"\s+", "-", title).strip("-")
    fragment = "".join(
        character for character in fragment if character.isprintable()
    )
    name = f"{agent}{slot}-{fragment}" if fragment else f"{agent}{slot}"
    _configure_status()
    _run_tmux("rename-session", _literal_tmux_format(name[:30]))


def _parse_invocation(argv: list[str]) -> Invocation | None:
    if not argv:
        return None
    try:
        invocation = Invocation(argv[0])
    except ValueError:
        return None
    if invocation is Invocation.CODEX_REMOTE:
        return invocation
    if invocation in NAME_ARGUMENT_INVOCATIONS:
        return invocation if len(argv) == 2 else None
    return invocation if len(argv) == 1 else None


def main(argv: list[str] | None = None) -> int:
    invocation_args = argv if argv is not None else sys.argv[1:]
    invocation = _parse_invocation(invocation_args)
    if invocation is None:
        return 2

    if invocation is Invocation.MUSE_HOOK:
        # Hook runs arrive with a sanitized environment, so this answers
        # before the TMUX gate below: the agent addressed by the
        # directive carries the tmux environment, not the hook. Silence
        # and bare approvals keep the gated tool call proceeding
        # whatever goes wrong resolving the name.
        session_id, tool_name, tool_input = _read_muse_hook_input()
        result = _muse_hook_result(session_id, tool_name, tool_input)
        if result is not None:
            print(json.dumps(result))
        return 0

    if not os.environ.get("TMUX"):
        return 0

    if invocation is Invocation.CLAUDE:
        agent = Agent.CLAUDE
    elif invocation in NAME_ARGUMENT_INVOCATIONS:
        agent = Agent(invocation)
        # The agent's own tooling hands over its current session name,
        # so nothing here has to resolve it. Each run re-reads the pane
        # gate and the owner, which is what keeps a rename tracking the
        # session across repeated runs.
        _rename_tmux(agent, invocation_args[1])
        return 0
    else:
        agent = Agent.CODEX
    if agent is Agent.CODEX:
        if invocation is Invocation.CODEX_REMOTE:
            _configure_tmux(agent)
            os.execvp(
                "codex",
                [
                    "codex",
                    "--remote",
                    "unix://",
                    "-c",
                    'tui.terminal_title=["thread-title"]',
                    *invocation_args[1:],
                ],
            )

        if invocation is Invocation.CODEX_CLIENT:
            _configure_tmux(agent)
            return 0

        event, session_id = _read_codex_hook_input()
        # Both of these are read again by _allocate_slot, which is the
        # authoritative gate; asking here is what keeps a pane it will
        # refuse out of the app-server round-trips below.
        if not _pane_starts_an_agent():
            return 0

        owner = _session_owner()
        if owner and owner != agent:
            # Name the owner rather than the title configuration below,
            # which decides nothing while another agent owns the session.
            # The hand-over command stays in this module's docstring: this
            # message reaches whichever agent was refused, usually a nested
            # one, and an agent told how to seize the name may take it.
            if event is CodexHookEvent.SESSION_START:
                print(
                    json.dumps(
                        {
                            "continue": True,
                            "systemMessage": (
                                CODEX_SESSION_OWNER_WARNING.format(
                                    owner=owner,
                                )
                            ),
                        }
                    )
                )
            return 0

        title_config = codex_thread_title_config()
        if title_config is not CodexTitleConfig.CONFIGURED:
            warning = (
                CODEX_GLOBAL_TITLE_WARNING
                if title_config is CodexTitleConfig.GLOBAL_MISCONFIGURED
                else CODEX_PROJECT_TITLE_WARNING
            )
            if event is CodexHookEvent.SESSION_START:
                print(
                    json.dumps(
                        {
                            "continue": True,
                            "systemMessage": warning,
                        }
                    )
                )
            return 0
        if event is CodexHookEvent.STOP:
            if session_id is not None:
                title = codex_thread_label(session_id)
                if title is not None:
                    _rename_tmux(agent, title)
            return 0

    _configure_tmux(agent)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
