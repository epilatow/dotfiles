class JsonRpcClient:
    def __init__(self, process: subprocess.Popen[bytes]) -> None:
        if process.stdin is None or process.stdout is None:
            raise OSError("app-server pipes unavailable")
        self.process = process
        self.stdin = cast(IO[bytes], process.stdin)
        self.stdout = cast(IO[bytes], process.stdout)
        self.pending = b""

    def send(self, message: JsonObject) -> None:
        self.stdin.write((json.dumps(message) + "\n").encode())
        self.stdin.flush()

    def request(
        self,
        message: JsonObject,
        *,
        request_id: int,
    ) -> JsonObject:
        self.send(message)
        deadline = time.monotonic() + 3
        while True:
            while b"\n" not in self.pending:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise TimeoutError
                readable, _, _ = select.select(
                    [self.stdout],
                    [],
                    [],
                    remaining,
                )
                if not readable:
                    raise TimeoutError
                chunk = os.read(self.stdout.fileno(), 4096)
                if not chunk:
                    raise EOFError
                self.pending += chunk
            line, self.pending = self.pending.split(b"\n", 1)
            parsed: object = json.loads(line)
            response = _as_json_object(parsed)
            if response.get("id") == request_id:
                return response


def _as_json_object(value: object) -> JsonObject:
    if not isinstance(value, dict):
        raise TypeError("expected JSON object")
    if not all(isinstance(key, str) for key in value):
        raise TypeError("expected string JSON keys")
    return cast(JsonObject, value)


def _nested_json_object(value: JsonObject, key: str) -> JsonObject:
    return _as_json_object(value[key])


def _stop_process(process: subprocess.Popen[bytes]) -> None:
    if process.poll() is not None:
        return
    try:
        process.terminate()
    except ProcessLookupError:
        return
    try:
        process.wait(timeout=1)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait()


def _codex_result(method: str, params: JsonObject) -> JsonObject | None:
    process: subprocess.Popen[bytes] | None = None
    try:
        process = subprocess.Popen(
            ["codex", "app-server", "--listen", "stdio://"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
        client = JsonRpcClient(process)
        client.request(
            {
                "id": 1,
                "method": "initialize",
                "params": {
                    "clientInfo": {
                        "name": "tmux-agent-session-namer",
                        "version": "1",
                    },
                },
            },
            request_id=1,
        )
        client.send({"method": "initialized", "params": {}})
        response = client.request(
            {
                "id": 2,
                "method": method,
                "params": params,
            },
            request_id=2,
        )
        return _nested_json_object(response, "result")
    except (
        EOFError,
        OSError,
        TimeoutError,
        json.JSONDecodeError,
        KeyError,
        TypeError,
    ):
        return None
    finally:
        if process is not None:
            _stop_process(process)


def _codex_result_has_thread_only_title(
    result: dict[str, object] | None,
) -> bool:
    if result is None:
        return False
    try:
        config = _nested_json_object(result, "config")
        tui = _nested_json_object(config, "tui")
        terminal_title = tui["terminal_title"]
    except KeyError, TypeError:
        return False
    return (
        isinstance(terminal_title, list)
        and len(terminal_title) == 1
        and isinstance(terminal_title[0], str)
        and terminal_title[0] in CODEX_THREAD_TITLE_IDS
    )


def codex_thread_title_config() -> CodexTitleConfig:
    global_result = _codex_result(
        "config/read",
        {"includeLayers": False},
    )
    if not _codex_result_has_thread_only_title(global_result):
        return CodexTitleConfig.GLOBAL_MISCONFIGURED
    effective_result = _codex_result(
        "config/read",
        {
            "cwd": os.getcwd(),
            "includeLayers": False,
        },
    )
    if not _codex_result_has_thread_only_title(effective_result):
        return CodexTitleConfig.PROJECT_MISCONFIGURED
    return CodexTitleConfig.CONFIGURED


def codex_thread_label(session_id: str) -> str | None:
    result = _codex_result(
        "thread/read",
        {
            "threadId": session_id,
            "includeTurns": False,
        },
    )
    if result is None:
        return None
    try:
        thread = _nested_json_object(result, "thread")
    except KeyError, TypeError:
        return None
    for key in ("name", "preview"):
        value = thread.get(key)
        if isinstance(value, str) and value.strip():
            return value
    return None


def _read_codex_hook_input() -> tuple[CodexHookEvent | None, str | None]:
    if sys.stdin.isatty():
        return None, None
    try:
        hook_input = _as_json_object(json.load(sys.stdin))
    except OSError, json.JSONDecodeError, TypeError:
        return None, None

    event_value = hook_input.get("hook_event_name")
    try:
        event = (
            CodexHookEvent(event_value)
            if isinstance(event_value, str)
            else None
        )
    except ValueError:
        event = None
    session_id = hook_input.get("session_id")
    return event, session_id if isinstance(session_id, str) else None


def _muse_session_name_db() -> str | None:
    """Return the session name authority database, if one is present.

    The authority lives outside the session log tree, in a platform
    location, so this probes the known ones rather than deriving it.
    None means naming stays silent: a watcher that cannot resolve the
    name must not disturb the session it is watching.
    """
    override = os.environ.get(MUSE_SESSION_NAME_DB_ENV)
    if override:
        return override
    home = os.path.expanduser("~")
    data_home = os.environ.get("XDG_DATA_HOME", os.path.join(home, ".local"))
    candidates = [
        os.path.join(
            home,
            "Library",
            "Application Support",
            "muse",
            "session-name-authority",
            "session-names.db",
        ),
        os.path.join(
            data_home,
            "share",
            "muse",
            "session-name-authority",
            "session-names.db",
        ),
        os.path.join(
            data_home,
            "muse",
            "session-name-authority",
            "session-names.db",
        ),
    ]
    for candidate in candidates:
        if os.path.isfile(candidate):
            return candidate
    return None


def muse_canonical_session_name(session_id: str) -> str | None:
    """Return the authority's canonical name for a session, if any.

    Read-only and total: every lookup failure answers None so callers
    can stay silent instead of breaking the gated tool call.
    """
    db = _muse_session_name_db()
    if db is None:
        return None
    try:
        connection = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
        try:
            row = connection.execute(
                "SELECT normalized_name FROM session_name_claims "
                "WHERE session_id = ? AND kind = 'canonical'",
                (session_id,),
            ).fetchone()
        finally:
            connection.close()
    except OSError, sqlite3.Error:
        return None
    if not isinstance(row, tuple) or not row:
        return None
    name = row[0]
    return name.strip() if isinstance(name, str) and name.strip() else None


def _run_tmux(*args: str, capture_output: bool = False) -> str:
    result = subprocess.run(
        ["tmux", *args],
        check=False,
        stdout=subprocess.PIPE if capture_output else subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        text=True,
    )
    return result.stdout.rstrip("\n") if capture_output else ""


def _slot_for(option: str, target: str | None = None) -> str | None:
    """Return the session's slot for one agent, allocating a free one.

    None once all hundred are in use. Callers hold TMUX_SLOT_LOCK, which
    is what keeps two sessions starting at once from picking the same
    number. The used-number scan stays global: slots are unique across
    every session on the server, wherever the target lives.
    """
    current = _run_tmux(
        "show-options",
        *_session_target_args(target),
        "-qv",
        option,
        capture_output=True,
    )
    if current:
        return current

    output = _run_tmux(
        "list-sessions",
        "-F",
        f"#{{{option}}}",
        capture_output=True,
    )
    used = {
        line
        for line in output.splitlines()
        if re.fullmatch(r"[0-9][0-9]", line)
    }
    for number in range(100):
        candidate = f"{number:02d}"
        if candidate not in used:
            _run_tmux(
                "set-option",
                *_session_target_args(target),
                option,
                candidate,
            )
            return candidate
    return None


@functools.cache
def _pane_starts_an_agent(pane: str | None = None) -> bool:
    """Report whether tmux was launched to run an agent in a pane.

    tmux records the command it started the pane with and keeps it after
    that command execs something else, so this still answers for a pane
    whose agent has been running for days. An empty answer is a pane tmux
    opened for a shell, whatever was later typed into it. Naming stops
    rather than guessing wherever the answer cannot be had for the pane:
    an unset pane, an unparseable command, or a read tmux refuses. It
    stops too where the launcher is unrecognisable as one, which includes
    handing tmux the whole command as a single argument --
    `tmux new "claude --resume"` records the quoted string and nothing
    splits it back apart.

    Callers pass the pane they mean; None falls back to `TMUX_PANE` for
    runs answering about their own pane. Cached because the answer holds
    for one run of this process: what rewrites it is `respawn-pane`,
    which replaces whatever the pane was running. Ownership is the
    opposite, claimable by another agent mid-run, so every caller
    re-reads that.
    """
    if pane is None:
        pane = os.environ.get("TMUX_PANE")
    if not pane:
        return False

    start = _run_tmux(
        "display-message",
        "-p",
        "-t",
        pane,
        "#{pane_start_command}",
        capture_output=True,
    )
    try:
        argv = shlex.split(start)
    except ValueError:
        return False
    return bool(argv) and os.path.basename(argv[0]) in AGENT_START_COMMANDS


def _session_target_args(target: str | None) -> list[str]:
    """Return the tmux target flag for a session-scoped call, if any.

    Calls that run with a pane context (a tool call's environment, a
    pane the user is in) address their own session with no flag. Calls
    that supervise another pane, like the watcher half of muse-run
    naming its pane's session, name the pane whose session they mean
    instead.
    """
    return ["-t", target] if target else []


def _session_owner(target: str | None = None) -> str:
    return _run_tmux(
        "show-options",
        *_session_target_args(target),
        "-qv",
        SESSION_AGENT_OPTION,
        capture_output=True,
    )


def _allocate_slot(agent: Agent, target: str | None = None) -> str | None:
    """Return this agent's slot, or None when it names nothing.

    None covers a pane tmux did not start an agent in and a session
    another agent owns, as well as `_slot_for` finding no free number.
    Refusing the second matters because an agent started inside another
    agent's pane would otherwise take the naming over: the title still
    comes from the pane's own agent, so it would be rendered under the
    wrong slot and through a format written for a title the other agent
    never emits.
    """
    if not _pane_starts_an_agent(target):
        return None

    _run_tmux("wait-for", "-L", TMUX_SLOT_LOCK)
    try:
        owner = _session_owner(target)
        if owner and owner != agent:
            return None

        slot = _slot_for(f"@{agent}_num", target)
        if slot is not None and not owner:
            _run_tmux(
                "set-option",
                *_session_target_args(target),
                SESSION_AGENT_OPTION,
                agent,
            )
        return slot
    finally:
        _run_tmux("wait-for", "-U", TMUX_SLOT_LOCK)


def _configure_status(target: str | None = None) -> None:
    """Show the bracketed session name left and the clock right.

    A global status line can truncate the left at a length that fits
    its own format but not an agentNN-name, so every agent-owned
    session carries its own pair: a wide-enough left and a plain right.
    The window list between them is cleared as well: the bracketed
    name already identifies the session, and a `0:window-name` entry
    beside it reads as noise.
    """
    for option, value in (
        ("status-left", "[#{session_name}] "),
        ("status-left-length", "34"),
        ("status-right", STATUS_RIGHT),
        ("window-status-format", ""),
        ("window-status-current-format", ""),
        ("window-status-separator", ""),
    ):
        _run_tmux("set-option", *_session_target_args(target), option, value)


def _configure_tmux(agent: Agent) -> None:
    option = f"@{agent}_num"
    if _allocate_slot(agent) is None:
        return

    title = "#{pane_title}"
    if agent is Agent.CLAUDE:
        title = "#{s|^. ||:pane_title}"
    name = f"#{{=30:{agent}#{{{option}}}-#{{s| |-|:{title}}}}}"
    conditional_name = f"#{{?pane_title,{name},#{{session_name}}}}"
    hook = f'rename-session "{conditional_name}"'

    _run_tmux("set-hook", "pane-title-changed", hook)
    _run_tmux("rename-session", conditional_name)
    _configure_status()


def _literal_tmux_format(value: str) -> str:
    return value.replace("#", "##")


def _muse_sessions_root() -> str | None:
    """Return the directory holding Muse session logs, if one exists.

    Muse writes one directory per session, named for the session id
    and holding its session.jsonl. The override keeps tests hermetic.
    """
    override = os.environ.get(MUSE_SESSIONS_DIR_ENV)
    if override:
        return override
    home = os.path.expanduser("~")
    data_home = os.environ.get("XDG_DATA_HOME", os.path.join(home, ".local"))
    for candidate in (
        os.path.join(data_home, "share", "muse", "sessions"),
        os.path.join(data_home, "muse", "sessions"),
    ):
        if os.path.isdir(candidate):
            return candidate
    return None


def _read_log_edges(path: str) -> list[str]:
    """Return the head and tail of a session log, tolerantly.

    Route facts are written at open, so the head usually holds the
    pane mapping; the tail covers logs whose start rotated past the
    scan window. Reads stay small no matter how large logs grow.
    """
    try:
        size = os.path.getsize(path)
    except OSError:
        return []
    try:
        with open(path, "rb") as handle:
            head = handle.read(MUSE_WATCH_LOG_SCAN_BYTES)
            tail = b""
            if size > MUSE_WATCH_LOG_SCAN_BYTES:
                handle.seek(-MUSE_WATCH_LOG_SCAN_BYTES, os.SEEK_END)
                tail = handle.read()
    except OSError:
        return []
    return [
        chunk.decode("utf-8", "replace") for chunk in (head, tail) if chunk
    ]


def _muse_session_for_pane(
    root: str, pane: str, socket_path: str
) -> str | None:
    """Return the Muse session id running in a tmux pane, if resolvable.

    Session logs carry one route_facts record naming the pane and
    socket the session runs on, so the newest log naming this pane on
    this socket is its session: a restart lands in a newer directory
    and wins naturally. Silence covers every lookup failure.
    """
    # Real logs carry one compact route_facts record near the head
    # with bare quotes; stay tolerant of spacing and escaping so
    # pretty-printed or doubly-encoded variants still resolve. The
    # socket matches in either its recorded or its resolved spelling:
    # one side may spell /tmp where the other spells /private/tmp.
    pane_pattern = re.compile(
        r'tmux_pane\\*"\s*:\s*\\*"[^"\\]*' + re.escape(pane) + r'"'
    )
    sockets = {socket_path, os.path.realpath(socket_path)}
    socket_pattern = re.compile(
        r'tmux_socket_path\\*"\s*:\s*\\*"(?:'
        + "|".join(re.escape(spelling) for spelling in sorted(sockets))
        + r')"'
    )
    candidates = []
    try:
        years = [entry for entry in os.scandir(root) if entry.is_dir()]
    except OSError:
        return None
    for year in years:
        months = _child_dirs(year.path)
        for month in months:
            days = _child_dirs(month.path)
            for day in days:
                for session in _child_dirs(day.path):
                    try:
                        mtime = session.stat().st_mtime
                    except OSError:
                        continue
                    candidates.append((mtime, session.path))
    candidates.sort(reverse=True)
    # Newest first, bounded: past the scan limit an old session's pane
    # mapping silently stops resolving, which is the documented cost of
    # keeping every pass small no matter how many sessions exist.
    for _, path in candidates[:MUSE_WATCH_SESSION_SCAN_LIMIT]:
        for chunk in _read_log_edges(os.path.join(path, "session.jsonl")):
            for line in chunk.splitlines():
                if _route_facts_match(
                    line, pane, sockets, pane_pattern, socket_pattern
                ):
                    return os.path.basename(path)
    return None


def _route_facts_match(
    line: str,
    pane: str,
    sockets: set[str],
    pane_pattern: re.Pattern[str],
    socket_pattern: re.Pattern[str],
) -> bool:
    """Report whether one log line maps a pane to a known socket.

    Route facts are JSON objects, so parse first and compare exact
    values: the pane matches when it names the record's pane id, the
    socket when it equals the recorded path. Matching per line keeps a
    pane from one record from pairing with a socket from another.
    Unparseable lines fall back to the tolerant patterns, which keep
    odd encodings resolving at that mixing cost.
    """
    record = _route_facts_record(line)
    if record is None:
        return bool(pane_pattern.search(line) and socket_pattern.search(line))
    panes = set(re.findall(r"%\d+", str(record.get("tmux_pane"))))
    return pane in panes and record.get("tmux_socket_path") in sockets


def _route_facts_record(line: str) -> dict[str, object] | None:
    """Return a log line's route_facts record mapping, if it has one."""
    try:
        parsed = json.loads(line)
    except ValueError:
        return None
    if not isinstance(parsed, dict):
        return None
    payload = parsed.get("payload")
    if isinstance(payload, dict):
        record = payload.get("record")
    else:
        record = parsed.get("record")
    return record if isinstance(record, dict) else None


def _child_dirs(path: str) -> list[os.DirEntry[str]]:
    try:
        return [entry for entry in os.scandir(path) if entry.is_dir()]
    except OSError:
        return []


def _muse_socket() -> str:
    """Return the tmux server socket this shell addresses."""
    tmux = os.environ.get("TMUX", "")
    if tmux:
        return tmux.split(",")[0]
    base = os.environ.get("TMUX_TMPDIR", "/tmp")
    return os.path.join(base, f"tmux-{os.getuid()}")


def _watch_once(pane: str, reported: set[tuple[str, str]]) -> bool:
    """Run one watcher pass for a pane; False means the pane is gone.

    A pass renames the pane's session to its current Muse session name
    when one is known and new since the last verified rename, and
    remembers names it reads back. A rename tmux silently dropped stays
    forgotten, so a later pass retries it. Silence covers every lookup
    failure.
    """
    panes = _run_tmux(
        "list-panes", "-a", "-F", "#{pane_id}", capture_output=True
    )
    if pane not in panes.splitlines():
        return False
    root = _muse_sessions_root()
    if root is None:
        return True
    session_id = _muse_session_for_pane(root, pane, _muse_socket())
    if session_id is None:
        return True
    name = muse_canonical_session_name(session_id)
    if not name:
        return True
    if (session_id, name) in reported:
        return True
    issued = _rename_tmux(Agent.MUSE, name, pane)
    if issued is not None and _session_name(pane) == issued:
        reported.add((session_id, name))
    return True


def _muse_run(args: list[str]) -> int:
    """Run Muse as this pane's process and track its session name.

    The supervisor shape, after codex-remote: tmux starts this helper
    as the pane command. The helper forks a watcher child, then the
    parent execs `muse`, so the pane process itself is the agent and
    interactive signals need no forwarding: Ctrl-C reaches muse
    directly, while the watcher ignores its copy the way any
    background observer may, since it spawns nothing interactive.
    Naming driven by tool calls can never reach zero-tool sessions,
    so without the watcher nothing would rename them. The watcher
    exits when its parent is gone or the pane dies, so no process
    outlives the session.
    """
    pane = os.environ.get("TMUX_PANE")
    if pane is not None:
        try:
            watcher = os.fork()
        except OSError:
            # No watcher: fall through to exec unsupervised rather
            # than failing the session open.
            pass
        else:
            if watcher == 0:
                # Watcher child: the parent below becomes muse, so the
                # parent pid recorded here is muse's pid until muse
                # exits and this process is reparented. That pid cannot
                # be reused while this watcher lives: tmux starts each
                # pane as its own process group led by the pane
                # process, so the recorded pid is a pgid this watcher
                # itself keeps referenced. No setsid or setpgid here:
                # leaving the pane's group is what keeps the terminal
                # delivering to muse. Ignoring SIGINT is safe this side
                # of the fork: the only processes this side spawns are
                # short-lived tmux status queries, never anything
                # interactive.
                signal.signal(signal.SIGINT, signal.SIG_IGN)
                parent = os.getppid()
                reported: set[tuple[str, str]] = set()
                while os.getppid() == parent and _watch_once(pane, reported):
                    # Re-probe the pane gate every pass: respawn-pane
                    # can replace the pane's command mid-run, and a
                    # cached answer would keep renaming a pane no agent
                    # runs in.
                    _pane_starts_an_agent.cache_clear()
                    time.sleep(MUSE_WATCH_INTERVAL_SECONDS)
                os._exit(0)
    try:
        os.execvp("muse", ["muse", *args])
    except OSError as exc:
        print(
            f"tmux-agent-session-namer: cannot start muse: {exc}",
            file=sys.stderr,
        )
        return 1
    return 1


def _session_name(target: str | None = None) -> str:
    """Report a session's current name, or "" when tmux won't say."""
    return _run_tmux(
        "display-message",
        "-p",
        *_session_target_args(target),
        "#{session_name}",
        capture_output=True,
    )


def _rename_tmux(
    agent: Agent, title: str, target: str | None = None
) -> str | None:
    """Rename toward the agent's slot; None when the slot is refused.

    The returned name is the truncated form tmux received, not proof
    tmux applied it: tmux errors stay silent, as everywhere else in
    this helper. Callers comparing against a read-back must use this
    form, since tmux never sees the untruncated name.
    """
    slot = _allocate_slot(agent, target)
    if slot is None:
        return None

    fragment = re.sub(r"\s+", "-", title).strip("-")
    fragment = "".join(
        character for character in fragment if character.isprintable()
    )
    name = f"{agent}{slot}-{fragment}" if fragment else f"{agent}{slot}"
    issued = name[:30]
    _configure_status(target)
    _run_tmux(
        "rename-session",
        *_session_target_args(target),
        _literal_tmux_format(issued),
    )
    return issued


def _parse_invocation(argv: list[str]) -> Invocation | None:
    if not argv:
        return None
    try:
        invocation = Invocation(argv[0])
    except ValueError:
        return None
    if invocation is Invocation.CODEX_REMOTE:
        return invocation
    if invocation is Invocation.MUSE_RUN:
        return invocation
    if invocation in NAME_ARGUMENT_INVOCATIONS:
        return invocation if len(argv) == 2 else None
    return invocation if len(argv) == 1 else None


def main(argv: list[str] | None = None) -> int:
    invocation_args = argv if argv is not None else sys.argv[1:]
    invocation = _parse_invocation(invocation_args)
    if invocation is None:
        return 2

    if invocation is Invocation.MUSE_RUN:
        return _muse_run(invocation_args[1:])

    if not os.environ.get("TMUX"):
        return 0

    if invocation is Invocation.CLAUDE:
        agent = Agent.CLAUDE
    elif invocation in NAME_ARGUMENT_INVOCATIONS:
        agent = Agent(invocation)
        # The agent's own tooling hands over its current session name,
        # so nothing here has to resolve it. Each run re-reads the pane
        # gate and the owner, which is what keeps a rename tracking the
        # session across repeated runs.
        _rename_tmux(agent, invocation_args[1])
        return 0
    else:
        agent = Agent.CODEX
    if agent is Agent.CODEX:
        if invocation is Invocation.CODEX_REMOTE:
            _configure_tmux(agent)
            os.execvp(
                "codex",
                [
                    "codex",
                    "--remote",
                    "unix://",
                    "-c",
                    'tui.terminal_title=["thread-title"]',
                    *invocation_args[1:],
                ],
            )

        if invocation is Invocation.CODEX_CLIENT:
            _configure_tmux(agent)
            return 0

        event, session_id = _read_codex_hook_input()
        # Both of these are read again by _allocate_slot, which is the
        # authoritative gate; asking here is what keeps a pane it will
        # refuse out of the app-server round-trips below. The explicit
        # None matches _allocate_slot's untargeted call so the cached
        # probe answers both.
        if not _pane_starts_an_agent(None):
            return 0

        owner = _session_owner()
        if owner and owner != agent:
            # Name the owner rather than the title configuration below,
            # which decides nothing while another agent owns the session.
            # The hand-over command stays in this module's docstring: this
            # message reaches whichever agent was refused, usually a nested
            # one, and an agent told how to seize the name may take it.
            if event is CodexHookEvent.SESSION_START:
                print(
                    json.dumps(
                        {
                            "continue": True,
                            "systemMessage": (
                                CODEX_SESSION_OWNER_WARNING.format(
                                    owner=owner,
                                )
                            ),
                        }
                    )
                )
            return 0

        title_config = codex_thread_title_config()
        if title_config is not CodexTitleConfig.CONFIGURED:
            warning = (
                CODEX_GLOBAL_TITLE_WARNING
                if title_config is CodexTitleConfig.GLOBAL_MISCONFIGURED
                else CODEX_PROJECT_TITLE_WARNING
            )
            if event is CodexHookEvent.SESSION_START:
                print(
                    json.dumps(
                        {
                            "continue": True,
                            "systemMessage": warning,
                        }
                    )
                )
            return 0
        if event is CodexHookEvent.STOP:
            if session_id is not None:
                title = codex_thread_label(session_id)
                if title is not None:
                    _rename_tmux(agent, title)
            return 0

    _configure_tmux(agent)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
