class SnapshotError(Exception):
    """A run cannot produce a snapshot, for a reason worth reporting.

    Covers an unreachable source and a source whose content no longer
    has the shape the parsers expect. Both are conditions of the world
    rather than bugs in this script, so `main` reports one as a single
    error line and a nonzero exit; anything else keeps its traceback.
    """


class FetchError(SnapshotError):
    """An HTTP source could not be read."""


# Retry budget for a single URL. A run reads four sources in sequence
# and any one of them failing ends it, so a source that is briefly
# unreachable costs the whole day's snapshot unless the run waits it
# out. Delays grow 5s, 15s, 45s, which with the attempts' own timeouts
# bounds one URL at about five minutes and a run whose every source
# needs retrying at about twenty -- inside the job timeout, so a slow
# recovery still finishes rather than being killed partway.
HTTP_ATTEMPTS = 4
HTTP_BACKOFF_SEC = 5.0
HTTP_BACKOFF_FACTOR = 3.0

# Response codes worth another attempt. Everything else in the 4xx range
# describes the request, which a retry would repeat unchanged.
HTTP_RETRY_STATUSES = frozenset({408, 429})

# Failures that say nothing about whether a later attempt would work:
# DNS and connect errors (URLError), a connection dropped mid-response,
# a read that timed out, a malformed or truncated HTTP response, and a
# gzip body cut short by any of the above.
TRANSIENT_ERRORS: tuple[type[Exception], ...] = (
    urllib.error.URLError,
    ConnectionError,
    TimeoutError,
    http.client.HTTPException,
    gzip.BadGzipFile,
)


def _describe(exc: BaseException) -> str:
    """Render `exc` as "Type: message".

    The message alone is routinely ambiguous -- `[Errno 54] Connection
    reset by peer` reads the same whoever raised it -- and the class is
    what identifies the failure in a log.
    """
    return f"{type(exc).__name__}: {exc}"


def _retryable(exc: Exception) -> bool:
    """Whether another identical request could plausibly succeed."""
    if isinstance(exc, urllib.error.HTTPError):
        return exc.code in HTTP_RETRY_STATUSES or exc.code >= 500
    return True


