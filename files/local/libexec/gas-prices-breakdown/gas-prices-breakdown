class SnapshotError(Exception):
    """A run cannot produce a snapshot, for a reason worth reporting.

    Covers an unreachable source and a source whose content no longer
    has the shape the parsers expect. Both are conditions of the world
    rather than bugs in this script, so `main` reports one as a single
    error line and a nonzero exit; anything else keeps its traceback.
    """


class FetchError(SnapshotError):
    """An HTTP source could not be read."""


# Retry budget for a single URL. A run reads four sources in sequence
# and any one of them failing ends it, so a source that is briefly
# unreachable costs the whole day's snapshot unless the run waits it
# out. Delays grow 5s, 15s, 45s, which with the attempts' own timeouts
# bounds one URL at about five minutes and a run whose every source
# needs retrying at about twenty -- inside the job timeout, so a slow
# recovery still finishes rather than being killed partway.
HTTP_ATTEMPTS = 4
HTTP_BACKOFF_SEC = 5.0
HTTP_BACKOFF_FACTOR = 3.0

# Response codes worth another attempt. Everything else in the 4xx range
# describes the request, which a retry would repeat unchanged.
HTTP_RETRY_STATUSES = frozenset({408, 429})

# Failures that say nothing about whether a later attempt would work:
# DNS and connect errors (URLError), a connection dropped mid-response,
# a read that timed out, a malformed or truncated HTTP response, and a
# gzip body cut short by any of the above.
TRANSIENT_ERRORS: tuple[type[Exception], ...] = (
    urllib.error.URLError,
    ConnectionError,
    TimeoutError,
    http.client.HTTPException,
    gzip.BadGzipFile,
)


def _describe(exc: BaseException) -> str:
    """Render `exc` as "Type: message".

    The message alone is routinely ambiguous -- `[Errno 54] Connection
    reset by peer` reads the same whoever raised it -- and the class is
    what identifies the failure in a log.
    """
    return f"{type(exc).__name__}: {exc}"


def _retryable(exc: Exception) -> bool:
    """Whether another identical request could plausibly succeed."""
    if isinstance(exc, urllib.error.HTTPError):
        return exc.code in HTTP_RETRY_STATUSES or exc.code >= 500
    return True


# ---------------------------------------------------------------------------
# Fetch helpers
# ---------------------------------------------------------------------------


def _http_bytes_once(url: str) -> bytes:
    """GET `url` and return the decompressed response body."""
    req = urllib.request.Request(
        url,
        headers={
            "User-Agent": USER_AGENT,
            "Accept": (
                "text/html,application/xhtml+xml,application/xml;q=0.9,"
                "*/*;q=0.8"
            ),
            "Accept-Language": "en-US,en;q=0.9",
            "Accept-Encoding": "gzip",
        },
    )
    with urllib.request.urlopen(req, timeout=60) as resp:
        body: bytes = resp.read()
        if resp.headers.get("Content-Encoding") == "gzip":
            body = gzip.decompress(body)
    return body


def _http_bytes(url: str) -> bytes:
    """GET `url`, retrying transient failures, and return the body.

    Raises `FetchError` once the attempts are spent, or immediately for
    a failure that describes the request rather than the connection.
    """
    attempt = 0
    while True:
        attempt += 1
        try:
            return _http_bytes_once(url)
        except TRANSIENT_ERRORS as exc:
            if not _retryable(exc):
                raise FetchError(f"GET {url}: {_describe(exc)}") from exc
            if attempt >= HTTP_ATTEMPTS:
                raise FetchError(
                    f"GET {url}: {_describe(exc)} "
                    f"(giving up after {attempt} attempts)"
                ) from exc
            delay = HTTP_BACKOFF_SEC * HTTP_BACKOFF_FACTOR ** (attempt - 1)
            log.warning(
                "attempt %d/%d for %s failed (%s); retrying in %.0fs",
                attempt,
                HTTP_ATTEMPTS,
                url,
                _describe(exc),
                delay,
            )
            time.sleep(delay)


def _http_text(url: str) -> str:
    """GET `url` and decode the body as UTF-8, replacing bad bytes.

    The sources served here are HTML pages whose declared encoding the
    parsing callers do not consult; a replacement char in stray markup
    is preferable to failing the whole run on one bad byte.
    """
    return _http_bytes(url).decode("utf-8", errors="replace")


# How a snapshot carries its own date. Every reader of that field
# goes through this so a change to the shape lands in one place.
SNAPSHOT_DATE_RE = re.compile(r'date: "(\d{4}-\d{2}-\d{2})"')


def read_html(path: Path) -> str:
    """Read the page every subcommand operates on.

    The path is supplied on the command line -- by a scheduled job that
    cannot answer a prompt -- so a missing or unreadable file is an
    ordinary bad-input condition, not a defect worth a traceback.
    """
    try:
        return path.read_text()
    except OSError as exc:
        raise SnapshotError(f"cannot read {path}: {_describe(exc)}") from exc


def _load_workbook(path: Path, source: str) -> openpyxl.Workbook:
    """Open a downloaded xlsx, naming `source` if it will not open.

    A source that answers with an HTML error page instead of the
    workbook still returns 200, so the substitution surfaces here as a
    zip that will not open rather than as a failed fetch.
    """
    try:
        return openpyxl.load_workbook(path, data_only=True)
    # A body that is not a zip at all raises BadZipFile; one that is a
    # zip without the parts an xlsx must have raises KeyError naming the
    # first part openpyxl looked for. Both mean the same thing here.
    except (zipfile.BadZipFile, KeyError) as exc:
        raise SnapshotError(
            f"{source}: downloaded file is not a readable xlsx "
            f"({_describe(exc)})"
        ) from exc


def most_recent_thursday(today: date | None = None) -> date:
    # Snapshots are keyed by the publishing host's local calendar date,
    # so the default resolves "now" against the local zone rather than
    # UTC -- an evening run west of Greenwich is still the same day.
    today = today or datetime.now(tz=UTC).astimezone().date()
    return today - timedelta(days=(today.weekday() - 3) % 7)


# ---------------------------------------------------------------------------
# AAA retail
# ---------------------------------------------------------------------------


def _aaa_as_of(html: str) -> date:
    """Read the date AAA stamps its averages with.

    It is the only thing distinguishing fresh prices from a page that
    has stopped updating, since the table itself looks the same either
    way.

    The pattern is deliberately narrow: a two-digit year, matched
    case-sensitively, anywhere in the document. The page renders the
    phrase more than once and the copies agree, so the first match is
    taken. A four-digit year or a capitalised "As of" fails here rather
    than parsing to something plausible, which is the right way round
    for a check whose whole job is to notice the page changing.
    """
    match = re.search(r"as of (\d{1,2})/(\d{1,2})/(\d{2})\b", html)
    if not match:
        raise SnapshotError("AAA: no 'as of' date found on page")
    month, day, year = (int(part) for part in match.groups())
    try:
        return date(2000 + year, month, day)
    except ValueError as exc:
        raise SnapshotError(
            f"AAA: unreadable 'as of' date {match.group(0)!r}: "
            f"{_describe(exc)}"
        ) from exc


def fetch_aaa_retail(target: date) -> dict[str, float]:
    """Return per-state retail averages good for `target`.

    The page only ever serves today's averages, so the check is on the
    distance between its stamp and `target` in either direction: too far
    behind means the feed stopped, and too far ahead means the snapshot
    is being backfilled for a date these prices never described. The
    snapshot's own notes claim the retail is as of its date, and this is
    what keeps that true.
    """
    html = _http_text(AAA_URL)
    as_of = _aaa_as_of(html)
    drift = (target - as_of).days
    if abs(drift) > AAA_STALE_DAYS:
        direction = "before" if drift > 0 else "after"
        raise SnapshotError(
            f"AAA: page is dated {as_of}, {abs(drift)} days {direction} "
            f"{target}, over the {AAA_STALE_DAYS}-day limit; these averages "
            f"do not describe {target}"
        )
    table_match = re.search(
        r'<table[^>]*id="sortable"[^>]*>(.*?)</table>',
        html,
        re.DOTALL,
    )
    if not table_match:
        raise SnapshotError("AAA: sortable table not found on page")
    rows = re.findall(r"<tr[^>]*>(.*?)</tr>", table_match.group(1), re.DOTALL)
    out: dict[str, float] = {}
    for tr in rows[1:]:
        tds = re.findall(r"<td[^>]*>(.*?)</td>", tr, re.DOTALL)
        if not tds:
            continue
        name_match = re.search(r"<a[^>]*>(.*?)</a>", tds[0], re.DOTALL)
        if not name_match:
            continue
        state = re.sub(r"\s+", " ", name_match.group(1)).strip()
        state = state.replace("&amp;", "&")
        if state not in STATE_CODE:
            raise SnapshotError(f"AAA: unrecognized state {state!r}")
        if len(tds) < 2:
            raise SnapshotError(f"AAA: missing price columns for {state}")
        clean = re.sub(r"<[^>]+>", "", tds[1])
        clean = re.sub(r"\s+", " ", clean).strip().lstrip("$")
        out[STATE_CODE[state]] = float(clean)
    if len(out) != 51:
        raise SnapshotError(f"AAA: parsed {len(out)} states, expected 51")
    return out


