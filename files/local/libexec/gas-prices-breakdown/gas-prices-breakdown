    sha256: str


def tax_baseline_sha256(period: TaxPeriod) -> str:
    """Identify the selected rates, including their publication period."""
    encoded = json.dumps(
        (
            period.period.isoformat(),
            period.federal,
            period.per_state,
            period.excise,
            period.notes,
        ),
        sort_keys=True,
    )
    return hashlib.sha256(encoded.encode()).hexdigest()


def assert_researched_baseline(period: TaxPeriod) -> None:
    actual = tax_baseline_sha256(period)
    if RESEARCH_EIA_TAX_PERIOD is not None and (
        period.period != RESEARCH_EIA_TAX_PERIOD
        or actual != RESEARCH_EIA_BASELINE_SHA256
    ):
        raise SnapshotError(
            f"EIA tax baseline mismatch: research {RESEARCH_EIA_TAX_PERIOD} "
            f"{RESEARCH_EIA_BASELINE_SHA256}; selected {period.period} "
            f"{actual}. Assign the period and sha256 from "
            "research-template --tax-baseline JSON"
        )


def cmd_research_template(args: argparse.Namespace) -> int:
    if args.schema:
        print(json.dumps(ResearchData.model_json_schema(), indent=2))
    elif args.tax_baseline:
        cache = args.cache_dir or (
            Path.home() / ".cache" / "gas-prices-breakdown"
        )
        cache.mkdir(parents=True, exist_ok=True)
        period = fetch_tax_period_for_target_date(
            args.target or most_recent_thursday(), cache
        )
        baseline: TaxBaseline = {
            "period": period.period.isoformat(),
            "federal": period.federal,
            "state_totals": period.per_state,
            "state_excise": period.excise,
            "state_notes": period.notes,
            "unquantified_exclusions": UNQUANTIFIED_FEE_NOTES,
            "fee_allocation_policy": FEE_ALLOCATION_POLICY,
            "computed_supplements": {
                "IN": "Excise, monthly gasoline use tax and inspection fee; "
                "the two suspensions are separate researched windows",
                "CT": "8.1% of New York Harbor spot, capped at $3 per gallon",
                "DE": "Annual HSCA fraction of New York Harbor spot",
                "HI": "4% of retail; county surcharges excluded",
                "OH": "0.65% of Ohio's published quarterly PAT tax base",
                "NY": "Researched statewide motor-fuel sales tax per gallon; "
                "the EIA exclusion is added separately, without MCTD",
                "WA": "Researched PPT collection fraction of Los Angeles "
                "RBOB spot; zero means verified noncollection",
            },
            "required_evidence_topics": {
                state: [
                    topic.value for topic in sorted(required_topics(state))
                ]
                for state in sorted(STATE_CODE.values())
            },
            "source_url": period.source_url,
            "sha256": tax_baseline_sha256(period),
        }
        print(json.dumps(baseline, indent=2))
    else:
        target = args.target or most_recent_thursday()
        if args.previous_research is None:
            data = research_template(target)
        else:
            try:
                previous = ResearchData.model_validate_json(
                    args.previous_research.read_bytes()
                )
            except (OSError, ValueError) as exc:
                raise SnapshotError(
                    f"previous research: {_describe(exc)}"
                ) from exc
            with researched_tables(previous):
                data = research_template(target)
            data.adjustments = [
                entry
                for entry in data.adjustments
                if not excluded_fee_source(entry.state, entry.source_url)
            ]
            hints = {review.state: review for review in previous.state_reviews}
            for review in data.state_reviews:
                hint = hints.get(review.state)
                if hint is None:
                    continue
                review.sources = hint.sources.copy()
                review.note = (
                    f"Previous review on {previous.checked_through}: "
                    + hint.note
                )
        print(data.model_dump_json(indent=2))
    return 0


def cmd_validate_research(args: argparse.Namespace) -> int:
    target = args.target or most_recent_thursday()
    data = load_research(args.research, target)
    cache = args.cache_dir or Path.home() / ".cache/gas-prices-breakdown"
    cache.mkdir(parents=True, exist_ok=True)
    with researched_tables(data):
        latest_auction(CARB_CCA_AUCTIONS, target, program="CARB_CCA_AUCTIONS")
        latest_auction(WA_CCA_AUCTIONS, target, program="WA_CCA_AUCTIONS")
        select_de_hsca_rate(target)
        assert_researched_baseline(
            fetch_tax_period_for_target_date(target, cache)
        )
    verify_research_evidence(data, cache)
    log.info("research covers %s and all 51 jurisdictions", target)
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(
        dest="command", required=True, metavar="COMMAND"
    )

    p_list = sub.add_parser(
        "list-snapshots", help="list snapshots in the SNAPSHOTS array"
    )
    p_list.add_argument(
        "html", type=Path, help="path to gas-price-breakdown.html"
    )
    p_list.set_defaults(func=cmd_list_snapshots)

    p_add = sub.add_parser(
        "add-snapshot", help="fetch live data and append a new snapshot"
    )
    p_add.add_argument(
        "html", type=Path, help="path to gas-price-breakdown.html"
    )
    p_add.add_argument(
        "--target",
        type=date.fromisoformat,
        default=None,
        help="target snapshot date (default: most recent Thursday)",
    )
    p_add.add_argument(
        "--baseline",
        default=BASELINE_DATE,
        help="snapshot to inherit state-tax structure from",
    )
    p_add.add_argument(
        "--research",
        type=Path,
        help="validated research JSON for maintained rates and overrides",
    )
    p_add.add_argument(
        "--cache-dir",
        type=Path,
        help="override the download cache directory",
    )
    p_add.add_argument(
        "--dry-run",
        action="store_true",
        help="fetch and build but do not modify the HTML",
    )
    p_add.add_argument(
        "--state-dir",
        type=Path,
        default=Path.home() / ".local/state/gas-prices-breakdown",
        help="checkpoint and run artifact directory",
    )
    p_add.add_argument(
        "--inputs",
        type=Path,
        help="reuse a saved collected.json input set, including in dry runs",
    )
    p_add.add_argument(
        "--agent",
        type=AgentCli,
        choices=list(AgentCli),
        default=os.environ.get("GAS_PRICES_AGENT", "claude"),
    )
    p_add.add_argument(
        "--model",
        help="model name passed to the selected CLI (default: CLI settings)",
    )
    p_add.add_argument(
        "--agent-command",
        default=os.environ.get("GAS_PRICES_AGENT_COMMAND"),
        help="custom JSON argv containing {prompt}, and {model} if selected",
    )
    p_add.set_defaults(func=cmd_add_snapshot)

    p_seed = sub.add_parser(
        "research-template", help="print seed data or JSON Schema"
    )
    p_seed.add_argument("--target", type=date.fromisoformat)
    output = p_seed.add_mutually_exclusive_group()
    output.add_argument("--schema", action="store_true")
    output.add_argument(
        "--tax-baseline",
        action="store_true",
        help="fetch the EIA tax baseline",
    )
    p_seed.add_argument("--cache-dir", type=Path)
    p_seed.add_argument("--previous-research", type=Path)
    p_seed.set_defaults(func=cmd_research_template)

    p_check = sub.add_parser(
        "validate-research",
        help="check research, tax baseline and primary evidence",
    )
    p_check.add_argument("research", type=Path)
    p_check.add_argument("--target", type=date.fromisoformat)
    p_check.add_argument("--cache-dir", type=Path)
    p_check.set_defaults(func=cmd_validate_research)

    p_source = sub.add_parser(
        "research-source", help="retain readable primary-source evidence"
    )
    p_source.add_argument("urls", nargs="+")
    p_source.add_argument("--cache-dir", type=Path)
    p_source.set_defaults(func=cmd_research_source)

    p_rm = sub.add_parser(
        "remove-snapshot", help="remove a snapshot by its date"
    )
    p_rm.add_argument(
        "html", type=Path, help="path to gas-price-breakdown.html"
    )
    p_rm.add_argument(
        "snapshot_date",
        metavar="SNAPSHOT_DATE",
        help="ISO date of the snapshot to remove (e.g. 2026-04-09)",
    )
    p_rm.add_argument(
        "--dry-run",
        action="store_true",
        help="report what would be removed without modifying the HTML",
    )
    p_rm.set_defaults(func=cmd_remove_snapshot)

    p_md = sub.add_parser(
        "extract-markdown",
        help="write the embedded SPEC_MD to stdout or a file",
    )
    p_md.add_argument(
        "html", type=Path, help="path to gas-price-breakdown.html"
    )
    p_md.add_argument(
        "--output",
        type=Path,
        default=None,
        help="write to this path (default: stdout)",
    )
    p_md.set_defaults(func=cmd_extract_markdown)

    args = parser.parse_args(argv)
    setup_logging()
    # `func` reaches argparse as an opaque default, so its type has to
    # be restated here for the subcommand contract to be checked.
    handler: Callable[[argparse.Namespace], int] = args.func
    try:
        if args.command == "add-snapshot" and args.research is not None:
            data = load_research(
                args.research, args.target or most_recent_thursday()
            )
            with researched_tables(data):
                return locked_add_snapshot(args)
        if args.command == "add-snapshot":
            return locked_add_snapshot(args)
        return handler(args)
    except (SnapshotError, OSError) as exc:
        log.error("%s", exc)
        return 1


if __name__ == "__main__":
    sys.exit(main())
