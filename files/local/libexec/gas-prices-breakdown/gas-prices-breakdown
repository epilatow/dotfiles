# ---------------------------------------------------------------------------


def _http_bytes_once(url: str, headers: dict[str, str] | None = None) -> bytes:
    """GET `url` and return the decompressed response body.

    `headers` carries anything the caller must send but must not put in
    the URL -- credentials above all, since the URL reaches the logs and
    the error text and the header never does.
    """
    req = urllib.request.Request(
        url,
        headers={
            "User-Agent": USER_AGENT,
            "Accept": (
                "text/html,application/xhtml+xml,application/xml;q=0.9,"
                "*/*;q=0.8"
            ),
            "Accept-Language": "en-US,en;q=0.9",
            "Accept-Encoding": "gzip",
            **(headers or {}),
        },
    )
    with urllib.request.urlopen(req, timeout=60) as resp:
        body: bytes = resp.read()
        if resp.headers.get("Content-Encoding") == "gzip":
            body = gzip.decompress(body)
    return body


def _http_bytes(url: str, headers: dict[str, str] | None = None) -> bytes:
    """GET `url`, retrying transient failures, and return the body.

    Raises `FetchError` once the attempts are spent, or immediately for
    a failure that describes the request rather than the connection.
    Both the log line and the error text carry `url`, so a credential
    belongs in `headers` and never in the query string.
    """
    attempt = 0
    while True:
        attempt += 1
        try:
            return _http_bytes_once(url, headers)
        except TRANSIENT_ERRORS as exc:
            if not _retryable(exc):
                raise FetchError(f"GET {url}: {_describe(exc)}") from exc
            if attempt >= HTTP_ATTEMPTS:
                raise FetchError(
                    f"GET {url}: {_describe(exc)} "
                    f"(giving up after {attempt} attempts)"
                ) from exc
            delay = HTTP_BACKOFF_SEC * HTTP_BACKOFF_FACTOR ** (attempt - 1)
            log.warning(
                "attempt %d/%d for %s failed (%s); retrying in %.0fs",
                attempt,
                HTTP_ATTEMPTS,
                url,
                _describe(exc),
                delay,
            )
            time.sleep(delay)


def _http_text(url: str) -> str:
    """GET `url` and decode the body as UTF-8, replacing bad bytes.

    The sources served here are HTML pages whose declared encoding the
    parsing callers do not consult; a replacement char in stray markup
    is preferable to failing the whole run on one bad byte.
    """
    return _http_bytes(url).decode("utf-8", errors="replace")


# How a snapshot carries its own date. Every reader of that field
# goes through this so a change to the shape lands in one place.
SNAPSHOT_DATE_RE = re.compile(r'date: "(\d{4}-\d{2}-\d{2})"')


def read_html(path: Path) -> str:
    """Read the page every subcommand operates on.

    The path is supplied on the command line -- by a scheduled job that
    cannot answer a prompt -- so a missing or unreadable file is an
    ordinary bad-input condition, not a defect worth a traceback.
    """
    try:
        return path.read_text()
    except OSError as exc:
        raise SnapshotError(f"cannot read {path}: {_describe(exc)}") from exc


def _load_workbook(path: Path, source: str) -> openpyxl.Workbook:
    """Open a downloaded xlsx, naming `source` if it will not open.

    A source that answers with an HTML error page instead of the
    workbook still returns 200, so the substitution surfaces here as a
    zip that will not open rather than as a failed fetch.
    """
    try:
        return openpyxl.load_workbook(path, data_only=True)
    # A body that is not a zip at all raises BadZipFile; one that is a
    # zip without the parts an xlsx must have raises KeyError naming the
    # first part openpyxl looked for. Both mean the same thing here.
    except (zipfile.BadZipFile, KeyError) as exc:
        raise SnapshotError(
            f"{source}: downloaded file is not a readable xlsx "
            f"({_describe(exc)})"
        ) from exc


def most_recent_thursday(today: date | None = None) -> date:
    # Snapshots are keyed by the publishing host's local calendar date,
    # so the default resolves "now" against the local zone rather than
    # UTC -- an evening run west of Greenwich is still the same day.
    today = today or datetime.now(tz=UTC).astimezone().date()
    return today - timedelta(days=(today.weekday() - 3) % 7)


# ---------------------------------------------------------------------------
# AAA retail
# ---------------------------------------------------------------------------


def _aaa_as_of(html: str) -> date:
    """Read the date AAA stamps its averages with.

    It is the only thing distinguishing fresh prices from a page that
    has stopped updating, since the table itself looks the same either
    way.

    The pattern is deliberately narrow: a two-digit year, matched
    case-sensitively, anywhere in the document. The page renders the
    phrase more than once and the copies agree, so the first match is
    taken. A four-digit year or a capitalised "As of" fails here rather
    than parsing to something plausible, which is the right way round
    for a check whose whole job is to notice the page changing.
    """
    match = re.search(r"as of (\d{1,2})/(\d{1,2})/(\d{2})\b", html)
    if not match:
        raise SnapshotError("AAA: no 'as of' date found on page")
    month, day, year = (int(part) for part in match.groups())
    try:
        return date(2000 + year, month, day)
    except ValueError as exc:
        raise SnapshotError(
            f"AAA: unreadable 'as of' date {match.group(0)!r}: "
            f"{_describe(exc)}"
        ) from exc


def fetch_aaa_retail(target: date) -> dict[str, float]:
    """Return per-state retail averages good for `target`.

    The page only ever serves today's averages, so the check is on the
    distance between its stamp and `target` in either direction: too far
    behind means the feed stopped, and too far ahead means the snapshot
    is being backfilled for a date these prices never described. The
    snapshot's own notes claim the retail is as of its date, and this is
    what keeps that true.
    """
    html = _http_text(AAA_URL)
    as_of = _aaa_as_of(html)
    drift = (target - as_of).days
    if abs(drift) > AAA_STALE_DAYS:
        direction = "before" if drift > 0 else "after"
        raise SnapshotError(
            f"AAA: page is dated {as_of}, {abs(drift)} days {direction} "
            f"{target}, over the {AAA_STALE_DAYS}-day limit; these averages "
            f"do not describe {target}"
        )
    table_match = re.search(
        r'<table[^>]*id="sortable"[^>]*>(.*?)</table>',
        html,
        re.DOTALL,
    )
    if not table_match:
        raise SnapshotError("AAA: sortable table not found on page")
    rows = re.findall(r"<tr[^>]*>(.*?)</tr>", table_match.group(1), re.DOTALL)
    out: dict[str, float] = {}
    for tr in rows[1:]:
        tds = re.findall(r"<td[^>]*>(.*?)</td>", tr, re.DOTALL)
        if not tds:
            continue
        name_match = re.search(r"<a[^>]*>(.*?)</a>", tds[0], re.DOTALL)
        if not name_match:
            continue
        state = re.sub(r"\s+", " ", name_match.group(1)).strip()
        state = state.replace("&amp;", "&")
        if state not in STATE_CODE:
            raise SnapshotError(f"AAA: unrecognized state {state!r}")
        if len(tds) < 2:
            raise SnapshotError(f"AAA: missing price columns for {state}")
        clean = re.sub(r"<[^>]+>", "", tds[1])
        clean = re.sub(r"\s+", " ", clean).strip().lstrip("$")
        out[STATE_CODE[state]] = float(clean)
    if len(out) != 51:
        raise SnapshotError(f"AAA: parsed {len(out)} states, expected 51")
    return out


# ---------------------------------------------------------------------------
# Federal and state motor fuel tax
# ---------------------------------------------------------------------------


@dataclass(frozen=True)
class TaxPeriod:
    """The federal and per-state gasoline tax in force for a half-year.

    `per_state` is keyed by postal code and carries every state's Total
    State column: the excise plus the sales, inspection and
    environmental charges EIA groups beside it. Both it and `federal`
    are dollars per gallon, matching what the page stores.

    Four states are knowingly short here. EIA excludes taxes levied on
    gross or net receipts, which leaves out Connecticut's PGET,
    Delaware's HSCA, Ohio's PAT and Hawaii's GET; the supplement that
    restores them is applied by the caller, not baked in, so this stays
    a faithful reading of the published table.

    `excise` carries the narrower State tax column, the excise alone
    without the charges grouped beside it. It exists for Indiana, whose
    total has to be rebuilt from its parts because the use tax inside it
    is reset monthly and both halves have been suspended by order.

    `missing` names the states whose rate cell the sheet left blank.
    EIA blanks a rate during a tax holiday, but it reads the same as a
    figure nobody filled in, so the two are not distinguished here and
    a period is refused rather than guessed at when it is used.
    """

    period: date
    per_state: dict[str, float]
    excise: dict[str, float]
    federal: float
    source_url: str
    missing: tuple[str, ...]


# Sheets are named for the month they take effect, sometimes carrying a
# revision marker or stray whitespace ("January 2021_revised",
# "July 2026 (revised)", "January 2019 ").
_TAX_SHEET_RE = re.compile(r"^\s*(January|July)\s+(\d{4})")


def load_tax_periods(cache_dir: Path) -> list[TaxPeriod]:
    """Download EIA's tax workbook and read every half-year it holds."""
    xlsx_path = cache_dir / "fueltaxes.xlsx"
    xlsx_path.write_bytes(_http_bytes(EIA_FUELTAXES_URL))
    return _read_tax_periods(xlsx_path)


def select_tax_period(periods: list[TaxPeriod], target: date) -> TaxPeriod:
    """Return the tax rates in force on `target`.

    Raises `SnapshotError` when the workbook does not reach back to
    `target`, when even its newest sheet is too far behind to describe
    it -- a table EIA has stopped revising keeps answering with its last
    half-year and looks no different from a set of rates that have not
    moved -- and when the sheet in force is missing a state.

    Blanks are checked here rather than at read time so that a hole in
    one half-year does not make the other twenty-three unreadable.
    """
    usable = [p for p in periods if p.period <= target]
    if not usable:
        raise SnapshotError(
            f"EIA tax: no sheet in force on {target}; the workbook "
            f"starts at {periods[0].period}"
        )
    chosen = max(usable, key=lambda p: p.period)
    age = (target - chosen.period).days
    if age > EIA_TAX_STALE_DAYS:
        raise SnapshotError(
            f"EIA tax: newest sheet in force ({chosen.period}) is {age} "
            f"days before {target}, over the {EIA_TAX_STALE_DAYS}-day "
            f"limit; EIA has stopped publishing the table"
        )
    if chosen.missing:
        raise SnapshotError(
            f"EIA tax: the {chosen.period} sheet leaves "
            f"{', '.join(chosen.missing)} blank, so it cannot price "
            f"{target}; check whether the tax is suspended"
        )
    return chosen


def fetch_tax_period_for_target_date(
    target: date, cache_dir: Path
) -> TaxPeriod:
    """Download the tax workbook and pick the half-year for `target`."""
    return select_tax_period(load_tax_periods(cache_dir), target)


def _read_tax_periods(path: Path) -> list[TaxPeriod]:
    wb = _load_workbook(path, "EIA tax")
    periods: list[TaxPeriod] = []
    for name in wb.sheetnames:
        match = _TAX_SHEET_RE.match(name)
        if not match:
            continue
        period = date(
            int(match.group(2)), 1 if match.group(1) == "January" else 7, 1
        )
        periods.append(_read_tax_sheet(wb, name, period))
    if not periods:
        raise SnapshotError("EIA tax: workbook has no dated sheets")
    periods.sort(key=lambda p: p.period)
    return periods


def _read_tax_sheet(
    wb: openpyxl.Workbook, sheet_name: str, period: date
) -> TaxPeriod:
    """Read one half-year sheet into per-state and federal rates.

    Rows are located by their own label rather than by position: the
    federal row sits above the per-state block and carries its total in
    a different column, and the state block's first row has shifted
    between editions.
    """
    per_state: dict[str, float] = {}
    excise: dict[str, float] = {}
    federal: float | None = None
    seen: set[str] = set()
    for row in wb[sheet_name].iter_rows(values_only=True):
        if not row or not isinstance(row[0], str):
            continue
        label = _tax_label(row[0])
        if label == "Federal":
            federal = _tax_cell(row, 4)
            continue
        code = STATE_CODE.get(label)
        if code is None:
            continue
        seen.add(code)
        rate = _tax_cell(row, 3)
        if rate is not None:
            per_state[code] = rate
        state_only = _tax_cell(row, 1)
        if state_only is not None:
            excise[code] = state_only
    if federal is None:
        raise SnapshotError(
            f"EIA tax {period}: no Federal row, or its total is blank"
        )
    absent = sorted(set(STATE_CODE.values()) - seen)
    if absent:
        raise SnapshotError(
            f"EIA tax {period}: no row for {', '.join(absent)}"
        )
    return TaxPeriod(
        period=period,
        per_state=per_state,
        excise=excise,
        federal=federal,
        source_url=EIA_FUELTAXES_URL,
        missing=tuple(sorted(seen - set(per_state))),
    )


@dataclass(frozen=True)
class InGutRate:
    """Indiana's gasoline use tax for the month it was set."""

    month_start: date
    usd_per_gal: float
    source_url: str


def load_in_gut_rates(cache_dir: Path) -> dict[date, float]:
    """Download Indiana's notice and read its monthly rate history."""
    pdf_path = cache_dir / "indiana-gut.pdf"
    pdf_path.write_bytes(_http_bytes(IN_GUT_NOTICE_URL))
    return _read_in_gut_rates(pdf_path)


def select_in_gut(rates: dict[date, float], target: date) -> InGutRate:
    """Return the Indiana gasoline use tax in force on `target`.

    Raises `SnapshotError` when the notice does not reach back to
    `target`, and when the newest rate it does carry is too far behind
    to describe it -- a notice the department has stopped replacing
    keeps answering with its last month.
    """
    usable = [m for m in rates if m <= target]
    if not usable:
        raise SnapshotError(
            f"IN GUT: no rate in force on {target}; the notice starts at "
            f"{min(rates)}"
        )
    month_start = max(usable)
    age = (target - month_start).days
    if age > IN_GUT_STALE_DAYS:
        raise SnapshotError(
            f"IN GUT: newest rate in force ({month_start}) is {age} days "
            f"before {target}, over the {IN_GUT_STALE_DAYS}-day limit; "
            f"the department has stopped replacing the notice"
        )
    return InGutRate(
        month_start=month_start,
        usd_per_gal=rates[month_start],
        source_url=IN_GUT_NOTICE_URL,
    )


def fetch_in_gut_for_target_date(target: date, cache_dir: Path) -> InGutRate:
    """Download Indiana's notice and pick the month for `target`."""
    return select_in_gut(load_in_gut_rates(cache_dir), target)


_IN_GUT_PERIOD_RE = re.compile(r"^([A-Z][a-z]+) (\d{1,2}), (\d{4})$")
_IN_GUT_RATE_RE = re.compile(r"^([0-9]+(?:\.[0-9]+)?)\s*cents$")


def _read_in_gut_rates(path: Path) -> dict[date, float]:
    """Read the notice's rate history as month-start to dollars a gallon.

    The history is a three-column table -- period start, period end,
    rate -- and only the first and last are read; see
    `IN_GUT_NOTICE_URL` for why the rest of the notice is left alone.
    Rows are recognised by their own shape rather than by position,
    because the notice runs the current monthly table and an older
    semi-annual one under the same layout.
    """
    out: dict[date, float] = {}
    # pdfplumber funnels every parser failure into one wrapper, so a
    # body that is not a PDF and one truncated mid-transfer both arrive
    # as PdfminerException; a file that never landed is the OSError.
    try:
        with pdfplumber.open(path) as pdf:
            tables = [t for page in pdf.pages for t in page.extract_tables()]
    except (PdfminerException, OSError) as exc:
        raise SnapshotError(
            f"IN GUT: notice is not a readable PDF ({_describe(exc)})"
        ) from exc
    for table in tables:
        for row in table:
            cells = [(c or "").strip().replace("\n", " ") for c in row]
            if len(cells) < 3:
                continue
            start = _IN_GUT_PERIOD_RE.match(cells[0])
            rate = _IN_GUT_RATE_RE.match(cells[2])
            if not start or start.group(1) not in MONTHS or not rate:
                continue
            month = date(
                int(start.group(3)),
                MONTHS[start.group(1)],
                int(start.group(2)),
            )
            # The statute rounds the rate to a tenth of a cent, so the
            # dollar figure is exact to three places; rounding keeps the
            # cents-to-dollars division from inventing a fourth.
            out[month] = round(float(rate.group(1)) / 100, 4)
    if not out:
        raise SnapshotError("IN GUT: notice has no rate rows")
    return out


@dataclass(frozen=True)
class IndianaTax:
    """Indiana's per-gallon state tax, resolved for one date.

    `total` is what the state actually collects on the date, which is
    what the page reports. The components are kept so the snapshot can
    say which of them a suspension switched off rather than just
    showing a number that dropped.
    """

    total: float
    excise: float
    inspection_fee: float
    gut: float
    suspended: tuple[str, ...]


def _suspended_on(
    windows: list[tuple[date, date, str]], day: date
) -> str | None:
    """Return the authority suspending a tax on `day`, if any."""
    for start, end, authority in windows:
        if start <= day <= end:
            return authority
    return None


def assert_adjustments_cover(day: date) -> None:
    """Refuse a date the override sweep has not reached.

    An override that lapsed and one that was quietly extended look the
    same from here, and so do a date nobody swept and a date with no
    override. Both directions fail rather than assert an absence the
    tables cannot support.
    """
    if (
        not TAX_ADJUSTMENTS_CHECKED_FROM
        <= day
        <= TAX_ADJUSTMENTS_CHECKED_THROUGH
    ):
        raise SnapshotError(
            f"tax overrides: swept only for "
            f"{TAX_ADJUSTMENTS_CHECKED_FROM} to "
            f"{TAX_ADJUSTMENTS_CHECKED_THROUGH}, so whether a rate was "
            f"suspended or reduced on {day} is unknown; re-sweep before "
            f"moving the bound"
        )


def adjustment_on(state: str, day: date) -> TaxAdjustment | None:
    """Return the override in force for `state` on `day`, if any."""
    for entry in STATE_TAX_ADJUSTMENTS:
        if entry.state == state and entry.start <= day <= entry.end:
            return entry
    return None


def resolve_indiana_tax(
    day: date, eia_excise: float, gut: InGutRate
) -> IndianaTax:
    """Compose Indiana's state tax for `day` from its three components.

    Indiana is the one state the published tables cannot describe as a
    single figure: its use tax is reset monthly rather than twice a
    year, and its two taxes were suspended from different dates, so an
    override on the total could not express it.

    The caller is responsible for `assert_adjustments_cover`; this
    function trusts that the date is inside the swept range.
    """
    excise_by = _suspended_on(IN_EXCISE_SUSPENSIONS, day)
    gut_by = _suspended_on(IN_GUT_SUSPENSIONS, day)
    excise = 0.0 if excise_by else eia_excise
    gut_amount = 0.0 if gut_by else gut.usd_per_gal
    suspended: list[str] = []
    if excise_by:
        suspended.append(f"gasoline excise ({excise_by})")
    if gut_by:
        suspended.append(f"gasoline use tax ({gut_by})")
    return IndianaTax(
        total=round(excise + IN_OIL_INSPECTION_FEE + gut_amount, 4),
        excise=excise,
        inspection_fee=IN_OIL_INSPECTION_FEE,
        gut=gut_amount,
        suspended=tuple(suspended),
    )


@dataclass(frozen=True)
class SpotQuote:
    """A monthly spot benchmark standing in for a rack price."""

    year_month: str
    usd_per_gal: float
    series: str


@dataclass(frozen=True)
class GrossReceiptsTax:
    """A per-gallon tax the published rate table leaves out."""

    state: str
    usd_per_gal: float
    label: str
    basis: str
    exact: bool


def load_eia_api_key() -> str:
    """Read the EIA API key, naming the file when it is not there."""
    try:
        key = EIA_API_KEY_PATH.read_text().strip()
    except OSError as exc:
        raise SnapshotError(
            f"EIA API key: cannot read {EIA_API_KEY_PATH} "
            f"({_describe(exc)}); register one at "
            f"https://www.eia.gov/opendata/register.php"
        ) from exc
    if not key:
        raise SnapshotError(f"EIA API key: {EIA_API_KEY_PATH} is empty")
    return key


def load_spot_series(series: str, key: str) -> dict[str, float]:
    """Fetch one monthly spot benchmark as year-month to dollars."""
    query = urllib.parse.urlencode(
        {
            "frequency": "monthly",
            "data[0]": "value",
            "facets[series][]": series,
            "sort[0][column]": "period",
            "sort[0][direction]": "desc",
            "length": "600",
        }
    )
    # The key travels as a header, never in the query string: the URL
    # reaches the retry log and the FetchError text, and this runs
    # unattended with its stderr going to a log file.
    raw = _http_bytes(f"{EIA_SPOT_API}?{query}", {"X-Api-Key": key})
    try:
        payload = json.loads(raw)
        rows = payload["response"]["data"]
    except (json.JSONDecodeError, KeyError, TypeError) as exc:
        raise SnapshotError(
            f"EIA spot {series}: response is not the expected shape "
            f"({_describe(exc)})"
        ) from exc
    out: dict[str, float] = {}
    for row in rows:
        period, value = row.get("period"), row.get("value")
        if not isinstance(period, str):
            continue
        # The API quotes its numbers and sends null for a month it has
        # no price for, so a usable row is a string or a number that
        # parses; anything else is a gap rather than a parse failure.
        if not isinstance(value, (str, int, float)):
            continue
        try:
            out[period] = float(value)
        except ValueError:
            continue
    if not out:
        raise SnapshotError(f"EIA spot {series}: no priced months returned")
    return out


def select_spot(
    months: dict[str, float], target: date, series: str
) -> SpotQuote:
    """Return the newest spot month that was published by `target`.

    A month closes and is then published a few weeks later, so the
    newest usable month is two behind the target rather than one; see
    `EIA_SPOT_PUBLICATION_LAG_MONTHS`.

    Raises `SnapshotError` when the series does not reach back to
    `target`, and when its newest published month is too far behind to
    describe it.
    """
    available = target.year * 12 + (target.month - 1)
    available -= EIA_SPOT_PUBLICATION_LAG_MONTHS
    cutoff = f"{available // 12:04d}-{available % 12 + 1:02d}"
    usable = [m for m in months if m <= cutoff]
    if not usable:
        raise SnapshotError(
            f"EIA spot {series}: no month published by {target}; the "
            f"series starts at {min(months)}"
        )
    year_month = max(usable)
    year, month = (int(part) for part in year_month.split("-"))
    age = (target - date(year, month, 1)).days
    if age > EIA_SPOT_STALE_DAYS:
        raise SnapshotError(
            f"EIA spot {series}: newest published month is {year_month}, "
            f"{age} days before {target}, over the "
            f"{EIA_SPOT_STALE_DAYS}-day limit; the series has stopped"
        )
    return SpotQuote(
        year_month=year_month, usd_per_gal=months[year_month], series=series
    )


def select_de_hsca_rate(day: date) -> float:
    """Return Delaware's HSCA rate in force on `day`.

    The rate is recalculated each January 1, so a year nobody entered
    fails rather than silently reusing the last one -- the same reason
    every other hand-maintained figure here carries a bound. This one
    is the calendar year itself; unlike the day counts the other bounds
    use, no constant can state this rule exactly. December 31 of a leap
    year is already 365 days past its January 1, so a bound loose
    enough to accept an entry's own December must also accept the next
    New Year's Day -- the one date on which a new rate is certainly in
    force and certainly missing.
    """
    usable = [(start, rate) for start, rate in DE_HSCA_RATES if start <= day]
    if not usable:
        raise SnapshotError(
            f"DE HSCA: no rate recorded for {day}; the table starts at "
            f"{min(start for start, _ in DE_HSCA_RATES)}"
        )
    # One max() rather than an index, so the rate returned and the rate
    # whose year is checked cannot be different entries.
    start, rate = max(usable)
    if start.year != day.year:
        raise SnapshotError(
            f"DE HSCA: newest recorded rate takes effect {start}, which "
            f"is {start.year}, not the {day.year} being priced; "
            f"Delaware resets it each January 1, so the table is "
            f"missing a year"
        )
    return rate


def resolve_gross_receipts(
    state: str, day: date, retail: float, spot: SpotQuote | None
) -> GrossReceiptsTax:
    """Return the gross-receipts tax the rate table omits for `state`.

    Hawaii's is a share of the pump price and needs no benchmark. The
    other three are a share of the first sale into the state, which is
    what `spot` stands in for.
    """
    if state == "HI":
        amount = round(HI_GET_RATE * retail, 4)
        return GrossReceiptsTax(
            state=state,
            usd_per_gal=amount,
            label=f"State general excise tax ({HI_GET_RATE:.1%} of retail)",
            basis=f"{HI_GET_RATE:.1%} {TIMES} ${retail:.3f} retail; the "
            f"0.5% county surcharge is excluded, as every county and "
            f"local levy is",
            exact=True,
        )
    if spot is None:
        raise SnapshotError(f"{state}: needs a spot benchmark to be priced")
    if state == "CT":
        base = min(spot.usd_per_gal, CT_PGET_CAP_USD)
        capped = spot.usd_per_gal >= CT_PGET_CAP_USD
        return GrossReceiptsTax(
            state=state,
            usd_per_gal=round(CT_PGET_RATE * base, 4),
            label=f"Petroleum products gross earnings tax "
            f"({CT_PGET_RATE:.1%})",
            basis=(
                f"{CT_PGET_RATE:.1%} {TIMES} ${CT_PGET_CAP_USD:.2f} "
                f"statutory cap"
                if capped
                else f"{CT_PGET_RATE:.1%} {TIMES} ${base:.3f}, the "
                f"{spot.year_month} spot benchmark standing in for an "
                f"unpublished rack price; below the "
                f"${CT_PGET_CAP_USD:.2f} cap, so the benchmark carries "
                f"the figure and it runs low"
            ),
            # Above the cap the benchmark drops out of the arithmetic, so
            # the figure is the statute's rather than an estimate.
            exact=capped,
        )
    rate, label = {
        "DE": (
            select_de_hsca_rate(day),
            "Hazardous substance cleanup act tax",
        ),
        "OH": (OH_PAT_RATE, "Petroleum activity tax"),
    }[state]
    return GrossReceiptsTax(
        state=state,
        usd_per_gal=round(rate * spot.usd_per_gal, 4),
        label=f"{label} ({rate:.4%})",
        basis=f"{rate:.4%} {TIMES} ${spot.usd_per_gal:.3f}, the "
        f"{spot.year_month} spot benchmark standing in for an "
        f"unpublished rack price; spot runs below rack, so this is low",
        exact=False,
    )


def _tax_label(raw: str) -> str:
    """Reduce a row label to the bare state name.

    Editions decorate the name in two ways that carry no meaning here: a
    footnote marker appended in brackets, and a leading asterisk marking
    the row as changed since the previous edition.
    """
    return raw.split("[")[0].lstrip("* ").strip()


def _tax_cell(row: tuple[object, ...], index: int) -> float | None:
    """Read one rate cell, or None where the sheet leaves it blank."""
    value = row[index] if index < len(row) else None
    if not isinstance(value, (int, float)) or isinstance(value, bool):
        return None
    return float(value)


# ---------------------------------------------------------------------------
# California LCFS credit price
# ---------------------------------------------------------------------------


@dataclass(frozen=True)
class LcfsQuote:
    as_of: date
    usd_per_mt: float
    source_url: str


def load_lcfs_series(cache_dir: Path) -> list[tuple[date, float]]:
    """Download the monitor's export and return it as ascending pairs.

    Kept separate from the per-date selection so the transport failures
    live here and the "which quote describes this date" decision lives
    in `select_lcfs`, where it can be reasoned about without a network.
    """
    xls_path = cache_dir / "lcfs.xls"
    xls_path.write_bytes(_http_bytes(LCFS_MONITOR_XLS))
    return _read_lcfs_daily(xls_path)


def select_lcfs(quotes: list[tuple[date, float]], target: date) -> LcfsQuote:
    """Return the newest LCFS credit assessment as of `target`.

    The series is assessed each trading day, so unlike the quarterly
    auction tables there is no publication lag to apply: the quote for a
    date is the quote for that date. Gaps are weekends and holidays,
    which `LCFS_STALE_DAYS` is sized to absorb.
    """
    usable = [q for q in quotes if q[0] <= target]
    if not usable:
        raise SnapshotError(
            f"CA LCFS: no assessment on or before {target}; the series "
            f"starts at {quotes[0][0]}"
        )
    as_of, price = usable[-1]
    age = (target - as_of).days
    if age > LCFS_STALE_DAYS:
        raise SnapshotError(
            f"CA LCFS: newest assessment ({as_of}) is {age} days old, over "
            f"the {LCFS_STALE_DAYS}-day limit; the source has stopped "
            f"updating and its last price no longer describes {target}"
        )
    return LcfsQuote(
        as_of=as_of, usd_per_mt=price, source_url=LCFS_MONITOR_XLS
    )


def fetch_lcfs_for_target_date(target: date, cache_dir: Path) -> LcfsQuote:
    """Download the assessment series and pick the quote for `target`."""
    return select_lcfs(load_lcfs_series(cache_dir), target)


def _read_lcfs_daily(path: Path) -> list[tuple[date, float]]:
    """Read the monitor's export as ascending (date, price) pairs.

    The export is a legacy single-sheet .xls holding an ISO date and a
    price per row. Its dates arrive as text rather than as Excel serial
    numbers, so they are parsed rather than converted.
    """
    # xlrd reports a damaged .xls through whichever layer notices first,
    # and only the innermost is an XLRDError: a body that is not a
    # workbook at all raises XLRDError, a corrupt OLE2 header raises
    # CompDocError, and one truncated mid-transfer -- the likeliest way
    # an HTTP fetch goes wrong -- raises IndexError from the sector
    # walk. A workbook with no sheets shows up on the access below.
    try:
        book = xlrd.open_workbook(str(path))
        sheet = book.sheet_by_index(0)
    except (
        xlrd.XLRDError,
        xlrd.compdoc.CompDocError,
        IndexError,
        OSError,
    ) as exc:
        raise SnapshotError(
            f"CA LCFS: export is not a readable workbook: {_describe(exc)}"
        ) from exc
    quotes: list[tuple[date, float]] = []
    for row in range(sheet.nrows):
        raw_day = sheet.cell_value(row, 0)
        raw_price = sheet.cell_value(row, 1) if sheet.ncols > 1 else None
        if not isinstance(raw_day, str) or not isinstance(
            raw_price, (int, float)
        ):
            continue
        try:
            day = date.fromisoformat(raw_day.strip())
        except ValueError:
            # The header row, and anything else not a date, is not a quote.
            continue
        quotes.append((day, float(raw_price)))
    if not quotes:
        raise SnapshotError("CA LCFS export: no dated rows parsed")
    quotes.sort()
    return quotes


# ---------------------------------------------------------------------------
# Quarterly auction tables (CARB CCA, WA CCA)
# ---------------------------------------------------------------------------


@dataclass(frozen=True)
class AuctionSettlement:
    # The date the auction was held, not the date its result was
    # published; `CCA_PUBLICATION_LAG_DAYS` covers the gap between them.
    effective: date
    price: float
    label: str


def latest_auction(
    table: list[tuple[date, float, str]],
    target: date,
    *,
    program: str,
) -> AuctionSettlement:
    """Return the newest settlement `target` could have known about.

    `table` must be in ascending date order: the scan keeps the last
    entry that qualifies rather than comparing dates, which is what
    makes "newest" true. `CCA_AUCTION_TABLES` holds the shipped tables
    and a test pins the ordering of each.

    Raises `SnapshotError` when the table has no usable entry, and when
    its newest one is stale enough to mean a quarterly update was
    missed -- a table nobody has topped up is indistinguishable from a
    market that has not moved, and only one of those is true.
    """
    cutoff = target - timedelta(days=CCA_PUBLICATION_LAG_DAYS)
    selected: tuple[date, float, str] | None = None
    for entry in table:
        if entry[0] <= cutoff:
            selected = entry
    if selected is None:
        raise SnapshotError(
            f"{program}: no auction settled and published as of {target}"
        )
    age = (target - selected[0]).days
    if age > CCA_STALE_DAYS:
        raise SnapshotError(
            f"{program}: newest auction ({selected[2]}) is {age} days old, "
            f"over the {CCA_STALE_DAYS}-day limit; a newer auction has "
            f"almost certainly settled and the table needs updating"
        )
    return AuctionSettlement(
        effective=selected[0], price=selected[1], label=selected[2]
    )


