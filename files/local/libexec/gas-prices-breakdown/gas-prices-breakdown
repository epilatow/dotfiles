def sanity_check_snapshot(snapshot: str, target: date) -> None:
    n_states = len(re.findall(r'^  \{ code:"', snapshot, re.MULTILINE))
    if n_states != 51:
        raise SnapshotError(f"sanity: expected 51 states, got {n_states}")
    m = SNAPSHOT_DATE_RE.search(snapshot)
    if not m or m.group(1) != target.isoformat():
        raise SnapshotError(
            "sanity: date in built block does not match target"
        )
    retail_values = [
        float(v) for v in re.findall(r"retail:([0-9]+\.[0-9]+),", snapshot)
    ]
    if len(retail_values) != 51:
        raise SnapshotError(
            f"sanity: expected 51 retail values, got {len(retail_values)}"
        )
    if not all(1.0 < v < 12.0 for v in retail_values):
        bad = [v for v in retail_values if not (1.0 < v < 12.0)]
        raise SnapshotError(
            f"sanity: retail values outside plausible range: {bad}"
        )
    if "adval:" in snapshot:
        raise SnapshotError(
            "sanity: built block still carries an ad-valorem field, "
            "which the row shape no longer has"
        )
    # An override larger than the rate it reduces is caught where both
    # are known, so what reaches here is a negative the published table
    # itself carried. The sign is matched so that fails as a bad rate
    # rather than dropping out of the count and reading as a lost row.
    totals = [
        float(v) for v in re.findall(r"fixed:\{ total:(-?[0-9.]+),", snapshot)
    ]
    if len(totals) != 51:
        raise SnapshotError(
            f"sanity: expected 51 state-tax totals, got {len(totals)}"
        )
    # A full tax suspension can legitimately leave a zero total.
    if not all(0.0 <= v < 1.0 for v in totals):
        bad = [v for v in totals if not (0.0 <= v < 1.0)]
        raise SnapshotError(
            f"sanity: state-tax totals outside plausible range: {bad}"
        )


