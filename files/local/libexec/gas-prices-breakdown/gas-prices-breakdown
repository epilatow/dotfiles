class _SourceHtml(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.parts: list[str] = []
        self.ignored: str | None = None

    def handle_starttag(
        self, tag: str, _attrs: list[tuple[str, str | None]]
    ) -> None:
        if tag in ("script", "style"):
            self.ignored = tag

    def handle_endtag(self, tag: str) -> None:
        if tag == self.ignored:
            self.ignored = None

    def handle_data(self, data: str) -> None:
        if self.ignored is None and data.strip():
            self.parts.append(data.strip())


def _source_html_text(value: str) -> str:
    parser = _SourceHtml()
    parser.feed(value)
    return "\n".join(parser.parts)


def _source_json_text(value: JsonValue) -> str:
    if isinstance(value, dict):
        return "\n".join(
            f"{key}\n{_source_json_text(item)}" for key, item in value.items()
        )
    if isinstance(value, list):
        return "\n".join(_source_json_text(item) for item in value)
    if isinstance(value, str):
        return _source_html_text(value) if "<" in value else value
    return "" if value is None else str(value)


def _source_text(raw: bytes, url: str) -> str:
    if raw.startswith(b"%PDF"):
        try:
            with pdfplumber.open(io.BytesIO(raw)) as pdf:
                text = "\n".join(
                    page.extract_text() or "" for page in pdf.pages
                )
        except (PdfminerException, ValueError) as exc:
            raise SnapshotError(
                f"primary PDF {url}: {_describe(exc)}"
            ) from exc
        if not text.strip():
            raise SnapshotError(
                f"primary PDF {url} has no extractable text; "
                "use a primary text notice or code-data endpoint"
            )
        return text
    if raw.startswith(b"PK"):
        try:
            with zipfile.ZipFile(io.BytesIO(raw)) as archive:
                if "xl/workbook.xml" not in archive.namelist():
                    raise SnapshotError(
                        f"primary source {url}: "
                        + "use a text, PDF or XLSX document"
                    )
            wb = openpyxl.load_workbook(io.BytesIO(raw), data_only=True)
        except (ValueError, OSError, zipfile.BadZipFile) as exc:
            raise SnapshotError(
                f"primary workbook {url}: {_describe(exc)}"
            ) from exc
        lines: list[str] = []
        for sheet in wb:
            lines.append(sheet.title)
            lines.extend(
                "\t".join(str(cell) for cell in row if cell is not None)
                for row in sheet.iter_rows(values_only=True)
            )
        return "\n".join(lines)
    decoded = raw.decode("utf-8", errors="replace")
    if decoded.lstrip().startswith(("{", "[")):
        try:
            value = TypeAdapter(JsonValue).validate_json(raw)
        except ValidationError as exc:
            raise SnapshotError(
                f"primary JSON {url}: {_describe(exc)}"
            ) from exc
        return _source_json_text(value)
    if "<html" in decoded.lower() or "<!doctype html" in decoded.lower():
        return _source_html_text(decoded)
    return decoded


@dataclass(frozen=True)
class SourceDocument:
    source_url: str
    text: str
    text_path: Path


def fetch_source_bytes(url: str) -> bytes:
    """Retrieve a bounded primary document with TLS verification."""
    if not (official_url(url) or url == AAA_URL):
        raise SnapshotError(f"not a primary source URL: {url}")
    if urllib.parse.urlsplit(url).hostname == "api.eia.gov":
        raise SnapshotError("the EIA API is owned by the price-feed utility")
    try:
        response = source_requests.get(url, impersonate="chrome", timeout=30)
    except CertificateVerifyError as certificate_error:
        # macOS's system client can build chains the bundled client cannot.
        # It still verifies TLS; a failure by both clients stops the run.
        curl = "/usr/bin/curl" if sys.platform == "darwin" else "curl"
        try:
            result = subprocess.run(
                [
                    curl,
                    "--fail",
                    "--location",
                    "--silent",
                    "--show-error",
                    "--user-agent",
                    USER_AGENT,
                    "--max-time",
                    "30",
                    "--",
                    url,
                ],
                capture_output=True,
                check=False,
                timeout=35,
            )
        except subprocess.TimeoutExpired as exc:
            raise SnapshotError(
                f"primary source {url}: curl timed out"
            ) from exc
        if result.returncode != 0:
            raise SnapshotError(
                f"primary source {url}: curl exited {result.returncode}"
            ) from certificate_error
        raw = result.stdout
    except RequestException as exc:
        raise SnapshotError(f"primary source {url}: {_describe(exc)}") from exc
    else:
        if response.status_code >= 400:
            raise SnapshotError(
                f"primary source {url}: HTTP {response.status_code}"
            )
        raw = response.content
    if len(raw) > 20_000_000:
        raise SnapshotError(
            f"primary source {url} is too large; use a chapter"
        )
    return raw


def fetch_source_document(url: str, cache_dir: Path) -> SourceDocument:
    """Retrieve primary text independently of an agent's assertions."""
    raw = fetch_source_bytes(url)
    text = _source_text(raw, url)
    if not text.strip():
        raise SnapshotError(f"primary source {url} has no readable text")
    directory = cache_dir / "research-sources"
    directory.mkdir(parents=True, exist_ok=True)
    path = directory / f"{hashlib.sha256(url.encode()).hexdigest()}.txt"
    write_with_canonical_mode(path, text)
    return SourceDocument(url, text, path)


def verify_research_evidence(data: ResearchData, cache_dir: Path) -> None:
    """Reject unreachable citations and excerpts absent from primary text."""
    evidence: list[tuple[str, SourceEvidence]] = [
        (review.state, item)
        for review in data.state_reviews
        for item in review.evidence
    ]
    urls = sorted({item.source_url for _, item in evidence})

    def retrieve(url: str) -> SourceDocument:
        return fetch_source_document(url, cache_dir)

    with ThreadPoolExecutor(max_workers=8) as pool:
        documents = dict(zip(urls, pool.map(retrieve, urls), strict=True))
    for state, item in evidence:
        text = " ".join(documents[item.source_url].text.split())
        excerpt = " ".join(item.excerpt.split())
        if excerpt not in text:
            raise SnapshotError(
                f"{state}: cited excerpt is absent from {item.source_url}; "
                "record an exact excerpt from research-source text"
            )


class SourceReceipt(TypedDict):
    source_url: str
    text_path: str
    text_sha256: str


def cmd_research_source(args: argparse.Namespace) -> int:
    cache = args.cache_dir or Path.home() / ".cache/gas-prices-breakdown"
    receipts: list[SourceReceipt] = []
    for url in args.urls:
        document = fetch_source_document(url, cache)
        receipts.append(
            {
                "source_url": document.source_url,
                "text_path": str(document.text_path),
                "text_sha256": hashlib.sha256(
                    document.text.encode()
                ).hexdigest(),
            }
        )
    print(json.dumps(receipts, indent=2))
    return 0


@contextlib.contextmanager
def researched_tables(data: ResearchData) -> Iterator[None]:
    """Use one run's research without changing the embedded seed tables."""
    global TAX_ADJUSTMENTS_CHECKED_FROM, TAX_ADJUSTMENTS_CHECKED_THROUGH
    global STATE_TAX_ADJUSTMENTS, IN_EXCISE_SUSPENSIONS, IN_GUT_SUSPENSIONS
    global IN_OIL_INSPECTION_FEE, IN_OIL_INSPECTION_SOURCE_URL
    global CARB_CCA_AUCTIONS, WA_CCA_AUCTIONS, DE_HSCA_RATES
    global RESEARCH_EIA_TAX_PERIOD
    global RESEARCH_EIA_BASELINE_SHA256
    global WA_PPT_RATE, RESEARCH_DATA
    global NY_SALES_TAX, NY_SALES_SOURCE_URL
    original = (
        NY_SALES_TAX,
        NY_SALES_SOURCE_URL,
        WA_PPT_RATE,
        RESEARCH_DATA,
        GROSS_RECEIPTS_SOURCE_URLS["WA"],
        RESEARCH_EIA_TAX_PERIOD,
        RESEARCH_EIA_BASELINE_SHA256,
        TAX_ADJUSTMENTS_CHECKED_FROM,
        TAX_ADJUSTMENTS_CHECKED_THROUGH,
        STATE_TAX_ADJUSTMENTS,
        IN_EXCISE_SUSPENSIONS,
        IN_GUT_SUSPENSIONS,
        IN_OIL_INSPECTION_FEE,
        IN_OIL_INSPECTION_SOURCE_URL,
        CARB_CCA_AUCTIONS,
        WA_CCA_AUCTIONS,
        DE_HSCA_RATES,
        GROSS_RECEIPTS_SOURCE_URLS["DE"],
    )
    RESEARCH_EIA_TAX_PERIOD = data.eia_tax_period
    NY_SALES_TAX = data.ny_sales_tax_usd_per_gal
    if data.ny_sales_tax_source_url:
        NY_SALES_SOURCE_URL = data.ny_sales_tax_source_url
    WA_PPT_RATE = data.wa_ppt_rate
    RESEARCH_DATA = data
    if data.wa_ppt_source_url:
        GROSS_RECEIPTS_SOURCE_URLS["WA"] = data.wa_ppt_source_url
    RESEARCH_EIA_BASELINE_SHA256 = data.eia_baseline_sha256
    TAX_ADJUSTMENTS_CHECKED_FROM = data.checked_from
    TAX_ADJUSTMENTS_CHECKED_THROUGH = data.checked_through
    STATE_TAX_ADJUSTMENTS = [
        TaxAdjustment(
            entry.state,
            entry.start,
            entry.end,
            entry.usd_per_gal,
            entry.authority,
            entry.source_url,
        )
        for entry in data.adjustments
    ]
    IN_EXCISE_SUSPENSIONS = [
        (entry.start, entry.end, entry.authority)
        for entry in data.in_excise_suspensions
    ]
    IN_GUT_SUSPENSIONS = [
        (entry.start, entry.end, entry.authority)
        for entry in data.in_gut_suspensions
    ]
    IN_OIL_INSPECTION_FEE = data.in_oil_inspection_fee
    IN_OIL_INSPECTION_SOURCE_URL = data.in_oil_inspection_source_url
    CARB_CCA_AUCTIONS = [
        (entry.day, entry.price, entry.label) for entry in data.carb_auctions
    ]
    WA_CCA_AUCTIONS = [
        (entry.day, entry.price, entry.label) for entry in data.wa_auctions
    ]
    CCA_AUCTION_TABLES["CARB_CCA_AUCTIONS"] = CARB_CCA_AUCTIONS
    CCA_AUCTION_TABLES["WA_CCA_AUCTIONS"] = WA_CCA_AUCTIONS
    DE_HSCA_RATES = [(entry.day, entry.rate) for entry in data.de_hsca_rates]
    GROSS_RECEIPTS_SOURCE_URLS["DE"] = data.de_hsca_source_url
    try:
        yield
    finally:
        (
            NY_SALES_TAX,
            NY_SALES_SOURCE_URL,
            WA_PPT_RATE,
            RESEARCH_DATA,
            GROSS_RECEIPTS_SOURCE_URLS["WA"],
            RESEARCH_EIA_TAX_PERIOD,
            RESEARCH_EIA_BASELINE_SHA256,
            TAX_ADJUSTMENTS_CHECKED_FROM,
            TAX_ADJUSTMENTS_CHECKED_THROUGH,
            STATE_TAX_ADJUSTMENTS,
            IN_EXCISE_SUSPENSIONS,
            IN_GUT_SUSPENSIONS,
            IN_OIL_INSPECTION_FEE,
            IN_OIL_INSPECTION_SOURCE_URL,
            CARB_CCA_AUCTIONS,
            WA_CCA_AUCTIONS,
            DE_HSCA_RATES,
            GROSS_RECEIPTS_SOURCE_URLS["DE"],
        ) = original
        CCA_AUCTION_TABLES["CARB_CCA_AUCTIONS"] = CARB_CCA_AUCTIONS
        CCA_AUCTION_TABLES["WA_CCA_AUCTIONS"] = WA_CCA_AUCTIONS


