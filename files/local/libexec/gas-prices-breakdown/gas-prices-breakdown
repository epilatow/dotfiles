class PrimaryReceipt(ResearchModel):
    source_url: str
    collected_for: date
    valid_through: date
    text: str
    links: tuple[tuple[str, str], ...] = ()


def save_checkpoint(path: Path, content: str) -> None:
    """Complete a checkpoint atomically so interruption cannot truncate it."""
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        mode="w",
        dir=path.parent,
        prefix=f".{path.name}.",
        delete=False,
    ) as stream:
        temporary = Path(stream.name)
        stream.write(content)
    temporary.chmod(0o644)
    temporary.replace(path)


def checkpoint_value[CacheValue](
    directory: Path,
    name: str,
    adapter: TypeAdapter[CacheValue],
    collect: Callable[[], CacheValue],
) -> CacheValue:
    path = directory / f"{name}.json"
    if path.exists():
        return adapter.validate_json(path.read_bytes())
    value = collect()
    save_checkpoint(path, adapter.dump_json(value, indent=2).decode() + "\n")
    return value


def collect_primary(
    url: str,
    target: date,
    cache: Path,
) -> PrimaryDocument:
    """Retain source text and links, respecting the source's cache scope."""
    key = hashlib.sha256(url.encode()).hexdigest()
    path = cache / "primary" / f"{key}.json"
    if path.exists():
        receipt = PrimaryReceipt.model_validate_json(path.read_bytes())
        if receipt.source_url != url:
            raise SnapshotError("primary receipt has a different source URL")
        if receipt.collected_for <= target <= receipt.valid_through:
            return PrimaryDocument(url, receipt.text, receipt.links)
    raw = fetch_source_bytes(url)
    text = _source_text(raw, url)
    if not text.strip():
        raise SnapshotError(f"primary source {url} has no readable text")
    links: tuple[tuple[str, str], ...] = ()
    if not raw.lstrip().startswith(b"%PDF"):
        parser = _PatLinks()
        parser.feed(raw.decode("utf-8", errors="replace"))
        links = tuple(
            (urllib.parse.urljoin(url, href), " ".join(label.split()))
            for href, label in parser.links
        )
    # Dated immutable documents can be reused; changing publication and
    # program pages are fetched for each new target. Source evidence remains
    # independently checked when an agent changes a priced input.
    immutable = "results_summary.pdf" not in url and bool(
        re.search(r"/\d{4}[-/]\d{2}/|/ic/\d{4}/", url)
    )
    valid_through = date.max if immutable else target
    receipt = PrimaryReceipt(
        source_url=url,
        collected_for=target,
        valid_through=valid_through,
        text=text,
        links=links,
    )
    save_checkpoint(path, receipt.model_dump_json(indent=2) + "\n")
    return PrimaryDocument(url, text, links)


def collect_snapshot_inputs(
    target: date,
    state: Path,
    cache: Path,
) -> CollectedSnapshot:
    """Checkpoint deterministic inputs before starting an agent."""
    directory = state / "input-parts" / target.isoformat()
    retail = checkpoint_value(
        directory,
        "retail",
        TypeAdapter(dict[str, float]),
        lambda: fetch_aaa_retail(target),
    )
    lcfs = checkpoint_value(
        directory,
        "lcfs",
        TypeAdapter(LcfsQuote),
        lambda: fetch_lcfs_for_target_date(target, cache),
    )
    orm = checkpoint_value(
        directory,
        "oregon-cfp",
        TypeAdapter(OrCfpMonth),
        lambda: fetch_or_cfp_for_target_date(target, cache),
    )
    period = checkpoint_value(
        directory,
        "eia-tax",
        TypeAdapter(TaxPeriod),
        lambda: fetch_tax_period_for_target_date(target, cache),
    )
    in_gut = collect_in_gut(
        target,
        lambda: checkpoint_value(
            directory,
            "indiana-use-tax",
            TypeAdapter(InGutRate),
            lambda: fetch_in_gut_for_target_date(target, cache),
        ),
    )
    pat = checkpoint_value(
        directory,
        "ohio-pat",
        TypeAdapter(PatQuote),
        lambda: fetch_oh_pat_for_target_date(target, cache),
    )
    spot: dict[str, SpotQuote] = {}
    for series in sorted(set(EIA_SPOT_SERIES.values())):
        quote = checkpoint_value(
            directory,
            f"spot-{series}",
            TypeAdapter(SpotQuote),
            partial(collect_spot_quote, series, target),
        )
        spot.update(
            {
                code: quote
                for code, name in EIA_SPOT_SERIES.items()
                if name == series
            }
        )
    research = research_template(target)
    previous_reviewed = TAX_ADJUSTMENTS_CHECKED_THROUGH
    previous = state / "last-final.json"
    if previous.exists():
        prior = CollectedSnapshot.model_validate_json(previous.read_bytes())
        previous_reviewed = prior.target
        research = prior.research.model_copy(deep=True)
        if tax_baseline_sha256(prior.period) != tax_baseline_sha256(period):
            research.blocking_issues = [
                (
                    "The EIA baseline changed; reconcile retained corrections "
                    "against the new amounts before publication."
                )
            ]
    research.checked_from = research.checked_through = target
    research.eia_tax_period = period.period
    research.eia_baseline_sha256 = tax_baseline_sha256(period)
    for review in research.state_reviews:
        if not review.sources:
            review.sources = [period.source_url]
        if not review.note:
            review.note = (
                "Published EIA baseline and retained sourced rules. "
                "No new independent jurisdiction audit is asserted."
            )
    pending = collect_maintained(
        research,
        target,
        period.per_state,
        lambda url: collect_primary(url, target, cache),
    )
    active = {
        entry.state
        for entry in research.adjustments
        if entry.start <= target <= entry.end
    }
    if any(
        window.start <= target <= window.end
        for window in (
            *research.in_excise_suspensions,
            *research.in_gut_suspensions,
        )
    ):
        active.add("IN")
    for review in research.state_reviews:
        review.outcome = (
            ReviewOutcome.OVERRIDE
            if review.state in active
            else ReviewOutcome.NO_OVERRIDE
        )
    inputs = CollectedSnapshot(
        target=target,
        collected_at=datetime.now(UTC),
        previous_reviewed_through=previous_reviewed,
        retail=retail,
        period=period,
        in_gut=in_gut,
        spot=spot,
        lcfs=lcfs,
        orm=orm,
        pat=pat,
        research=research,
        pending_items=pending,
    )
    validate_collected_inputs(inputs, target)
    return inputs


