def cmd_list_snapshots(args: argparse.Namespace) -> int:
    text = read_html(args.html)
    snapshots = parse_snapshots(text)
    print(f"{len(snapshots.blocks)} snapshots in {args.html}:")
    print(f"  {'date':10s}  {'states':>6s}  notes")
    print(f"  {'-' * 10}  {'-' * 6}  {'-' * 60}")
    for block in snapshots.blocks:
        iso_date, n_states, notes = block_summary(block)
        print(f"  {iso_date:10s}  {n_states:>6d}  {notes}")
    return 0


# ---------------------------------------------------------------------------
# Subcommand: add-snapshot
# ---------------------------------------------------------------------------


def cmd_add_snapshot(args: argparse.Namespace) -> int:
    target = args.target or most_recent_thursday()
    log.info("target snapshot date: %s (%s)", target, target.strftime("%a"))

    cache_dir = Path.home() / ".cache" / "gas-prices-breakdown"
    cache_dir.mkdir(parents=True, exist_ok=True)

    html_text = read_html(args.html)
    snapshots = parse_snapshots(html_text)
    log.info(
        "loaded %d existing snapshots from %s",
        len(snapshots.blocks),
        args.html,
    )

    if find_block_for_date(snapshots.blocks, target.isoformat()):
        log.info("snapshot for %s already present; nothing to do", target)
        return 0

    baseline = find_block_for_date(snapshots.blocks, args.baseline)
    if baseline is None:
        log.error("baseline snapshot %s not found", args.baseline)
        return 2

    # Everything local settles first -- the auction tables, the override
    # sweep's range, and the API key on disk -- so a run that cannot
    # produce a snapshot fails before spending a single fetch.
    cca = latest_auction(
        CARB_CCA_AUCTIONS, target, program="CARB_CCA_AUCTIONS"
    )
    wa = latest_auction(WA_CCA_AUCTIONS, target, program="WA_CCA_AUCTIONS")
    assert_adjustments_cover(target)
    key = load_eia_api_key()

    log.info("fetching AAA retail (live)...")
    retail = fetch_aaa_retail(target)
    log.info(
        "AAA: %d states; CA $%.2f, US-min $%.2f, US-max $%.2f",
        len(retail),
        retail["CA"],
        min(retail.values()),
        max(retail.values()),
    )

    log.info("fetching CA LCFS assessment...")
    lcfs = fetch_lcfs_for_target_date(target, cache_dir)
    log.info(
        "CA LCFS: %s $%.2f/MT (%s)",
        lcfs.as_of,
        lcfs.usd_per_mt,
        lcfs.source_url,
    )

    log.info("CARB CCA: %s, $%.2f/allowance", cca.label, cca.price)
    log.info("WA CCA: %s, $%.2f/allowance", wa.label, wa.price)

    log.info("fetching Oregon CFP...")
    orm = fetch_or_cfp_for_target_date(target, cache_dir)
    log.info(
        "OR CFP: %s VWAP $%.2f/credit", orm.year_month, orm.vwap_per_credit
    )

    log.info("fetching federal and state tax table...")
    period = fetch_tax_period_for_target_date(target, cache_dir)
    log.info(
        "EIA tax: %s edition, %d states, federal $%.4f",
        period.period,
        len(period.per_state),
        period.federal,
    )

    log.info("fetching Indiana gasoline use tax...")
    in_gut = fetch_in_gut_for_target_date(target, cache_dir)
    log.info("IN GUT: %s $%.4f/gal", in_gut.month_start, in_gut.usd_per_gal)

    log.info("fetching wholesale benchmarks...")
    # Two states share the New York Harbor series, so the fetch is keyed
    # by series rather than by state.
    series_months = {
        name: load_spot_series(name, key)
        for name in sorted(set(EIA_SPOT_SERIES.values()))
    }
    spot = {
        code: select_spot(series_months[name], target, name)
        for code, name in EIA_SPOT_SERIES.items()
    }
    for code, quote in sorted(spot.items()):
        log.info(
            "spot %s: %s $%.3f/gal", code, quote.year_month, quote.usd_per_gal
        )

    sources = SnapshotSources(
        period=period,
        in_gut=in_gut,
        spot=spot,
        lcfs=lcfs,
        cca=cca,
        wa=wa,
        orm=orm,
    )
    new_block = build_snapshot_object(target, baseline, retail, sources)
    sanity_check_snapshot(new_block, target)

    snapshots.blocks = insert_in_date_order(
        snapshots.blocks, new_block, target.isoformat()
    )
    new_html = render_snapshots(snapshots)

    if args.dry_run:
        log.info(
            "dry-run: would write %d bytes (was %d); not modifying file",
            len(new_html),
            len(html_text),
        )
        return 0

    backup = backup_html(args.html)
    log.info("backed up to %s", backup)
    write_with_canonical_mode(args.html, new_html)
    log.info(
        "wrote %d bytes (%d snapshots in array)",
        len(new_html),
        len(snapshots.blocks),
    )
    return 0


# ---------------------------------------------------------------------------
# Subcommand: remove-snapshot
# ---------------------------------------------------------------------------


def cmd_remove_snapshot(args: argparse.Namespace) -> int:
    text = read_html(args.html)
    snapshots = parse_snapshots(text)

    needle = f'date: "{args.snapshot_date}"'
    matching = [b for b in snapshots.blocks if needle in b]
    if not matching:
        log.error(
            "no snapshot found with date %s in %s",
            args.snapshot_date,
            args.html,
        )
        return 2
    if len(matching) > 1:
        log.warning(
            "found %d blocks matching date %s; removing all",
            len(matching),
            args.snapshot_date,
        )

    snapshots.blocks = [b for b in snapshots.blocks if needle not in b]
    new_html = render_snapshots(snapshots)

    if args.dry_run:
        log.info(
            "dry-run: would remove %d snapshot(s) for %s; %d would remain",
            len(matching),
            args.snapshot_date,
            len(snapshots.blocks),
        )
        return 0

    backup = backup_html(args.html)
    log.info("backed up to %s", backup)
    write_with_canonical_mode(args.html, new_html)
    log.info(
        "removed %d snapshot(s) for %s; %d remain",
        len(matching),
        args.snapshot_date,
        len(snapshots.blocks),
    )
    return 0


# ---------------------------------------------------------------------------
# Subcommand: extract-markdown
# ---------------------------------------------------------------------------


def cmd_extract_markdown(args: argparse.Namespace) -> int:
    text = read_html(args.html)
    match = re.search(r"const SPEC_MD = `([\s\S]*?)`;", text)
    if not match:
        raise SnapshotError(f"SPEC_MD not found in {args.html}")
    # Reverse JS template-literal escapes: any '\X' in the source represents
    # 'X' in the rendered string. Backticks and dollar-signs (the two
    # template-literal sentinels) commonly appear escaped; '\\' compresses
    # to '\' for any literal backslashes the spec text contains.
    md = re.sub(r"\\(.)", lambda m: m.group(1), match.group(1))
    if args.output is None:
        sys.stdout.write(md)
        if not md.endswith("\n"):
            sys.stdout.write("\n")
    else:
        write_with_canonical_mode(
            args.output,
            md if md.endswith("\n") else md + "\n",
        )
    return 0


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(
        dest="command", required=True, metavar="COMMAND"
    )

    p_list = sub.add_parser(
        "list-snapshots", help="list snapshots in the SNAPSHOTS array"
    )
    p_list.add_argument(
        "html", type=Path, help="path to gas-price-breakdown.html"
    )
    p_list.set_defaults(func=cmd_list_snapshots)

    p_add = sub.add_parser(
        "add-snapshot", help="fetch live data and append a new snapshot"
    )
    p_add.add_argument(
        "html", type=Path, help="path to gas-price-breakdown.html"
    )
    p_add.add_argument(
        "--target",
        type=date.fromisoformat,
        default=None,
        help="target snapshot date (default: most recent Thursday)",
    )
    p_add.add_argument(
        "--baseline",
        default=BASELINE_DATE,
        help="snapshot to inherit state-tax structure from",
    )
    p_add.add_argument(
        "--dry-run",
        action="store_true",
        help="fetch and build but do not modify the HTML",
    )
    p_add.set_defaults(func=cmd_add_snapshot)

    p_rm = sub.add_parser(
        "remove-snapshot", help="remove a snapshot by its date"
    )
    p_rm.add_argument(
        "html", type=Path, help="path to gas-price-breakdown.html"
    )
    p_rm.add_argument(
        "snapshot_date",
        metavar="SNAPSHOT_DATE",
        help="ISO date of the snapshot to remove (e.g. 2026-04-09)",
    )
    p_rm.add_argument(
        "--dry-run",
        action="store_true",
        help="report what would be removed without modifying the HTML",
    )
    p_rm.set_defaults(func=cmd_remove_snapshot)

    p_md = sub.add_parser(
        "extract-markdown",
        help="write the embedded SPEC_MD to stdout or a file",
    )
    p_md.add_argument(
        "html", type=Path, help="path to gas-price-breakdown.html"
    )
    p_md.add_argument(
        "--output",
        type=Path,
        default=None,
        help="write to this path (default: stdout)",
    )
    p_md.set_defaults(func=cmd_extract_markdown)

    args = parser.parse_args(argv)
    setup_logging()
    # `func` reaches argparse as an opaque default, so its type has to
    # be restated here for the subcommand contract to be checked.
    handler: Callable[[argparse.Namespace], int] = args.func
    try:
        return handler(args)
    except SnapshotError as exc:
        log.error("%s", exc)
        return 1


if __name__ == "__main__":
    sys.exit(main())
