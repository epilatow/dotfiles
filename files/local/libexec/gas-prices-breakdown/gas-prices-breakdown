@dataclass(frozen=True)
class OrCfpMonth:
    year_month: str  # "YYYY-MM"
    vwap_per_credit: float
    source_xlsx_url: str


def load_or_cfp_series(cache_dir: Path) -> dict[tuple[int, int], float]:
    """Download the DEQ workbook and return its monthly VWAPs.

    Kept separate from the per-date selection for the same reason as the
    LCFS series: fetching and choosing fail for unrelated reasons and
    read better apart.
    """
    xlsx_path = cache_dir / "oregon-cfp.xlsx"
    xlsx_path.write_bytes(_http_bytes(OR_CFP_URL))
    return _read_or_cfp_monthly(xlsx_path)


def select_or_cfp(
    monthly: dict[tuple[int, int], float], target: date
) -> OrCfpMonth:
    """Return the most recent OR CFP monthly VWAP available as of target.

    DEQ publishes month M's VWAP by the last day of month M+1; the script
    treats month M as available from the first day of month M+2.

    Raises `SnapshotError` when nothing is published yet for `target`,
    and when the newest month that is published sits further back than
    `OR_CFP_STALE_DAYS` -- a workbook DEQ has stopped updating keeps
    answering with its last month and looks no different from a market
    that has not moved."""
    candidates: list[tuple[tuple[int, int], float]] = []
    for (y, m), price in monthly.items():
        avail_year = y + (1 if m + 2 > 12 else 0)
        avail_month = ((m + 1) % 12) + 1
        avail = date(avail_year, avail_month, 1)
        if avail <= target:
            candidates.append(((y, m), price))
    if not candidates:
        raise SnapshotError("OR CFP: no monthly value available as of target")
    (y, m), price = max(candidates, key=lambda t: t[0])
    age = (target - date(y, m, 1)).days
    if age > OR_CFP_STALE_DAYS:
        raise SnapshotError(
            f"OR CFP: newest available month is {y}-{m:02d}, {age} days "
            f"before {target}, over the {OR_CFP_STALE_DAYS}-day limit; DEQ "
            f"has stopped publishing"
        )
    return OrCfpMonth(
        year_month=f"{y}-{m:02d}",
        vwap_per_credit=price,
        source_xlsx_url=OR_CFP_URL,
    )


def fetch_or_cfp_for_target_date(target: date, cache_dir: Path) -> OrCfpMonth:
    """Download the DEQ workbook and pick the month for `target`."""
    return select_or_cfp(load_or_cfp_series(cache_dir), target)


def _read_or_cfp_monthly(path: Path) -> dict[tuple[int, int], float]:
    wb = _load_workbook(path, "OR CFP")
    sheet_name = "Monthly Credit Transfer Summary"
    if sheet_name not in wb.sheetnames:
        raise SnapshotError(f"OR CFP xlsx missing sheet {sheet_name!r}")
    sh = wb[sheet_name]
    out: dict[tuple[int, int], float] = {}
    year: int | None = None
    for row in sh.iter_rows(min_row=2, values_only=True):
        a, b, _, _, e = row[:5]
        if isinstance(a, int):
            year = a
        if not isinstance(b, str) or b not in MONTHS:
            continue
        if year is None:
            continue
        if not isinstance(e, (int, float)) or e <= 0:
            continue
        out[(year, MONTHS[b])] = float(e)
    if not out:
        raise SnapshotError("OR CFP xlsx: no monthly rows parsed")
    return out


# ---------------------------------------------------------------------------
# HTML parse / splice
# ---------------------------------------------------------------------------


@dataclass
class Snapshots:
    preamble: str
    blocks: list[str]
    postamble: str


SNAPSHOT_TRAILER_COMMENT = (
    "\n// To add another monthly snapshot, append another object here, e.g.:"
    '\n// , { date: "YYYY-MM-DD", federalExcise: 0.184, '
    'federalSource: "...", ... data: [ ... ] }\n'
)


def parse_snapshots(html_text: str) -> Snapshots:
    array_pattern = re.compile(
        r"const SNAPSHOTS = \[\n([\s\S]*?)\n?\];\n",
        re.MULTILINE,
    )
    matches = list(array_pattern.finditer(html_text))
    if len(matches) != 1:
        raise SnapshotError(
            f"expected exactly one SNAPSHOTS array, found {len(matches)}"
        )
    array_body = matches[0].group(1)
    blocks = _extract_objects(array_body)
    return Snapshots(
        preamble=html_text[: matches[0].start()],
        blocks=blocks,
        postamble=html_text[matches[0].end() :],
    )


def _extract_objects(text: str) -> list[str]:
    """Return the top-level {...} objects in text, ignoring those inside
    string literals or // line comments."""
    blocks: list[str] = []
    i = 0
    depth = 0
    start = -1
    in_string = False
    while i < len(text):
        c = text[i]
        if in_string:
            if c == "\\":
                i += 2
                continue
            if c == '"':
                in_string = False
            i += 1
            continue
        if c == '"':
            in_string = True
            i += 1
            continue
        if c == "/" and i + 1 < len(text) and text[i + 1] == "/":
            nl = text.find("\n", i)
            i = (nl + 1) if nl >= 0 else len(text)
            continue
        if c == "{":
            if depth == 0:
                start = i
            depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0 and start >= 0:
                blocks.append(text[start : i + 1])
                start = -1
        i += 1
    return blocks


def render_snapshots(snapshots: Snapshots) -> str:
    body = ",\n".join(snapshots.blocks)
    return (
        snapshots.preamble
        + "const SNAPSHOTS = [\n"
        + body
        + SNAPSHOT_TRAILER_COMMENT
        + "];\n"
        + snapshots.postamble
    )


def find_block_for_date(blocks: list[str], iso_date: str) -> str | None:
    needle = f'date: "{iso_date}"'
    for b in blocks:
        if needle in b:
            return b
    return None


def insert_in_date_order(
    blocks: list[str], new_block: str, new_iso: str
) -> list[str]:
    out: list[str] = []
    inserted = False
    for b in blocks:
        m = SNAPSHOT_DATE_RE.search(b)
        if not m:
            continue
        existing = m.group(1)
        if not inserted and new_iso > existing:
            out.append(new_block)
            inserted = True
        out.append(b)
    if not inserted:
        out.append(new_block)
    return out


def extract_data_block(snapshot_block: str) -> str:
    m = re.search(
        r"  data: \[\n([\s\S]*?)\n  \]\n\}\s*\Z",
        snapshot_block,
    )
    if not m:
        raise SnapshotError("could not extract data array from snapshot block")
    return m.group(1) + "\n"


# ---------------------------------------------------------------------------
# Snapshot construction
# ---------------------------------------------------------------------------


def split_state_blocks(text: str) -> list[tuple[str, str]]:
    starts = [
        m.start() for m in re.finditer(r'^  \{ code:"', text, re.MULTILINE)
    ]
    if not starts:
        raise SnapshotError("no per-state blocks found")
    out: list[tuple[str, str]] = []
    for i, s in enumerate(starts):
        end = starts[i + 1] if i + 1 < len(starts) else len(text)
        chunk = text[s:end]
        m = re.match(r'  \{ code:"([A-Z]{2})"', chunk)
        if not m:
            raise SnapshotError(f"bad per-state block prefix: {chunk[:60]!r}")
        out.append((m.group(1), chunk))
    return out


def replace_retail(chunk: str, retail: float) -> str:
    return re.sub(
        r"retail:\s*[0-9.]+,",
        f"retail:{retail:.3f},",
        chunk,
        count=1,
    )


def _span_of(chunk: str, field: str) -> tuple[int, int]:
    """Locate one brace-delimited field inside a state block."""
    i = chunk.index(f"{field}:{{")
    depth = 0
    j = i
    while j < len(chunk):
        c = chunk[j]
        if c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0:
                j += 1
                break
        j += 1
    return i, j


def swap_nontax(chunk: str, replacement: str) -> str:
    i, j = _span_of(chunk, "nontax")
    return chunk[:i] + replacement + chunk[j:]


def swap_fixed(chunk: str, replacement: str) -> str:
    i, j = _span_of(chunk, "fixed")
    return chunk[:i] + replacement + chunk[j:]


def drop_adval(chunk: str) -> str:
    """Remove the ad-valorem field, which the row no longer carries.

    State tax reaches the page as one per-gallon figure, so the
    percentage that used to sit beside it has nothing left to describe.
    The trailing comma and the blank line it leaves go with it.
    """
    if "adval:{" not in chunk:
        return chunk
    i, j = _span_of(chunk, "adval")
    # The field occupied its own line, so the comma that ended it, the
    # newline after it and the indentation that led into it all go too.
    tail = chunk[j:].removeprefix(",").removeprefix("\n")
    return chunk[:i].rstrip(" ") + tail


PASSTHROUGH_NOTES_MARKER = "Non-tax pass-throughs: "
STATE_TAX_NOTES_MARKER = "State tax: "


def _and_list(items: Sequence[str]) -> str:
    """Join for prose: 'A', 'A and B', 'A, B and C'."""
    if len(items) < 2:
        return "".join(items)
    return f"{', '.join(items[:-1])} and {items[-1]}"


def state_tax_notes(period: TaxPeriod, in_gut: InGutRate, day: date) -> str:
    """Summarise where a snapshot's state-tax column came from.

    The override list is derived for `day` rather than written out, so
    the sentence cannot claim a suspension that had lapsed or miss one
    that had started.
    """
    overridden = sorted(
        {e.state for e in STATE_TAX_ADJUSTMENTS if e.start <= day <= e.end}
    )
    override_clause = (
        f"{_and_list(overridden)} carrying a suspension or reduction the "
        f"table does not reflect; "
        if overridden
        else ""
    )
    return (
        f"{STATE_TAX_NOTES_MARKER}EIA federal and state motor fuel tax "
        f"table, {period.period} edition; IN composed from its excise, "
        f"oil inspection fee and {in_gut.month_start:%b %Y} gasoline use "
        f"tax, with its own suspensions applied; "
        f"{override_clause}"
        f"{_and_list(GROSS_RECEIPTS_STATES)} adding the gross-receipts "
        f"taxes the table excludes. "
    )


def passthrough_notes(
    lcfs: LcfsQuote,
    cca: AuctionSettlement,
    wa: AuctionSettlement,
    orm: OrCfpMonth,
) -> str:
    """Summarise which priced programs a snapshot's pass-throughs came from.

    Takes the same four values the CA, OR and WA state blocks are built
    from, so a snapshot cannot end up describing one vintage in its
    notes and another in its numbers.
    """
    return (
        f"{PASSTHROUGH_NOTES_MARKER}"
        f"CA LCFS {lcfs.as_of.isoformat()} "
        f"(${lcfs.usd_per_mt:.2f}/MT, Argus via Neste monitor); "
        f"CA cap-and-invest {cca.label}; "
        f"WA CCA {wa.label}; OR CFP {orm.year_month} "
        f"(${orm.vwap_per_credit:.2f}/credit). IN gasoline use tax handled "
        "per-date."
    )


def build_ca_nontax(d: date, lcfs: LcfsQuote, cca: AuctionSettlement) -> str:
    lcfs_pass = round(lcfs.usd_per_mt * LCFS_FACTOR, 4)
    cca_pass = round(cca.price * CCA_FACTOR_MT_PER_GAL, 4)
    total = round(lcfs_pass + cca_pass, 4)
    return (
        f"nontax:{{ total:{total:.4f}, parts:[\n"
        f'      {{n:"LCFS pass-through", v:{lcfs_pass:.4f}, '
        f'src:"{_js_string(LCFS_MONITOR_URL)}", '
        f'note:"Credit ${lcfs.usd_per_mt:.2f}/MT ({lcfs.as_of.isoformat()}) '
        f"{TIMES} {LCFS_FACTOR:.6f}. Daily Argus assessment, via Neste's "
        f"LCFS monitor. An assessed market price, not CARB's "
        f"volume-weighted average of completed transfers, so it is close "
        f"but not exact. Used because CARB stopped publishing its weekly "
        f"credit transfer reports after the week of "
        f'{LCFS_LAST_CARB_WEEK.isoformat()}."}},\n'
        f'      {{n:"Cap-and-Invest pass-through", v:{cca_pass:.4f}, '
        f'src:"{_js_string(CARB_CCA_PROGRAM_URL)}", '
        f'note:"${cca.price:.2f}/allowance ({_js_string(cca.label)}) '
        f"{TIMES} "
        f'{CCA_FACTOR_MT_PER_GAL} MT/gal"}}'
        f'], asOf:"{d.isoformat()}"}}'
    )


def build_or_nontax(month: OrCfpMonth) -> str:
    pass_through = round(month.vwap_per_credit * OR_FACTOR, 4)
    return (
        f"nontax:{{ total:{pass_through:.4f}, parts:[\n"
        f'      {{n:"Clean Fuels Program credit pass-through", '
        f"v:{pass_through:.4f}, "
        f'src:"{_js_string(OR_CFP_PROGRAM_URL)}", '
        f'note:"OR CFP {_js_string(month.year_month)} VWAP '
        f"${month.vwap_per_credit:.2f}/credit {TIMES} {OR_FACTOR:.6f} "
        f'(factor anchored to existing snapshot Jan 2025)"}}'
        f'], asOf:"{_js_string(month.year_month)}"}}'
    )


def build_wa_nontax(wa: AuctionSettlement) -> str:
    pass_through = round(wa.price * WA_FACTOR, 4)
    return (
        f"nontax:{{ total:{pass_through:.4f}, parts:[\n"
        f'      {{n:"Climate Commitment Act allowance pass-through", '
        f"v:{pass_through:.4f}, "
        f'src:"{_js_string(WA_CCA_PROGRAM_URL)}", '
        f'note:"${wa.price:.2f}/allowance ({_js_string(wa.label)}) '
        f"{TIMES} "
        f'{WA_FACTOR:.5f} (factor anchored to existing snapshot Mar 2026)"}}'
        f'], asOf:"{wa.effective.isoformat()}"}}'
    )


@dataclass(frozen=True)
class TaxPart:
    """One named component of a state's tax, as the page shows it."""

    name: str
    usd_per_gal: float
    src: str
    note: str


@dataclass(frozen=True)
class StateTax:
    """One state's per-gallon tax for a snapshot, with its provenance."""

    total: float
    parts: tuple[TaxPart, ...]
    as_of: str


def compose_state_tax(
    code: str,
    day: date,
    period: TaxPeriod,
    retail: float,
    in_gut: InGutRate,
    spot: dict[str, SpotQuote],
) -> StateTax:
    """Resolve what one state charges per gallon on `day`.

    Most states are the published table's own figure, adjusted for any
    override in force. Indiana is built from its parts instead, because
    its use tax is reset monthly and its two taxes were suspended from
    different dates. The four states whose gross-receipts taxes the
    table excludes get them added back.
    """
    assert_adjustments_cover(day)
    if code == "IN":
        indiana = resolve_indiana_tax(day, _excise_of(period, "IN"), in_gut)
        parts = [
            TaxPart(
                "Gasoline excise", indiana.excise, IN_EXCISE_SOURCE_URL, ""
            ),
            TaxPart(
                "Oil inspection fee",
                indiana.inspection_fee,
                IN_OIL_INSPECTION_SOURCE_URL,
                "",
            ),
            TaxPart(
                f"Gasoline use tax ({in_gut.month_start:%b %Y})",
                indiana.gut,
                in_gut.source_url,
                "",
            ),
        ]
        note = "; ".join(indiana.suspended)
        if note:
            parts.append(
                TaxPart("Suspended", 0.0, IN_SUSPENSION_NOTICE_URL, note)
            )
        return StateTax(
            total=indiana.total,
            parts=tuple(parts),
            as_of=in_gut.month_start.isoformat(),
        )
    base = period.per_state[code]
    parts = [
        TaxPart(
            "State taxes and fees",
            base,
            period.source_url,
            (
                "Excise plus the sales, inspection and environmental "
                "charges the published table groups with it"
            ),
        )
    ]
    total = base
    override = adjustment_on(code, day)
    if override is not None:
        total = round(total + override.usd_per_gal, 4)
        # Caught here rather than at the whole-snapshot range check,
        # which sees a bare list of numbers; this knows whose rate it
        # is and what claims to reduce it.
        if total < 0:
            raise SnapshotError(
                f"{code} on {day}: {override.authority} reduces the rate "
                f"by ${-override.usd_per_gal:.4f}, more than the "
                f"${base:.4f} the published table carries; one of the two "
                f"is wrong"
            )
        parts.append(
            TaxPart(
                "Suspension or reduction",
                override.usd_per_gal,
                override.source_url,
                f"{override.authority}, in force {override.start} to "
                f"{override.end}; the published table carries the rate "
                f"this overrides",
            )
        )
    if code in GROSS_RECEIPTS_STATES:
        extra = resolve_gross_receipts(code, day, retail, spot.get(code))
        total = round(total + extra.usd_per_gal, 4)
        parts.append(
            TaxPart(
                extra.label,
                extra.usd_per_gal,
                GROSS_RECEIPTS_SOURCE_URLS[code],
                extra.basis if extra.exact else f"Estimated. {extra.basis}",
            )
        )
    return StateTax(
        total=total,
        parts=tuple(parts),
        as_of=period.period.isoformat(),
    )


def _excise_of(period: TaxPeriod, code: str) -> float:
    """Read one state's excise, naming the gap when the sheet left it."""
    try:
        return period.excise[code]
    except KeyError:
        raise SnapshotError(
            f"EIA tax: the {period.period} sheet leaves {code}'s excise "
            f"blank, so its tax cannot be composed from parts"
        ) from None


def _js_string(text: str) -> str:
    """Escape text for a double-quoted JavaScript string literal.

    The page is JavaScript source inside an HTML script element, so a
    hand-entered value can break it two ways: a quote, backslash or
    control character ends the string literal, and `</script>` ends the
    element regardless of what the parser thinks it is inside. Either
    costs the whole snapshot array, not just its own row.

    `json.dumps` covers the first for every control character rather
    than the two that happen to come to mind; its outer quotes are
    dropped because the caller supplies them, and `ensure_ascii` is off
    so the page keeps the characters it was written with instead of
    growing escapes the rest of it does not use.

    That leaves three JSON does not handle here. U+2028 and U+2029 are
    line terminators everywhere in JavaScript except inside a string
    literal, which ES2019 carved out; escaping them costs nothing and
    keeps the value safe if it is ever emitted anywhere but here. `<`
    is escaped outright rather than just `</`, because a value carrying
    `<!--` and a later `<script` can send the HTML tokenizer somewhere
    the page's own closing tag no longer closes the element.

    They are matched by code point rather than written as characters:
    two of the three are invisible, so a literal would read as a stray
    space that the next person to tidy this file would delete.
    """
    escaped = json.dumps(text, ensure_ascii=False)[1:-1]
    for point in (0x3C, 0x2028, 0x2029):
        escaped = escaped.replace(chr(point), f"\\u{point:04x}")
    return escaped


def build_fixed(tax: StateTax) -> str:
    """Render one state's tax as the page's `fixed` field."""
    rendered = ",\n".join(
        f'      {{n:"{_js_string(part.name)}", '
        f'v:{part.usd_per_gal:.4f}, src:"{_js_string(part.src)}"'
        + (f', note:"{_js_string(part.note)}"' if part.note else "")
        + "}"
        for part in tax.parts
    )
    return (
        f"fixed:{{ total:{tax.total:.4f}, parts:[\n"
        f'{rendered}], asOf:"{_js_string(tax.as_of)}"}}'
    )


@dataclass(frozen=True)
class SnapshotSources:
    """Everything one snapshot is built from, already dated to it."""

    period: TaxPeriod
    in_gut: InGutRate
    spot: dict[str, SpotQuote]
    lcfs: LcfsQuote
    cca: AuctionSettlement
    wa: AuctionSettlement
    orm: OrCfpMonth


def build_data_block(
    baseline_data: str,
    target: date,
    retail: dict[str, float],
    sources: SnapshotSources,
) -> str:
    blocks = split_state_blocks(baseline_data)
    out: list[str] = []
    for code, chunk in blocks:
        if code not in retail:
            raise SnapshotError(f"missing retail price for {code}")
        chunk = replace_retail(chunk, retail[code])
        tax = compose_state_tax(
            code,
            target,
            sources.period,
            retail[code],
            sources.in_gut,
            sources.spot,
        )
        chunk = swap_fixed(chunk, build_fixed(tax))
        chunk = drop_adval(chunk)
        if code == "CA":
            chunk = swap_nontax(
                chunk, build_ca_nontax(target, sources.lcfs, sources.cca)
            )
        elif code == "OR":
            chunk = swap_nontax(chunk, build_or_nontax(sources.orm))
        elif code == "WA":
            chunk = swap_nontax(chunk, build_wa_nontax(sources.wa))
        out.append(chunk)
    return "".join(out)


def build_snapshot_object(
    target: date,
    baseline_block: str,
    retail: dict[str, float],
    sources: SnapshotSources,
) -> str:
    baseline_data = extract_data_block(baseline_block)
    body = build_data_block(baseline_data, target, retail, sources)
    notes = (
        "Auto-generated weekly snapshot. Retail (col 2) from live AAA "
        f"state-averages page on {target.isoformat()}. "
        + state_tax_notes(sources.period, sources.in_gut, target)
        + passthrough_notes(sources.lcfs, sources.cca, sources.wa, sources.orm)
    )
    return (
        "{\n"
        f'  date: "{target.isoformat()}",\n'
        f"  federalExcise: {sources.period.federal:.4f},\n"
        f'  federalSource: "{_js_string(sources.period.source_url)}",\n'
        f'  federalVintage: "Federal excise and LUST fee as published for '
        f'the {sources.period.period} edition of the EIA table.",\n'
        f'  aaaUrl: "{_js_string(AAA_URL)}",\n'
        f'  notes: "{_js_string(notes)}",\n'
        "  data: [\n"
        f"{body}"
        "  ]\n"
        "}"
    )


# ---------------------------------------------------------------------------
# Sanity checks
# ---------------------------------------------------------------------------


def sanity_check_snapshot(snapshot: str, target: date) -> None:
    n_states = len(re.findall(r'^  \{ code:"', snapshot, re.MULTILINE))
    if n_states != 51:
        raise SnapshotError(f"sanity: expected 51 states, got {n_states}")
    m = SNAPSHOT_DATE_RE.search(snapshot)
    if not m or m.group(1) != target.isoformat():
        raise SnapshotError(
            "sanity: date in built block does not match target"
        )
    retail_values = [
        float(v) for v in re.findall(r"retail:([0-9]+\.[0-9]+),", snapshot)
    ]
    if len(retail_values) != 51:
        raise SnapshotError(
            f"sanity: expected 51 retail values, got {len(retail_values)}"
        )
    if not all(1.0 < v < 12.0 for v in retail_values):
        bad = [v for v in retail_values if not (1.0 < v < 12.0)]
        raise SnapshotError(
            f"sanity: retail values outside plausible range: {bad}"
        )
    if "adval:" in snapshot:
        raise SnapshotError(
            "sanity: built block still carries an ad-valorem field, "
            "which the row shape no longer has"
        )
    # An override larger than the rate it reduces is caught where both
    # are known, so what reaches here is a negative the published table
    # itself carried. The sign is matched so that fails as a bad rate
    # rather than dropping out of the count and reading as a lost row.
    totals = [
        float(v) for v in re.findall(r"fixed:\{ total:(-?[0-9.]+),", snapshot)
    ]
    if len(totals) != 51:
        raise SnapshotError(
            f"sanity: expected 51 state-tax totals, got {len(totals)}"
        )
    # Every state charges something per gallon, and no state is close to
    # a dollar; either bound means a source was misread.
    if not all(0.0 < v < 1.0 for v in totals):
        bad = [v for v in totals if not (0.0 < v < 1.0)]
        raise SnapshotError(
            f"sanity: state-tax totals outside plausible range: {bad}"
        )


