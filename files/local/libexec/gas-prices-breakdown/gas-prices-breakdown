def split_state_blocks(text: str) -> list[tuple[str, str]]:
    starts = [
        m.start() for m in re.finditer(r'^  \{ code:"', text, re.MULTILINE)
    ]
    if not starts:
        raise SnapshotError("no per-state blocks found")
    out: list[tuple[str, str]] = []
    for i, s in enumerate(starts):
        end = starts[i + 1] if i + 1 < len(starts) else len(text)
        chunk = text[s:end]
        m = re.match(r'  \{ code:"([A-Z]{2})"', chunk)
        if not m:
            raise SnapshotError(f"bad per-state block prefix: {chunk[:60]!r}")
        out.append((m.group(1), chunk))
    return out


def replace_retail(chunk: str, retail: float) -> str:
    return re.sub(
        r"retail:\s*[0-9.]+,",
        f"retail:{retail:.3f},",
        chunk,
        count=1,
    )


def _span_of(chunk: str, field: str) -> tuple[int, int]:
    """Locate one brace-delimited field inside a state block."""
    i = chunk.index(f"{field}:{{")
    depth = 0
    j = i
    while j < len(chunk):
        c = chunk[j]
        if c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0:
                j += 1
                break
        j += 1
    return i, j


def swap_nontax(chunk: str, replacement: str) -> str:
    i, j = _span_of(chunk, "nontax")
    return chunk[:i] + replacement + chunk[j:]


def swap_fixed(chunk: str, replacement: str) -> str:
    i, j = _span_of(chunk, "fixed")
    return chunk[:i] + replacement + chunk[j:]


def drop_adval(chunk: str) -> str:
    """Remove the ad-valorem field, which the row no longer carries.

    State tax reaches the page as one per-gallon figure, so the
    percentage that used to sit beside it has nothing left to describe.
    The trailing comma and the blank line it leaves go with it.
    """
    if "adval:{" not in chunk:
        return chunk
    i, j = _span_of(chunk, "adval")
    # The field occupied its own line, so the comma that ended it, the
    # newline after it and the indentation that led into it all go too.
    tail = chunk[j:].removeprefix(",").removeprefix("\n")
    return chunk[:i].rstrip(" ") + tail


PASSTHROUGH_NOTES_MARKER = "Non-tax pass-throughs: "
STATE_TAX_NOTES_MARKER = "State tax: "


def _and_list(items: Sequence[str]) -> str:
    """Join for prose: 'A', 'A and B', 'A, B and C'."""
    if len(items) < 2:
        return "".join(items)
    return f"{', '.join(items[:-1])} and {items[-1]}"


def state_tax_notes(
    period: TaxPeriod, in_gut: InGutRate | None, day: date
) -> str:
    """Summarise where a snapshot's state-tax column came from.

    The clauses that vary by date -- the override list, Indiana's own
    suspension clause and how its use tax was priced -- are derived for
    `day` rather than written out, so none can report a suspension that
    had lapsed or miss one that had started. Indiana's two taxes are
    suspended on their own dates, so a backfill into early 2026 falls
    on neither and a date between the two windows falls on one.
    """
    overridden = sorted(
        {e.state for e in STATE_TAX_ADJUSTMENTS if e.start <= day <= e.end}
    )
    override_clause = (
        f"{_and_list(overridden)} carrying tax or fee corrections the "
        f"table does not reflect; "
        if overridden
        else ""
    )
    in_suspended = sum(
        _suspended_on(windows, day) is not None
        for windows in (IN_EXCISE_SUSPENSIONS, IN_GUT_SUSPENSIONS)
    )
    suspension_label = "suspensions" if in_suspended > 1 else "suspension"
    in_clause = (
        f", with its own {suspension_label} applied" if in_suspended else ""
    )
    basis = use_tax_basis(in_gut, day)
    if basis is UseTaxBasis.EXCLUDED:
        in_parts = (
            "excise and oil inspection fee, excluding its gasoline use tax "
            "for want of a usable current rate"
        )
    elif in_gut is None or basis is UseTaxBasis.SUSPENDED:
        in_parts = "excise, oil inspection fee and gasoline use tax"
    else:
        estimate = (
            " (estimated from the latest published month)"
            if basis is UseTaxBasis.ESTIMATED
            else ""
        )
        in_parts = (
            f"excise, oil inspection fee and {in_gut.month_start:%b %Y} "
            f"gasoline use tax{estimate}"
        )
    return (
        f"{STATE_TAX_NOTES_MARKER}EIA federal and state motor fuel tax "
        f"table, {period.period} edition; IN composed from its "
        f"{in_parts}{in_clause}; "
        "NY adding the statewide motor-fuel sales tax excluded from EIA; "
        f"{override_clause}"
        f"{_and_list(GROSS_RECEIPTS_STATES)} adding the value-based "
        f"taxes the table excludes. "
    )


def passthrough_notes(
    lcfs: LcfsQuote,
    cca: AuctionSettlement,
    wa: AuctionSettlement,
    orm: OrCfpMonth,
) -> str:
    """Summarise which priced programs a snapshot's pass-throughs came from.

    Takes the same four values the CA, OR and WA state blocks are built
    from, so a snapshot cannot end up describing one vintage in its
    notes and another in its numbers.
    """
    return (
        f"{PASSTHROUGH_NOTES_MARKER}"
        f"CA LCFS {lcfs.as_of.isoformat()} "
        f"(${lcfs.usd_per_mt:.2f}/MT, Argus via Neste monitor); "
        f"CA cap-and-invest {cca.label}; "
        f"WA CCA {wa.label}; OR CFP {orm.year_month} "
        f"(${orm.vwap_per_credit:.2f}/credit). IN gasoline use tax handled "
        "per-date."
    )


def build_ca_nontax(d: date, lcfs: LcfsQuote, cca: AuctionSettlement) -> str:
    lcfs_pass = round(lcfs.usd_per_mt * LCFS_FACTOR, 4)
    cca_pass = round(cca.price * CCA_FACTOR_MT_PER_GAL, 4)
    total = round(lcfs_pass + cca_pass, 4)
    return (
        f"nontax:{{ total:{total:.4f}, parts:[\n"
        f'      {{n:"LCFS pass-through", v:{lcfs_pass:.4f}, '
        f'src:"{_js_string(LCFS_MONITOR_URL)}", '
        f'note:"Credit ${lcfs.usd_per_mt:.2f}/MT ({lcfs.as_of.isoformat()}) '
        f"{TIMES} {LCFS_FACTOR:.6f}. Daily Argus assessment, via Neste's "
        f"LCFS monitor. An assessed market price, not CARB's "
        "volume-weighted average of completed transfers. The per-gallon "
        'pass-through is an estimate, not an observed retail charge."},\n'
        f'      {{n:"Cap-and-Invest pass-through", v:{cca_pass:.4f}, '
        f'src:"{_js_string(CARB_CCA_PROGRAM_URL)}", '
        f'note:"${cca.price:.2f}/allowance ({_js_string(cca.label)}) '
        f"{TIMES} "
        f'{CCA_FACTOR_MT_PER_GAL} MT/gal"}}'
        f'], asOf:"{d.isoformat()}"}}'
    )


def build_or_nontax(month: OrCfpMonth) -> str:
    pass_through = round(month.vwap_per_credit * OR_FACTOR, 4)
    return (
        f"nontax:{{ total:{pass_through:.4f}, parts:[\n"
        f'      {{n:"Clean Fuels Program credit pass-through", '
        f"v:{pass_through:.4f}, "
        f'src:"{_js_string(OR_CFP_PROGRAM_URL)}", '
        f'note:"OR CFP {_js_string(month.year_month)} VWAP '
        f"${month.vwap_per_credit:.2f}/credit {TIMES} {OR_FACTOR:.6f} "
        f'(factor anchored to existing snapshot Jan 2025)"}}'
        f'], asOf:"{_js_string(month.year_month)}"}}'
    )


def build_wa_nontax(wa: AuctionSettlement) -> str:
    pass_through = round(wa.price * WA_FACTOR, 4)
    return (
        f"nontax:{{ total:{pass_through:.4f}, parts:[\n"
        f'      {{n:"Climate Commitment Act allowance pass-through", '
        f"v:{pass_through:.4f}, "
        f'src:"{_js_string(WA_CCA_PROGRAM_URL)}", '
        f'note:"${wa.price:.2f}/allowance ({_js_string(wa.label)}) '
        f"{TIMES} "
        f'{WA_FACTOR:.5f} (factor anchored to existing snapshot Mar 2026)"}}'
        f'], asOf:"{wa.effective.isoformat()}"}}'
    )


@dataclass(frozen=True)
class TaxPart:
    """One named component of a state's tax, as the page shows it."""

    name: str
    usd_per_gal: float
    src: str
    note: str


@dataclass(frozen=True)
class StateTax:
    """One state's per-gallon tax for a snapshot, with its provenance."""

    total: float
    parts: tuple[TaxPart, ...]
    as_of: str


def unquantified_fee_note(state: str, extra: Sequence[str] = ()) -> str:
    """Disclose exclusions without pricing them as zero.

    `extra` carries exclusions decided for this snapshot rather than
    recorded for the state.
    """
    notes = (
        [UNQUANTIFIED_FEE_NOTES[state]]
        if state in UNQUANTIFIED_FEE_NOTES
        else []
    )
    notes.extend(extra)
    if RESEARCH_DATA is not None:
        for review in RESEARCH_DATA.state_reviews:
            if review.state == state:
                notes.extend(
                    f"{fee.name}: unquantified and excluded. {fee.reason} "
                    f"Source: {fee.source_url}"
                    for fee in review.unquantified_fees
                )
    if notes:
        notes.append(
            "Per-gallon state-cost totals omit these charges; the "
            "supply-chain residual includes them."
        )
    return " ".join(notes)


def compose_state_tax(
    code: str,
    day: date,
    period: TaxPeriod,
    retail: float,
    in_gut: InGutRate | None,
    spot: dict[str, SpotQuote],
    pat: PatQuote | None = None,
) -> StateTax:
    """Resolve what one state charges per gallon on `day`.

    Most states are the published table's own figure, adjusted for any
    override in force. Indiana is built from its parts instead, because
    its use tax is reset monthly and its two taxes were suspended from
    different dates; a use tax without a usable rate is disclosed rather
    than priced. Supported taxes on retail or wholesale value are added
    separately when the published table excludes them.
    """
    assert_adjustments_cover(day)
    if code == "IN":
        return _compose_indiana_tax(day, period, in_gut)
    exclusion_note = unquantified_fee_note(code)
    base = period.per_state[code]
    parts = [
        TaxPart(
            "State taxes and fees",
            base,
            period.source_url,
            (
                "Excise plus the sales, inspection and environmental "
                "charges the published table groups with it"
                + (". " + exclusion_note if exclusion_note else "")
            ),
        )
    ]
    total = base
    override = adjustment_on(code, day)
    if override is not None:
        total = round(total + override.usd_per_gal, 4)
        # Caught here rather than at the whole-snapshot range check,
        # which sees a bare list of numbers; this knows whose rate it
        # is and what claims to reduce it.
        if total < 0:
            raise SnapshotError(
                f"{code} on {day}: {override.authority} reduces the rate "
                f"by ${-override.usd_per_gal:.4f}, more than the "
                f"${base:.4f} the published table carries; one of the two "
                f"is wrong"
            )
        parts.append(
            TaxPart(
                "Tax or fee adjustment",
                override.usd_per_gal,
                override.source_url,
                f"{override.authority}, in force {override.start} to "
                f"{override.end}; the published table carries the rate "
                f"this overrides",
            )
        )
    if code == "NY":
        if NY_SALES_TAX is None:
            raise SnapshotError("NY motor-fuel sales tax is unresolved")
        total = round(total + NY_SALES_TAX, 4)
        parts.append(
            TaxPart(
                "State motor-fuel sales tax",
                NY_SALES_TAX,
                NY_SALES_SOURCE_URL,
                "Collected statewide cents-per-gallon rate; "
                "the geographically limited MCTD increment is excluded",
            )
        )
    if code in GROSS_RECEIPTS_STATES:
        extra = resolve_gross_receipts(code, day, retail, spot.get(code), pat)
        total = round(total + extra.usd_per_gal, 4)
        parts.append(
            TaxPart(
                extra.label,
                extra.usd_per_gal,
                pat.source_url
                if code == "OH" and pat is not None
                else GROSS_RECEIPTS_SOURCE_URLS[code],
                extra.basis if extra.exact else f"Estimated. {extra.basis}",
            )
        )
    return StateTax(
        total=total,
        parts=tuple(parts),
        as_of=period.period.isoformat(),
    )


def _compose_indiana_tax(
    day: date, period: TaxPeriod, in_gut: InGutRate | None
) -> StateTax:
    """Render Indiana's components, saying how its use tax was priced."""
    indiana = resolve_indiana_tax(day, _excise_of(period, "IN"), in_gut)
    excluded = indiana.gut_basis is UseTaxBasis.EXCLUDED
    parts = [
        TaxPart(
            "Gasoline excise",
            indiana.excise,
            IN_EXCISE_SOURCE_URL,
            unquantified_fee_note(
                "IN", [IN_GUT_EXCLUSION_NOTE] if excluded else []
            ),
        ),
        TaxPart(
            "Oil inspection fee",
            indiana.inspection_fee,
            IN_OIL_INSPECTION_SOURCE_URL,
            "",
        ),
    ]
    # A month is named only where its rate prices the figure; under a
    # suspension the figure is zero whichever month the notice reached.
    pricing = (
        in_gut
        if indiana.gut_basis in (UseTaxBasis.PUBLISHED, UseTaxBasis.ESTIMATED)
        else None
    )
    if pricing is not None:
        estimate = (
            f"Estimated: no {day:%b %Y} rate could be read from the "
            f"department's notice, so the {pricing.month_start:%b %Y} rate "
            f"stands in for it."
            if indiana.gut_basis is UseTaxBasis.ESTIMATED
            else ""
        )
        parts.append(
            TaxPart(
                f"Gasoline use tax ({pricing.month_start:%b %Y})",
                indiana.gut,
                pricing.source_url,
                estimate,
            )
        )
    elif not excluded:
        parts.append(
            TaxPart(
                "Gasoline use tax",
                0.0,
                IN_GUT_NOTICE_URL if in_gut is None else in_gut.source_url,
                "",
            )
        )
    note = "; ".join(indiana.suspended)
    if note:
        parts.append(TaxPart("Suspended", 0.0, IN_SUSPENSION_NOTICE_URL, note))
    as_of = pricing.month_start if pricing is not None else period.period
    return StateTax(
        total=indiana.total,
        parts=tuple(parts),
        as_of=as_of.isoformat(),
    )


def _excise_of(period: TaxPeriod, code: str) -> float:
    """Read one state's excise, naming the gap when the sheet left it."""
    try:
        return period.excise[code]
    except KeyError:
        raise SnapshotError(
            f"EIA tax: the {period.period} sheet leaves {code}'s excise "
            f"blank, so its tax cannot be composed from parts"
        ) from None


def _js_string(text: str) -> str:
    """Escape text for a double-quoted JavaScript string literal.

    The page is JavaScript source inside an HTML script element, so a
    hand-entered value can break it two ways: a quote, backslash or
    control character ends the string literal, and `</script>` ends the
    element regardless of what the parser thinks it is inside. Either
    costs the whole snapshot array, not just its own row.

    `json.dumps` covers the first for every control character rather
    than the two that happen to come to mind; its outer quotes are
    dropped because the caller supplies them, and `ensure_ascii` is off
    so the page keeps the characters it was written with instead of
    growing escapes the rest of it does not use.

    That leaves three JSON does not handle here. U+2028 and U+2029 are
    line terminators everywhere in JavaScript except inside a string
    literal, which ES2019 carved out; escaping them costs nothing and
    keeps the value safe if it is ever emitted anywhere but here. `<`
    is escaped outright rather than just `</`, because a value carrying
    `<!--` and a later `<script` can send the HTML tokenizer somewhere
    the page's own closing tag no longer closes the element.

    They are matched by code point rather than written as characters:
    two of the three are invisible, so a literal would read as a stray
    space that the next person to tidy this file would delete.
    """
    escaped = json.dumps(text, ensure_ascii=False)[1:-1]
    for point in (0x3C, 0x2028, 0x2029):
        escaped = escaped.replace(chr(point), f"\\u{point:04x}")
    return escaped


def build_fixed(tax: StateTax) -> str:
    """Render one state's tax as the page's `fixed` field."""
    rendered = ",\n".join(
        f'      {{n:"{_js_string(part.name)}", '
        f'v:{part.usd_per_gal:.4f}, src:"{_js_string(part.src)}"'
        + (f', note:"{_js_string(part.note)}"' if part.note else "")
        + "}"
        for part in tax.parts
    )
    return (
        f"fixed:{{ total:{tax.total:.4f}, parts:[\n"
        f'{rendered}], asOf:"{_js_string(tax.as_of)}"}}'
    )


@dataclass(frozen=True)
class SnapshotSources:
    """Everything one snapshot is built from, already dated to it."""

    period: TaxPeriod
    in_gut: InGutRate | None
    spot: dict[str, SpotQuote]
    lcfs: LcfsQuote
    cca: AuctionSettlement
    wa: AuctionSettlement
    orm: OrCfpMonth
    pat: PatQuote


def build_data_block(
    baseline_data: str,
    target: date,
    retail: dict[str, float],
    sources: SnapshotSources,
) -> str:
    blocks = split_state_blocks(baseline_data)
    out: list[str] = []
    for code, chunk in blocks:
        if code not in retail:
            raise SnapshotError(f"missing retail price for {code}")
        chunk = replace_retail(chunk, retail[code])
        tax = compose_state_tax(
            code,
            target,
            sources.period,
            retail[code],
            sources.in_gut,
            sources.spot,
            sources.pat,
        )
        chunk = swap_fixed(chunk, build_fixed(tax))
        chunk = drop_adval(chunk)
        if code == "CA":
            chunk = swap_nontax(
                chunk, build_ca_nontax(target, sources.lcfs, sources.cca)
            )
        elif code == "OR":
            chunk = swap_nontax(chunk, build_or_nontax(sources.orm))
        elif code == "WA":
            chunk = swap_nontax(chunk, build_wa_nontax(sources.wa))
        out.append(chunk)
    return "".join(out)


def build_snapshot_object(
    target: date,
    baseline_block: str,
    retail: dict[str, float],
    sources: SnapshotSources,
    amendment_explanation: str = "",
) -> str:
    baseline_data = extract_data_block(baseline_block)
    body = build_data_block(baseline_data, target, retail, sources)
    notes = (
        "Auto-generated weekly snapshot. Retail (col 2) from live AAA "
        f"state-averages page on {target.isoformat()}. "
        + state_tax_notes(sources.period, sources.in_gut, target)
        + passthrough_notes(sources.lcfs, sources.cca, sources.wa, sources.orm)
    )
    if amendment_explanation:
        notes += " Input amendments: " + amendment_explanation
    return (
        "{\n"
        f'  date: "{target.isoformat()}",\n'
        f"  federalExcise: {sources.period.federal:.4f},\n"
        f'  federalSource: "{_js_string(sources.period.source_url)}",\n'
        f'  federalVintage: "Federal excise and LUST fee as published for '
        f'the {sources.period.period} edition of the EIA table.",\n'
        f'  aaaUrl: "{_js_string(AAA_URL)}",\n'
        f'  notes: "{_js_string(notes)}",\n'
        "  data: [\n"
        f"{body}"
        "  ]\n"
        "}"
    )


