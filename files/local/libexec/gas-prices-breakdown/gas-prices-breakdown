        series,
    )


def validate_collected_inputs(data: CollectedSnapshot, target: date) -> None:
    codes = set(STATE_CODE.values())
    if data.target != target:
        raise SnapshotError("collected inputs have a different target date")
    if set(data.retail) != codes or not all(
        1 < value < 12 for value in data.retail.values()
    ):
        raise SnapshotError("collected retail prices must cover all 51 states")
    if set(data.period.per_state) != codes or data.period.missing:
        raise SnapshotError("collected EIA tax table is incomplete")
    if data.period.period > target or not 0 <= data.period.federal < 1:
        raise SnapshotError("invalid collected tax baseline")
    if data.in_gut is not None:
        check_in_gut_in_force(data.in_gut.month_start, target)
    if not data.pat.start <= target <= data.pat.end:
        raise SnapshotError("collected Ohio PAT base has the wrong quarter")
    if data.pat.published > target:
        raise SnapshotError("collected Ohio PAT base was not yet published")
    if data.lcfs.as_of > target or data.lcfs.usd_per_mt < 0:
        raise SnapshotError("invalid collected LCFS input")
    if set(data.spot) != set(EIA_SPOT_SERIES):
        raise SnapshotError("collected wholesale benchmarks are incomplete")
    if any(quote.usd_per_gal <= 0 for quote in data.spot.values()):
        raise SnapshotError("collected wholesale benchmark is invalid")


def json_leaves(value: JsonValue, prefix: str = "") -> dict[str, JsonValue]:
    if isinstance(value, dict):
        return {
            path: leaf
            for key, child in value.items()
            for path, leaf in json_leaves(child, f"{prefix}/{key}").items()
        }
    if isinstance(value, list):
        return {
            path: leaf
            for index, child in enumerate(value)
            for path, leaf in json_leaves(child, f"{prefix}/{index}").items()
        }
    return {prefix: value}


def validate_amended_data(
    result: AmendedSnapshot,
    original: CollectedSnapshot,
    digest: str,
    cache: Path,
) -> CollectedSnapshot:
    if result.input_sha256 != digest:
        raise SnapshotError(
            "amended data is bound to different collected inputs"
        )
    if result.status == AmendmentStatus.FAILURE:
        raise SnapshotError(f"agent reported failure: {result.explanation}")
    if result.data is None:
        raise SnapshotError("successful amended data contains no final inputs")
    final = result.data
    validate_collected_inputs(final, original.target)
    if (
        final.collected_at != original.collected_at
        or final.version != original.version
    ):
        raise SnapshotError("agent changed collection identity")
    if final.period != original.period:
        raise SnapshotError("amend tax rules, not the published EIA baseline")
    if (
        final.fee_allocation_policy != original.fee_allocation_policy
        or final.known_fee_exclusions != original.known_fee_exclusions
    ):
        raise SnapshotError("agent changed the known fee-allocation policy")
    if (
        final.research.eia_tax_period != final.period.period
        or final.research.eia_baseline_sha256
        != tax_baseline_sha256(final.period)
        or final.previous_reviewed_through
        != original.previous_reviewed_through
    ):
        raise SnapshotError("agent changed input baseline identity")
    if final.pending_items:
        raise SnapshotError(
            f"amended data has unresolved inputs: {final.pending_items}"
        )
    adapter = TypeAdapter(JsonValue)
    before = json_leaves(adapter.validate_json(original.model_dump_json()))
    after = json_leaves(adapter.validate_json(final.model_dump_json()))
    changed = {
        path
        for path in before.keys() | after.keys()
        if before.get(path) != after.get(path)
    }
    routine_changes = {
        path
        for path in changed
        if not path.startswith(("/research/", "/pending_items/"))
    }
    for path in routine_changes:
        if not any(
            path == item.field or path.startswith(item.field + "/")
            for item in result.amendments
        ):
            raise SnapshotError(
                f"{path}: amendment lacks an explanation and source"
            )
    for amendment in result.amendments:
        if not (
            official_url(amendment.source_url)
            or amendment.source_url == AAA_URL
        ):
            raise SnapshotError("data amendment needs a primary source")
        document = collect_primary(
            amendment.source_url, original.target, cache
        )
        if " ".join(amendment.excerpt.split()) not in " ".join(
            document.text.split()
        ):
            raise SnapshotError(
                "data amendment excerpt is absent from its source"
            )
    changed_states: set[str] = set()
    for state in STATE_CODE.values():
        old = [a for a in original.research.adjustments if a.state == state]
        new = [a for a in final.research.adjustments if a.state == state]
        if old != new:
            changed_states.add(state)
    before_rules, after_rules = original.research, final.research
    for state, changed_rule in (
        (
            "IN",
            (
                before_rules.in_excise_suspensions
                != after_rules.in_excise_suspensions
                or before_rules.in_gut_suspensions
                != after_rules.in_gut_suspensions
                or before_rules.in_oil_inspection_fee
                != after_rules.in_oil_inspection_fee
                or before_rules.in_oil_inspection_source_url
                != after_rules.in_oil_inspection_source_url
            ),
        ),
        (
            "NY",
            before_rules.ny_sales_tax_usd_per_gal
            != after_rules.ny_sales_tax_usd_per_gal
            or before_rules.ny_sales_tax_source_url
            != after_rules.ny_sales_tax_source_url,
        ),
        (
            "WA",
            before_rules.wa_ppt_rate != after_rules.wa_ppt_rate
            or before_rules.wa_ppt_source_url != after_rules.wa_ppt_source_url
            or before_rules.wa_auctions != after_rules.wa_auctions,
        ),
        ("CA", before_rules.carb_auctions != after_rules.carb_auctions),
        (
            "DE",
            before_rules.de_hsca_rates != after_rules.de_hsca_rates
            or before_rules.de_hsca_source_url
            != after_rules.de_hsca_source_url,
        ),
    ):
        if changed_rule:
            changed_states.add(state)
    final.research.validate_for(
        original.target,
        set(STATE_CODE.values()),
        baseline_states=frozenset(set(STATE_CODE.values()) - changed_states),
    )
    verify_collected_evidence(
        final.research,
        original.research,
        original.target,
        cache,
    )
    with researched_tables(final.research):
        latest_auction(
            CARB_CCA_AUCTIONS, original.target, program="CARB_CCA_AUCTIONS"
        )
        latest_auction(
            WA_CCA_AUCTIONS, original.target, program="WA_CCA_AUCTIONS"
        )
    return final


def verify_collected_evidence(
    data: ResearchData,
    collected: ResearchData,
    target: date,
    cache: Path,
) -> None:
    """Retain established provenance; retrieve newly supplied evidence once."""
    prior = [
        item for review in collected.state_reviews for item in review.evidence
    ]
    for review in data.state_reviews:
        for evidence in review.evidence:
            if evidence in prior:
                continue
            document = collect_primary(evidence.source_url, target, cache)
            excerpt = " ".join(evidence.excerpt.split())
            if excerpt not in " ".join(document.text.split()):
                raise SnapshotError(
                    f"{review.state}: cited excerpt is absent from "
                    f"{evidence.source_url}"
                )


def run_snapshot_pipeline(args: argparse.Namespace) -> int:
    target = args.target or most_recent_thursday()
    original_html = read_html(args.html)
    snapshots = parse_snapshots(original_html)
    if find_block_for_date(snapshots.blocks, target.isoformat()):
        log.info("snapshot for %s already present; nothing to do", target)
        return 0
    baseline = find_block_for_date(snapshots.blocks, args.baseline)
    if baseline is None:
        raise SnapshotError(f"baseline snapshot {args.baseline} not found")
    state = args.state_dir.expanduser().resolve()
    cache = (args.cache_dir or state / "cache").expanduser().resolve()
    cache.mkdir(parents=True, exist_ok=True)
    runs = state / "runs"
    runs.mkdir(parents=True, exist_ok=True)
    workspace = Path(
        tempfile.mkdtemp(
            prefix=f"{datetime.now(UTC):%Y%m%dT%H%M%SZ}-",
            dir=runs,
        )
    )
    log.info("snapshot run artifacts: %s", workspace)
    try:
        input_path = args.inputs or state / "inputs" / f"{target}.json"
        if input_path.exists():
            collected = CollectedSnapshot.model_validate_json(
                input_path.read_bytes()
            )
            validate_collected_inputs(collected, target)
        elif args.inputs is not None:
            raise SnapshotError(
                f"saved collected inputs do not exist: {input_path}"
            )
        else:
            collected = collect_snapshot_inputs(target, state, cache)
            save_checkpoint(
                input_path, collected.model_dump_json(indent=2) + "\n"
            )
        collected_json = collected.model_dump_json(indent=2) + "\n"
        save_checkpoint(workspace / "collected.json", collected_json)
        digest = hashlib.sha256(collected_json.encode()).hexdigest()
        accepted = state / "amendments" / f"{digest}.json"
        amendment_path = workspace / "amended.json"
        if accepted.exists():
            save_checkpoint(amendment_path, accepted.read_text())
            log.info(
                "reusing completed amendment for collected inputs %s", digest
            )
        else:
            response = AmendedSnapshot(
                status=AmendmentStatus.FAILURE,
                explanation="The agent has not completed the amendment pass.",
                input_sha256=digest,
                data=collected,
            )
            save_checkpoint(
                amendment_path, response.model_dump_json(indent=2) + "\n"
            )
            save_checkpoint(
                workspace / "schema.json",
                json.dumps(
                    AmendedSnapshot.model_json_schema(),
                    indent=2,
                )
                + "\n",
            )
            skill = (
                Path(__file__).resolve().parent
                / "skills/update-gas-prices/SKILL.md"
            )
            prompt = (
                skill.read_text() + "\n\nRun inputs:\n"
                f"Target: {target}\n"
                f"Collected data: {workspace / 'collected.json'}\n"
                f"Amended result: {amendment_path}\n"
                f"Schema: {workspace / 'schema.json'}\n"
                f"Input SHA256: {digest}\n"
                f"Source guide: {skill.parent / 'references/sources.md'}\n"
                f"Primary source cache: {cache / 'primary'}\n"
                "Utility for additional sources: "
                f"{sys.executable} {Path(__file__).resolve()} "
                "research-source\n"
                f"Use --cache-dir {workspace / 'evidence'} "
                "for additional source retrieval.\n"
                "Write the amended result; the parent utility validates "
                "and publishes.\n"
            )
            save_checkpoint(workspace / "prompt.txt", prompt)
            code = run_agent(
                agent_command(
                    args.agent,
                    args.agent_command,
                    prompt,
                    workspace,
                    model=args.model,
                ),
                workspace,
            )
            log.info(
                "agent harness exited %d; reading amended-data outcome", code
            )
        result = AmendedSnapshot.model_validate_json(
            amendment_path.read_bytes()
        )
        save_checkpoint(
            workspace / "agent-result.json",
            result.model_dump_json(indent=2) + "\n",
        )
        final = validate_amended_data(result, collected, digest, cache)
        save_checkpoint(
            workspace / "final.json", final.model_dump_json(indent=2) + "\n"
        )
        with researched_tables(final.research):
            sources = SnapshotSources(
                period=final.period,
                in_gut=final.in_gut,
                spot=final.spot,
                lcfs=final.lcfs,
                orm=final.orm,
                pat=final.pat,
                cca=latest_auction(
                    CARB_CCA_AUCTIONS, target, program="CARB_CCA_AUCTIONS"
                ),
                wa=latest_auction(
                    WA_CCA_AUCTIONS, target, program="WA_CCA_AUCTIONS"
                ),
            )
            block = build_snapshot_object(
                target, baseline, final.retail, sources, result.explanation
            )
        sanity_check_snapshot(block, target)
        snapshots.blocks = insert_in_date_order(
            snapshots.blocks, block, str(target)
        )
        prepared = render_snapshots(snapshots)
        verify_append(original_html, prepared, target)
        save_checkpoint(workspace / "prepared.html", prepared)
        save_checkpoint(workspace / "changes.txt", result.explanation + "\n")
        save_checkpoint(accepted, result.model_dump_json(indent=2) + "\n")
        if not args.dry_run:
            publish_snapshot(args.html, original_html, prepared)
        save_checkpoint(
            state / "last-final.json", final.model_dump_json(indent=2) + "\n"
        )
        log.info(
            "%s snapshot for %s; %s",
            "prepared" if args.dry_run else "published",
            target,
            result.explanation,
        )
        return 0
    except (
        SnapshotError,
        AgentError,
        OSError,
        ValidationError,
        ValueError,
    ) as exc:
        save_checkpoint(
            workspace / "failure.json",
            json.dumps(
                {
                    "target": str(target),
                    "explanation": str(exc),
                },
                indent=2,
            )
            + "\n",
        )
        log.error("snapshot failed: %s; artifacts: %s", exc, workspace)
        return 1


def cmd_add_snapshot(args: argparse.Namespace) -> int:
    if args.research is not None:
        return cmd_add_snapshot_from_feeds(args)
    return run_snapshot_pipeline(args)


def cmd_add_snapshot_from_feeds(args: argparse.Namespace) -> int:
    target = args.target or most_recent_thursday()
    log.info("target snapshot date: %s (%s)", target, target.strftime("%a"))

    cache_dir = args.cache_dir or (
        Path.home() / ".cache" / "gas-prices-breakdown"
    )
    cache_dir.mkdir(parents=True, exist_ok=True)

    html_text = read_html(args.html)
    snapshots = parse_snapshots(html_text)
    log.info(
        "loaded %d existing snapshots from %s",
        len(snapshots.blocks),
        args.html,
    )

    if find_block_for_date(snapshots.blocks, target.isoformat()):
        log.info("snapshot for %s already present; nothing to do", target)
        return 0

    baseline = find_block_for_date(snapshots.blocks, args.baseline)
    if baseline is None:
        log.error("baseline snapshot %s not found", args.baseline)
        return 2

    # Check maintained inputs and independently retrieve their evidence
    # before fetching price feeds or building anything for publication.
    cca = latest_auction(
        CARB_CCA_AUCTIONS, target, program="CARB_CCA_AUCTIONS"
    )
    wa = latest_auction(WA_CCA_AUCTIONS, target, program="WA_CCA_AUCTIONS")
    assert_adjustments_cover(target)
    if WA_PPT_RATE is None:
        raise SnapshotError("WA petroleum products collection is unresolved")
    if NY_SALES_TAX is None:
        raise SnapshotError("NY motor-fuel sales tax is unresolved")
    if RESEARCH_DATA is not None:
        verify_research_evidence(RESEARCH_DATA, cache_dir)
    key = load_eia_api_key()

    log.info("fetching AAA retail (live)...")
    retail = fetch_aaa_retail(target)
    log.info(
        "AAA: %d states; CA $%.2f, US-min $%.2f, US-max $%.2f",
        len(retail),
        retail["CA"],
        min(retail.values()),
        max(retail.values()),
    )

    log.info("fetching CA LCFS assessment...")
    lcfs = fetch_lcfs_for_target_date(target, cache_dir)
    log.info(
        "CA LCFS: %s $%.2f/MT (%s)",
        lcfs.as_of,
        lcfs.usd_per_mt,
        lcfs.source_url,
    )

    log.info("CARB CCA: %s, $%.2f/allowance", cca.label, cca.price)
    log.info("WA CCA: %s, $%.2f/allowance", wa.label, wa.price)

    log.info("fetching Oregon CFP...")
    orm = fetch_or_cfp_for_target_date(target, cache_dir)
    log.info(
        "OR CFP: %s VWAP $%.2f/credit", orm.year_month, orm.vwap_per_credit
    )

    log.info("fetching federal and state tax table...")
    period = fetch_tax_period_for_target_date(target, cache_dir)
    assert_researched_baseline(period)
    log.info(
        "EIA tax: %s edition, %d states, federal $%.4f",
        period.period,
        len(period.per_state),
        period.federal,
    )

    log.info("fetching Indiana gasoline use tax...")
    in_gut = collect_in_gut(
        target, lambda: fetch_in_gut_for_target_date(target, cache_dir)
    )
    if in_gut is not None:
        log.info(
            "IN GUT: %s $%.4f/gal", in_gut.month_start, in_gut.usd_per_gal
        )

    pat = fetch_oh_pat_for_target_date(target, cache_dir)
    log.info("OH PAT: %s to %s $%.3f/gal", pat.start, pat.end, pat.usd_per_gal)

    log.info("fetching wholesale benchmarks...")
    # Two states share the New York Harbor series, so the fetch is keyed
    # by series rather than by state.
    series_months = {
        name: load_spot_series(name, key)
        for name in sorted(
            {
                series
                for state, series in EIA_SPOT_SERIES.items()
                if state != "WA" or WA_PPT_RATE != 0
            }
        )
    }
    spot = {
        code: select_spot(series_months[name], target, name)
        for code, name in EIA_SPOT_SERIES.items()
        if name in series_months
    }
    for code, quote in sorted(spot.items()):
        log.info(
            "spot %s: %s $%.3f/gal", code, quote.year_month, quote.usd_per_gal
        )

    sources = SnapshotSources(
        period=period,
        in_gut=in_gut,
        spot=spot,
        lcfs=lcfs,
        cca=cca,
        wa=wa,
        orm=orm,
        pat=pat,
    )
    new_block = build_snapshot_object(target, baseline, retail, sources)
    sanity_check_snapshot(new_block, target)

    snapshots.blocks = insert_in_date_order(
        snapshots.blocks, new_block, target.isoformat()
    )
    new_html = render_snapshots(snapshots)
    verify_append(html_text, new_html, target)

    if args.dry_run:
        log.info(
            "dry-run: would write %d bytes (was %d); not modifying file",
            len(new_html),
            len(html_text),
        )
        return 0

    publish_snapshot(args.html, html_text, new_html)
    log.info(
        "wrote %d bytes (%d snapshots in array)",
        len(new_html),
        len(snapshots.blocks),
    )
    return 0


