    table: list[tuple[date, float, str]],
    target: date,
    *,
    program: str,
) -> AuctionSettlement:
    """Return the newest settlement `target` could have known about.

    `table` must be in ascending date order: the scan keeps the last
    entry that qualifies rather than comparing dates, which is what
    makes "newest" true. `CCA_AUCTION_TABLES` holds the shipped tables
    and a test pins the ordering of each.

    Raises `SnapshotError` when the table has no usable entry, and when
    its newest one is stale enough to mean a quarterly update was
    missed -- a table nobody has topped up is indistinguishable from a
    market that has not moved, and only one of those is true.
    """
    cutoff = target - timedelta(days=CCA_PUBLICATION_LAG_DAYS)
    selected: tuple[date, float, str] | None = None
    for entry in table:
        if entry[0] <= cutoff:
            selected = entry
    if selected is None:
        raise SnapshotError(
            f"{program}: no auction settled and published as of {target}"
        )
    age = (target - selected[0]).days
    if age > CCA_STALE_DAYS:
        raise SnapshotError(
            f"{program}: newest auction ({selected[2]}) is {age} days old, "
            f"over the {CCA_STALE_DAYS}-day limit; a newer auction has "
            f"almost certainly settled and the table needs updating"
        )
    return AuctionSettlement(
        effective=selected[0], price=selected[1], label=selected[2]
    )


# ---------------------------------------------------------------------------
# Oregon CFP monthly
# ---------------------------------------------------------------------------


@dataclass(frozen=True)
class OrCfpMonth:
    year_month: str  # "YYYY-MM"
    vwap_per_credit: float
    source_xlsx_url: str


def load_or_cfp_series(cache_dir: Path) -> dict[tuple[int, int], float]:
    """Download the DEQ workbook and return its monthly VWAPs.

    Split from the per-date selection for the same reason as the LCFS
    series: one download serves any number of dates.
    """
    xlsx_path = cache_dir / "oregon-cfp.xlsx"
    xlsx_path.write_bytes(_http_bytes(OR_CFP_URL))
    return _read_or_cfp_monthly(xlsx_path)


def select_or_cfp(
    monthly: dict[tuple[int, int], float], target: date
) -> OrCfpMonth:
    """Return the most recent OR CFP monthly VWAP available as of target.

    DEQ publishes month M's VWAP by the last day of month M+1; the script
    treats month M as available from the first day of month M+2.

    Raises `SnapshotError` when nothing is published yet for `target`,
    and when the newest month that is published sits further back than
    `OR_CFP_STALE_DAYS` -- a workbook DEQ has stopped updating keeps
    answering with its last month and looks no different from a market
    that has not moved."""
    candidates: list[tuple[tuple[int, int], float]] = []
    for (y, m), price in monthly.items():
        avail_year = y + (1 if m + 2 > 12 else 0)
        avail_month = ((m + 1) % 12) + 1
        avail = date(avail_year, avail_month, 1)
        if avail <= target:
            candidates.append(((y, m), price))
    if not candidates:
        raise SnapshotError("OR CFP: no monthly value available as of target")
    (y, m), price = max(candidates, key=lambda t: t[0])
    age = (target - date(y, m, 1)).days
    if age > OR_CFP_STALE_DAYS:
        raise SnapshotError(
            f"OR CFP: newest available month is {y}-{m:02d}, {age} days "
            f"before {target}, over the {OR_CFP_STALE_DAYS}-day limit; DEQ "
            f"has stopped publishing"
        )
    return OrCfpMonth(
        year_month=f"{y}-{m:02d}",
        vwap_per_credit=price,
        source_xlsx_url=OR_CFP_URL,
    )


def fetch_or_cfp_for_target_date(target: date, cache_dir: Path) -> OrCfpMonth:
    """Download the DEQ workbook and pick the month for `target`."""
    return select_or_cfp(load_or_cfp_series(cache_dir), target)


def _read_or_cfp_monthly(path: Path) -> dict[tuple[int, int], float]:
    wb = _load_workbook(path, "OR CFP")
    sheet_name = "Monthly Credit Transfer Summary"
    if sheet_name not in wb.sheetnames:
        raise SnapshotError(f"OR CFP xlsx missing sheet {sheet_name!r}")
    sh = wb[sheet_name]
    out: dict[tuple[int, int], float] = {}
    year: int | None = None
    for row in sh.iter_rows(min_row=2, values_only=True):
        a, b, _, _, e = row[:5]
        if isinstance(a, int):
            year = a
        if not isinstance(b, str) or b not in MONTHS:
            continue
        if year is None:
            continue
        if not isinstance(e, (int, float)) or e <= 0:
            continue
        out[(year, MONTHS[b])] = float(e)
    if not out:
        raise SnapshotError("OR CFP xlsx: no monthly rows parsed")
    return out


# ---------------------------------------------------------------------------
# HTML parse / splice
# ---------------------------------------------------------------------------


@dataclass
class Snapshots:
    preamble: str
    blocks: list[str]
    postamble: str


SNAPSHOT_TRAILER_COMMENT = (
    "\n// To add another monthly snapshot, append another object here, e.g.:"
    '\n// , { date: "YYYY-MM-DD", federalExcise: 0.184, '
    'federalSource: "...", ... data: [ ... ] }\n'
)


def parse_snapshots(html_text: str) -> Snapshots:
    array_pattern = re.compile(
        r"const SNAPSHOTS = \[\n([\s\S]*?)\n?\];\n",
        re.MULTILINE,
    )
    matches = list(array_pattern.finditer(html_text))
    if len(matches) != 1:
        raise SnapshotError(
            f"expected exactly one SNAPSHOTS array, found {len(matches)}"
        )
    array_body = matches[0].group(1)
    blocks = _extract_objects(array_body)
    return Snapshots(
        preamble=html_text[: matches[0].start()],
        blocks=blocks,
        postamble=html_text[matches[0].end() :],
    )


def _extract_objects(text: str) -> list[str]:
    """Return the top-level {...} objects in text, ignoring those inside
    string literals or // line comments."""
    blocks: list[str] = []
    i = 0
    depth = 0
    start = -1
    in_string = False
    while i < len(text):
        c = text[i]
        if in_string:
            if c == "\\":
                i += 2
                continue
            if c == '"':
                in_string = False
            i += 1
            continue
        if c == '"':
            in_string = True
            i += 1
            continue
        if c == "/" and i + 1 < len(text) and text[i + 1] == "/":
            nl = text.find("\n", i)
            i = (nl + 1) if nl >= 0 else len(text)
            continue
        if c == "{":
            if depth == 0:
                start = i
            depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0 and start >= 0:
                blocks.append(text[start : i + 1])
                start = -1
        i += 1
    return blocks


def render_snapshots(snapshots: Snapshots) -> str:
    body = ",\n".join(snapshots.blocks)
    return (
        snapshots.preamble
        + "const SNAPSHOTS = [\n"
        + body
        + SNAPSHOT_TRAILER_COMMENT
        + "];\n"
        + snapshots.postamble
    )


def find_block_for_date(blocks: list[str], iso_date: str) -> str | None:
    needle = f'date: "{iso_date}"'
    for b in blocks:
        if needle in b:
            return b
    return None


def insert_in_date_order(
    blocks: list[str], new_block: str, new_iso: str
) -> list[str]:
    out: list[str] = []
    inserted = False
    for b in blocks:
        m = SNAPSHOT_DATE_RE.search(b)
        if not m:
            continue
        existing = m.group(1)
        if not inserted and new_iso > existing:
            out.append(new_block)
            inserted = True
        out.append(b)
    if not inserted:
        out.append(new_block)
    return out


def extract_data_block(snapshot_block: str) -> str:
    m = re.search(
        r"  data: \[\n([\s\S]*?)\n  \]\n\}\s*\Z",
        snapshot_block,
    )
    if not m:
        raise SnapshotError("could not extract data array from snapshot block")
    return m.group(1) + "\n"


# ---------------------------------------------------------------------------
# Snapshot construction
# ---------------------------------------------------------------------------


def split_state_blocks(text: str) -> list[tuple[str, str]]:
    starts = [
        m.start() for m in re.finditer(r'^  \{ code:"', text, re.MULTILINE)
    ]
    if not starts:
        raise SnapshotError("no per-state blocks found")
    out: list[tuple[str, str]] = []
    for i, s in enumerate(starts):
        end = starts[i + 1] if i + 1 < len(starts) else len(text)
        chunk = text[s:end]
        m = re.match(r'  \{ code:"([A-Z]{2})"', chunk)
        if not m:
            raise SnapshotError(f"bad per-state block prefix: {chunk[:60]!r}")
        out.append((m.group(1), chunk))
    return out


def replace_retail(chunk: str, retail: float) -> str:
    return re.sub(
        r"retail:\s*[0-9.]+,",
        f"retail:{retail:.3f},",
        chunk,
        count=1,
    )


def swap_nontax(chunk: str, replacement: str) -> str:
    i = chunk.index("nontax:{")
    depth = 0
    j = i
    while j < len(chunk):
        c = chunk[j]
        if c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0:
                j += 1
                break
        j += 1
    return chunk[:i] + replacement + chunk[j:]


PASSTHROUGH_NOTES_MARKER = "Non-tax pass-throughs: "


def passthrough_notes(
    lcfs: LcfsQuote,
    cca: AuctionSettlement,
    wa: AuctionSettlement,
    orm: OrCfpMonth,
) -> str:
    """Summarise which priced programs a snapshot's pass-throughs came from.

    Shared by the writer and the restater so a restated snapshot cannot
    end up describing one vintage in its notes and another in its state
    blocks.
    """
    return (
        f"{PASSTHROUGH_NOTES_MARKER}"
        f"CA LCFS {lcfs.as_of.isoformat()} "
        f"(${lcfs.usd_per_mt:.2f}/MT, Argus via Neste monitor); "
        f"CA cap-and-invest {cca.label}; "
        f"WA CCA {wa.label}; OR CFP {orm.year_month} "
        f"(${orm.vwap_per_credit:.2f}/credit). IN gasoline use tax handled "
        "per-date."
    )


def build_ca_nontax(d: date, lcfs: LcfsQuote, cca: AuctionSettlement) -> str:
    lcfs_pass = round(lcfs.usd_per_mt * LCFS_FACTOR, 4)
    cca_pass = round(cca.price * CCA_FACTOR_MT_PER_GAL, 4)
    total = round(lcfs_pass + cca_pass, 4)
    return (
        f"nontax:{{ total:{total:.4f}, parts:[\n"
        f'      {{n:"LCFS pass-through", v:{lcfs_pass:.4f}, '
        f'src:"{LCFS_MONITOR_URL}", '
        f'note:"Credit ${lcfs.usd_per_mt:.2f}/MT ({lcfs.as_of.isoformat()}) '
        f"{TIMES} {LCFS_FACTOR:.6f}. Daily Argus assessment, via Neste's "
        f"LCFS monitor. An assessed market price, not CARB's "
        f"volume-weighted average of completed transfers, so it is close "
        f"but not exact. Used because CARB stopped publishing its weekly "
        f"credit transfer reports after the week of "
        f'{LCFS_LAST_CARB_WEEK.isoformat()}."}},\n'
        f'      {{n:"Cap-and-Invest pass-through", v:{cca_pass:.4f}, '
        f'src:"https://ww2.arb.ca.gov/our-work/programs/'
        f'cap-and-trade-program/auction-information", '
        f'note:"${cca.price:.2f}/allowance ({cca.label}) {TIMES} '
        f'{CCA_FACTOR_MT_PER_GAL} MT/gal"}}'
        f'], asOf:"{d.isoformat()}"}}'
    )


def build_or_nontax(month: OrCfpMonth) -> str:
    pass_through = round(month.vwap_per_credit * OR_FACTOR, 4)
    return (
        f"nontax:{{ total:{pass_through:.4f}, parts:[\n"
        f'      {{n:"Clean Fuels Program credit pass-through", '
        f"v:{pass_through:.4f}, "
        f'src:"https://www.oregon.gov/deq/ghgp/cfp/pages/monthly-data.aspx", '
        f'note:"OR CFP {month.year_month} VWAP '
        f"${month.vwap_per_credit:.2f}/credit {TIMES} {OR_FACTOR:.6f} "
        f'(factor anchored to existing snapshot Jan 2025)"}}'
        f'], asOf:"{month.year_month}"}}'
    )


def build_wa_nontax(wa: AuctionSettlement) -> str:
    pass_through = round(wa.price * WA_FACTOR, 4)
    return (
        f"nontax:{{ total:{pass_through:.4f}, parts:[\n"
        f'      {{n:"Climate Commitment Act allowance pass-through", '
        f"v:{pass_through:.4f}, "
        f'src:"https://ecology.wa.gov/air-climate/climate-commitment-act/'
        f'cap-and-invest/auctions-and-market", '
        f'note:"${wa.price:.2f}/allowance ({wa.label}) {TIMES} '
        f'{WA_FACTOR:.5f} (factor anchored to existing snapshot Mar 2026)"}}'
        f'], asOf:"{wa.effective.isoformat()}"}}'
    )


def replace_in_adval(chunk: str, d: date, retail: float) -> str:
    in_suspension = IN_SUSPENSION_START <= d <= IN_SUSPENSION_END
    if in_suspension:
        new_adval = (
            "adval:{ pct:0, parts:[\n"
            '      {n:"Gasoline use tax (7%): SUSPENDED Apr 8 - May 8, 2026", '
            f'rate:"7% {TIMES} retail (suspended)", effCents:0, '
            'src:"https://www.in.gov/dor/i-am-a/business-corp/'
            'gasoline-use-tax/", '
            'note:"In suspension window"'
            f'}}], asOf:"{d.isoformat()}"}}'
        )
    else:
        eff_cents = round(0.07 * retail, 4)
        new_adval = (
            "adval:{ pct:7.0, parts:[\n"
            '      {n:"Gasoline use tax (7% of retail)", '
            f'rate:"7% {TIMES} retail", effCents:{eff_cents:.4f}, '
            'src:"https://www.in.gov/dor/i-am-a/business-corp/gasoline-use-tax/"'
            f'}}], asOf:"{d.isoformat()}"}}'
        )
    new_chunk = re.sub(
        r"adval:\{.*?\},(?=\s*\n\s*nontax)",
        new_adval + ",",
        chunk,
        count=1,
        flags=re.DOTALL,
    )
    if not in_suspension:
        new_chunk = re.sub(
            r',\s*flag:"GUT suspended through 2026-05-08"',
            "",
            new_chunk,
            count=1,
        )
    return new_chunk


def build_data_block(
    baseline_data: str,
    target: date,
    retail: dict[str, float],
    lcfs: LcfsQuote,
    cca: AuctionSettlement,
    wa: AuctionSettlement,
    orm: OrCfpMonth,
) -> str:
    blocks = split_state_blocks(baseline_data)
    out: list[str] = []
    for code, chunk in blocks:
        if code not in retail:
            raise SnapshotError(f"missing retail price for {code}")
        chunk = replace_retail(chunk, retail[code])
        if code == "CA":
            chunk = swap_nontax(chunk, build_ca_nontax(target, lcfs, cca))
        elif code == "OR":
            chunk = swap_nontax(chunk, build_or_nontax(orm))
        elif code == "WA":
            chunk = swap_nontax(chunk, build_wa_nontax(wa))
        elif code == "IN":
            chunk = replace_in_adval(chunk, target, retail["IN"])
        out.append(chunk)
    return "".join(out)


def build_snapshot_object(
    target: date,
    baseline_block: str,
    retail: dict[str, float],
    lcfs: LcfsQuote,
    cca: AuctionSettlement,
    wa: AuctionSettlement,
    orm: OrCfpMonth,
) -> str:
    baseline_data = extract_data_block(baseline_block)
    body = build_data_block(baseline_data, target, retail, lcfs, cca, wa, orm)
    notes = (
        "Auto-generated weekly snapshot. Retail (col 2) from live AAA "
        f"state-averages page on {target.isoformat()}. State taxes (cols 3-4) "
        f"inherited from {BASELINE_DATE} baseline. "
        + passthrough_notes(lcfs, cca, wa, orm)
    )
    return (
        "{\n"
        f'  date: "{target.isoformat()}",\n'
        "  federalExcise: 0.184,\n"
        '  federalSource: "https://www.irs.gov/publications/p510",\n'
        '  federalVintage: "Unchanged since 1993; current per IRS Pub 510 '
        '(2025). 18.3 cents excise + 0.1 cent LUST = 18.4 cents.",\n'
        f'  aaaUrl: "{AAA_URL}",\n'
        f'  notes: "{notes}",\n'
        "  data: [\n"
        f"{body}"
        "  ]\n"
        "}"
    )


# ---------------------------------------------------------------------------
# Sanity checks
# ---------------------------------------------------------------------------


def sanity_check_snapshot(snapshot: str, target: date) -> None:
    n_states = len(re.findall(r'^  \{ code:"', snapshot, re.MULTILINE))
    if n_states != 51:
        raise SnapshotError(f"sanity: expected 51 states, got {n_states}")
    m = SNAPSHOT_DATE_RE.search(snapshot)
    if not m or m.group(1) != target.isoformat():
        raise SnapshotError(
            "sanity: date in built block does not match target"
        )
    retail_values = [
        float(v) for v in re.findall(r"retail:([0-9]+\.[0-9]+),", snapshot)
    ]
    if len(retail_values) != 51:
        raise SnapshotError(
            f"sanity: expected 51 retail values, got {len(retail_values)}"
        )
    if not all(1.0 < v < 12.0 for v in retail_values):
        bad = [v for v in retail_values if not (1.0 < v < 12.0)]
        raise SnapshotError(
            f"sanity: retail values outside plausible range: {bad}"
        )


