# California LCFS credit price
# ---------------------------------------------------------------------------


@dataclass(frozen=True)
class LcfsQuote:
    as_of: date
    usd_per_mt: float
    source_url: str


def load_lcfs_series(cache_dir: Path) -> list[tuple[date, float]]:
    """Download the monitor's export and return it as ascending pairs.

    Split from the per-date selection so a caller restating many dates
    pays for one download rather than one per date.
    """
    xls_path = cache_dir / "lcfs.xls"
    xls_path.write_bytes(_http_bytes(LCFS_MONITOR_XLS))
    return _read_lcfs_daily(xls_path)


def select_lcfs(quotes: list[tuple[date, float]], target: date) -> LcfsQuote:
    """Return the newest LCFS credit assessment as of `target`.

    The series is assessed each trading day, so unlike the quarterly
    auction tables there is no publication lag to apply: the quote for a
    date is the quote for that date. Gaps are weekends and holidays,
    which `LCFS_STALE_DAYS` is sized to absorb.
    """
    usable = [q for q in quotes if q[0] <= target]
    if not usable:
        raise SnapshotError(
            f"CA LCFS: no assessment on or before {target}; the series "
            f"starts at {quotes[0][0]}"
        )
    as_of, price = usable[-1]
    age = (target - as_of).days
    if age > LCFS_STALE_DAYS:
        raise SnapshotError(
            f"CA LCFS: newest assessment ({as_of}) is {age} days old, over "
            f"the {LCFS_STALE_DAYS}-day limit; the source has stopped "
            f"updating and its last price no longer describes {target}"
        )
    return LcfsQuote(
        as_of=as_of, usd_per_mt=price, source_url=LCFS_MONITOR_XLS
    )


def fetch_lcfs_for_target_date(target: date, cache_dir: Path) -> LcfsQuote:
    """Download the assessment series and pick the quote for `target`."""
    return select_lcfs(load_lcfs_series(cache_dir), target)


def _read_lcfs_daily(path: Path) -> list[tuple[date, float]]:
    """Read the monitor's export as ascending (date, price) pairs.

    The export is a legacy single-sheet .xls holding an ISO date and a
    price per row. Its dates arrive as text rather than as Excel serial
    numbers, so they are parsed rather than converted.
    """
    # xlrd reports a damaged .xls through whichever layer notices first,
    # and only the innermost is an XLRDError: a body that is not a
    # workbook at all raises XLRDError, a corrupt OLE2 header raises
    # CompDocError, and one truncated mid-transfer -- the likeliest way
    # an HTTP fetch goes wrong -- raises IndexError from the sector
    # walk. A workbook with no sheets shows up on the access below.
    try:
        book = xlrd.open_workbook(str(path))
        sheet = book.sheet_by_index(0)
    except (
        xlrd.XLRDError,
        xlrd.compdoc.CompDocError,
        IndexError,
        OSError,
    ) as exc:
        raise SnapshotError(
            f"CA LCFS: export is not a readable workbook: {_describe(exc)}"
        ) from exc
    quotes: list[tuple[date, float]] = []
    for row in range(sheet.nrows):
        raw_day = sheet.cell_value(row, 0)
        raw_price = sheet.cell_value(row, 1) if sheet.ncols > 1 else None
        if not isinstance(raw_day, str) or not isinstance(
            raw_price, (int, float)
        ):
            continue
        try:
            day = date.fromisoformat(raw_day.strip())
        except ValueError:
            # The header row, and anything else not a date, is not a quote.
            continue
        quotes.append((day, float(raw_price)))
    if not quotes:
        raise SnapshotError("CA LCFS export: no dated rows parsed")
    quotes.sort()
    return quotes


