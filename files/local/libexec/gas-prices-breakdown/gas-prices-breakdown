def locked_add_snapshot(args: argparse.Namespace) -> int:
    """Serialize snapshot updates, including their input read and backup."""
    html = args.html.expanduser().resolve()
    args.html = html
    state_dir = Path.home() / ".local/state/gas-prices-breakdown"
    state_dir.mkdir(parents=True, exist_ok=True)
    key = hashlib.sha256(str(html).encode()).hexdigest()
    with (state_dir / f"snapshot-{key}.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise SnapshotError("another snapshot update is running") from exc
        return cmd_add_snapshot(args)


