def setup_logging() -> None:
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s %(levelname)s %(message)s",
        datefmt="%Y-%m-%dT%H:%M:%S%z",
        stream=sys.stderr,
    )


def backup_html(html: Path) -> Path:
    state_dir = Path.home() / ".local" / "state" / "gas-prices-breakdown"
    state_dir.mkdir(parents=True, exist_ok=True)
    backup = state_dir / (f"backup-{datetime.now(UTC):%Y%m%dT%H%M%SZ}.html")
    shutil.copy(html, backup)
    return backup


def write_with_canonical_mode(path: Path, content: str) -> None:
    """Write content to path and force the result to mode 0644.

    Path.write_text preserves the existing file's permissions when truncating
    in place, which can leak whatever mode the file happened to have on disk.
    All subcommand outputs are intended to be world-readable artifacts, so we
    normalize on every write."""
    path.write_text(content)
    path.chmod(0o644)


def block_summary(block: str) -> tuple[str, int, str]:
    date_match = SNAPSHOT_DATE_RE.search(block)
    iso_date = date_match.group(1) if date_match else "?"
    n_states = len(re.findall(r'^  \{ code:"', block, re.MULTILINE))
    notes_match = re.search(r'notes:\s*"((?:[^"\\]|\\.)*)"', block)
    notes = notes_match.group(1) if notes_match else ""
    if len(notes) > 80:
        notes = notes[:77] + "..."
    return iso_date, n_states, notes


def verify_append(original: str, prepared: str, target: date) -> None:
    """Accept one sane snapshot, preserving history and surrounding HTML."""
    before = parse_snapshots(original)
    after = parse_snapshots(prepared)
    added = find_block_for_date(after.blocks, target.isoformat())
    if added is None:
        raise SnapshotError("page lacks the requested snapshot")
    survivors = list(after.blocks)
    survivors.remove(added)
    if (
        survivors != before.blocks
        or after.preamble != before.preamble
        or after.postamble != before.postamble
    ):
        raise SnapshotError(
            "page changed published history or surrounding HTML"
        )
    sanity_check_snapshot(added, target)


def publish_snapshot(html: Path, original: str, prepared: str) -> None:
    """Back up and atomically replace an unchanged snapshot input."""
    if read_html(html) != original:
        raise SnapshotError(
            "page changed while building the snapshot; refusing to overwrite"
        )
    backup = backup_html(html)
    log.info("backed up to %s", backup)
    with tempfile.NamedTemporaryFile(
        dir=html.parent, prefix=".gas-prices-", delete=False
    ) as temp:
        candidate = Path(temp.name)
    try:
        write_with_canonical_mode(candidate, prepared)
        os.replace(candidate, html)
    finally:
        candidate.unlink(missing_ok=True)
    if read_html(html) != prepared:
        raise SnapshotError("published page does not match the snapshot")


