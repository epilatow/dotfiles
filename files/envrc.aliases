# ---------------------------------------------------------------------
# Setup command aliases
# ---------------------------------------------------------------------
type vim >/dev/null 2>&1
[ $? != 0 ] && alias vim=vi

# fix common typos
alias su-="su -"
alias us="su"

# misc aliases
alias lcreset="unset LC_FIXED; set_locale"
alias tclaude="tmux new claude"
alias tclauded="tclaude --dangerously-skip-permissions"
alias tcodex="tmux new codex  -c 'tui.terminal_title=[\"thread-title\"]'"
alias tcodexd="tcodex --dangerously-bypass-approvals-and-sandbox"
alias ls="ls -F"

# wrapper aliases
if [ -z "$NO_LABEL" -a -n "$TTY" -a -n "$TTY_DEV" -a -n "$TERM" ]; then
	alias su="su_wrap"

	type screen >/dev/null 2>&1 &&
	    alias screen="screen_wrap"

	for cmd in cd ssh; do
		type $cmd >/dev/null 2>&1 &&
		    alias $cmd="cmd_wrap $cmd"
	done
fi
