# ---------------------------------------------------------------------
# Setup command aliases
# ---------------------------------------------------------------------
type vim >/dev/null 2>&1
[ $? != 0 ] && alias vim=vi

# fix common typos
alias su-="su -"
alias us="su"

# misc aliases
alias lcreset="unset LC_FIXED; set_locale"
alias ls="ls -F"

# agent aliases
CLAUDE_ENV="DISABLE_AUTOUPDATER=1 FORCE_AUTOUPDATE_PLUGINS=1"
alias clauded="$CLAUDE_ENV claude --dangerously-skip-permissions"
CLAUDE_TMUX_NEW_ENV=$(for i in $CLAUDE_ENV; do printf "-e $i "; done)
alias tclaude="tmux new $CLAUDE_TMUX_NEW_ENV claude"
alias tclauded="tclaude --dangerously-skip-permissions"
alias codexd="codex --dangerously-bypass-approvals-and-sandbox"
tcodex()
{
	tmux new \
	    "$HOME/.local/libexec/tmux-agent-session-namer/tmux-codex-remote" "$@"
}
tcodexd()
{
	tcodex --dangerously-bypass-approvals-and-sandbox "$@"
}
alias mused="muse --yolo"
tmuse()
{
	tmux new \
	    "$HOME/.local/libexec/tmux-agent-session-namer/tmux-agent-session-namer" \
	    muse-run "$@"
}
tmused()
{
	tmuse --yolo "$@"
}
alias opencoded="opencode --auto"
alias topencode="tmux new opencode"
alias topencoded="topencode --auto"
alias tpi="tmux new pi"

# wrapper aliases
if [ -z "$NO_LABEL" -a -n "$TTY" -a -n "$TTY_DEV" -a -n "$TERM" ]; then
	alias su="su_wrap"

	type screen >/dev/null 2>&1 &&
	    alias screen="screen_wrap"

	for cmd in cd ssh; do
		type $cmd >/dev/null 2>&1 &&
		    alias $cmd="cmd_wrap $cmd"
	done
fi
